---
import ExampleLayout from '../layouts/ExampleLayout.astro';
import USPSection from '@cw/core/components/blocks/USPSection.astro';

const items = [
  { icon: '⚖️', title: 'Öffentlich bestellt & vereidigt', description: 'Gerichtsfest nach §§ 402 ff. ZPO — anerkannt vor allen deutschen Gerichten.' },
  { icon: '📋', title: 'Alle Bewertungsverfahren', description: 'Vergleichswert-, Ertragswert- und Sachwertverfahren nach ImmoWertV.' },
  { icon: '⏱️', title: 'Zuverlässige Fristen', description: 'Verkehrswertgutachten in 2–4 Wochen, Express nach Absprache.' },
  { icon: '🤝', title: 'Direkter Gutachter', description: 'Kein Zwischenagent — Sie sprechen direkt mit dem bestellten Sachverständigen.' },
];
---
<ExampleLayout
  title="USPSection"
  description="USP/Value-Prop-Grid. Optionaler heading/subheading-Header (v0.20.0)."
>
  <div class="example-section">
    <h2>Ohne Header (Default — Backward-Compat)</h2>
    <USPSection items={items} />
  </div>

  <div class="example-section">
    <h2>Mit heading</h2>
    <USPSection heading="Direkter Mandanten-Nutzen" items={items} />
  </div>

  <div class="example-section">
    <h2>Mit heading + subheading</h2>
    <USPSection
      heading="Warum Kanzleien uns beauftragen"
      subheading="Vier Gründe, die im Verfahren den Unterschied machen."
      items={items}
    />
  </div>
</ExampleLayout>
