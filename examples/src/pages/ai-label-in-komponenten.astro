---
/**
 * Gegenprobe zur Verdrahtung der KI-Kennzeichnung in den cw-core-Komponenten.
 *
 * Die Zusicherung der Aenderung lautet: ohne `bildHerkunft` aendert sich am gerenderten
 * Ausgang nichts. Ein solcher Nachweis ist wertlos, solange nicht gezeigt ist, dass der
 * Vergleich ueberhaupt anschlagen KANN. Diese Seite ist die Gegenrichtung — hier ist die
 * Prop gesetzt, und hier muessen Label erscheinen.
 *
 * Die Bilddateien existieren bewusst nicht: `publicFsPath` findet dann nichts, die
 * Farbmessung faellt auf die kontrastsichere schwarze Fassung zurueck, und das Label
 * erscheint trotzdem. Genau dieser Rueckfall ist der haeufigste Fall im Bestand.
 */
import ExampleLayout from '../layouts/ExampleLayout.astro';
import Hero from '@cw/core/components/blocks/Hero.astro';
import TeamGrid from '@cw/core/components/blocks/TeamGrid.astro';
import ReferenzenGrid from '@cw/core/components/blocks/ReferenzenGrid.astro';
import LeistungenSection from '@cw/core/components/blocks/LeistungenSection.astro';
import CaseStudyBlock from '@cw/core/components/blocks/CaseStudyBlock.astro';
import AuthorBox from '@cw/core/components/blocks/AuthorBox.astro';
import VideoEmbed from '@cw/core/components/blocks/VideoEmbed.astro';
import kiKarte from '../assets/ki-karte.webp';
import echtKarte from '../assets/echt-karte.webp';

const bildHerkunft = [
  { pathPrefix: 'images/', herkunft: 'mensch' },
  {
    pathPrefix: 'images/team/',
    herkunft: 'ki-erzeugt',
    deepfake: 'ja',
    begruendung: 'Fotorealistisches Team, das so nie existiert hat',
  },
  { stem: 'ki-karte', herkunft: 'ki-erzeugt', deepfake: 'ja', begruendung: 'Testfixture: pflichtiges Kartenbild' },
  { stem: 'echt-karte', herkunft: 'mensch' },
  {
    pathPrefix: 'images/render/',
    herkunft: 'ki-erzeugt',
    deepfake: 'nein',
    begruendung: 'Erkennbar illustratives Rendering, wirkt nicht als Aufnahme',
  },
];
---
<ExampleLayout
  title="KI-Kennzeichnung in den Komponenten"
  description="Dieselbe Deklaration wie auf /ai-label, aber die Komponenten loesen sie selbst auf. Erwartet: Label am Hero-Bild und an einem der beiden Teamfotos, keines an der Referenz."
>
  <div class="example-section">
    <h2>Hero — pflichtiges Bild</h2>
    <Hero
      headline="Hero mit KI-Bild"
      subtext="Das Bild liegt unter images/team/ und ist als Deepfake eingeordnet."
      imageSrc="/images/team/gruppe.webp"
      imageAlt="Team"
      imageWidth={1024}
      imageHeight={664}
      bildHerkunft={bildHerkunft}
    />
  </div>

  <div class="example-section">
    <h2>Hero — dasselbe Markup ohne Deklaration</h2>
    <Hero
      headline="Hero ohne bildHerkunft"
      subtext="Kein Label, kein zusaetzliches Element."
      imageSrc="/images/team/gruppe.webp"
      imageAlt="Team"
      imageWidth={1024}
      imageHeight={664}
    />
  </div>

  <div class="example-section">
    <h2>TeamGrid — ein pflichtiges, ein menschliches Foto</h2>
    <TeamGrid
      heading="Team"
      members={[
        { name: 'Anna Beispiel', role: 'Technik', image: '/images/team/anna.webp' },
        { name: 'Bert Beispiel', role: 'Vertrieb', image: '/images/halle/bert.webp' },
      ]}
      bildHerkunft={bildHerkunft}
    />
  </div>

  <div class="example-section">
    <h2>ReferenzenGrid — Rendering ohne Pflicht</h2>
    <ReferenzenGrid
      items={[
        {
          title: 'Produktrendering',
          description: 'KI-erzeugt, aber erkennbar illustrativ — keine Pflicht.',
          imageSrc: '/images/render/produkt.webp',
          imageAlt: 'Rendering',
        },
      ]}
      bildHerkunft={bildHerkunft}
    />
  </div>

  <div class="example-section">
    <h2>LeistungenSection mit cardStyle="image"</h2>
    <p>
      Der Container hat <code>.leistung-image :global(img) &#123; width:100%; height:100% &#125;</code>.
      Genau daran wurde das Badge am 28.08.2026 live formatfüllend aufgeblasen — der Fall
      fehlte hier, deshalb fiel es niemandem auf. Erwartet: ein kleines Badge unten links,
      nicht ein Bild in Kartengröße.
    </p>
    <LeistungenSection
      heading="Leistungen"
      cardStyle="image"
      items={[
        { title: 'Mit KI erzeugt', description: 'Label erwartet — klein, unten links.', imageSrc: kiKarte },
        { title: 'Menschliches Foto', description: 'Kein Label erwartet.', imageSrc: echtKarte },
      ]}
      bildHerkunft={bildHerkunft}
    />
  </div>

  <div class="example-section">
    <h2>CaseStudyBlock — Galerie</h2>
    <CaseStudyBlock
      customer="Beispielkunde"
      problem="Kurz beschrieben."
      approach="Kurz beschrieben."
      outcome="Kurz beschrieben."
      images={['/images/team/fall.webp', '/images/halle/fall.webp']}
      provider={{ name: 'Beispielbetrieb', url: 'https://example.com' }}
      pageUrl="https://example.com/fall"
      bildHerkunft={bildHerkunft}
    />
  </div>

  <div class="example-section">
    <h2>AuthorBox — Label unter dem Portrait</h2>
    <AuthorBox
      name="Anna Beispiel"
      role="Technik"
      image="/images/team/portrait.webp"
      profileUrl="/team/anna"
      bio="Kurzer Text."
      bildHerkunft={bildHerkunft}
    />
  </div>

  <div class="example-section">
    <h2>VideoEmbed — Poster</h2>
    <VideoEmbed youtubeId="dQw4w9WgXcQ" title="Beispielvideo" poster="/images/team/poster.webp" bildHerkunft={bildHerkunft} />
  </div>
</ExampleLayout>
