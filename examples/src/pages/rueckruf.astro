---
/**
 * Rückruf-Wunsch (formType="rueckruf"): Name und Telefon Pflicht, Zeitfenster optional.
 *
 * Zweck: Showcase und Prüfstand für den E2E-Test `e2e/formulare.spec.ts` (siehe
 * kontakt.astro). Der Endpoint muss den Rückruf per `allowRueckruf: true`
 * freischalten, sonst verlangt er eine E-Mail. Genau diesen Fall prüft der Test auch.
 */
import ExampleLayout from '../layouts/ExampleLayout.astro';
import ContactForm from '@cw/core/components/forms/ContactForm.astro';
---
<ExampleLayout
  title="Rückruf-Formular"
  description="Rückruf-Wunsch ohne E-Mail: Name, Telefon, Zeitfenster."
>
  <div class="example-section">
    <h2>Formular formType="rueckruf"</h2>
    <ContactForm
      formType="rueckruf"
      actionUrl="/api/contact"
      siteName="Beispiel"
      fallbackEmail="info@example.org"
      turnstileSiteKey=""
      callbackSlots={['vormittags', 'nachmittags']}
    />
  </div>
</ExampleLayout>
