        {
          name: 'Business',
          subtitle: 'Beliebt',
          priceSetup: 4990,
          priceMonthly: 149,
          features: ['15–30 Seiten', '60 Min/Mo Support', '24h Reaktion', 'bis 5 Standorte'],
          highlighted: true,
