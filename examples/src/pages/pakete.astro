        price: '150 €',
        priceModel: 'one-time',
        category: 'content',
      },
      {
        slug: 'extra-location',
        name: 'Zusätzlicher Standort',
        description: 'Lokale Landing-Page mit Schema.org LocalBusiness, NAP-Konsistenz, Geo-Markup.',
        price: '200 €',
        priceModel: 'one-time',
        category: 'seo',
      },
      {
        slug: 'altseiten-migration',
        name: 'Altseiten-Migration',
        description: '301-Mapping aller alten URLs, SEO-Verlust vermeiden. Preis nach Seitenanzahl.',
