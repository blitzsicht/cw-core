---
import ExampleLayout from '../layouts/ExampleLayout.astro';
import PaketeSection from '@cw/core/components/blocks/PaketeSection.astro';
import AddOnsSection from '@cw/core/components/blocks/AddOnsSection.astro';
---
<ExampleLayout
  title="PaketeSection v0.13 + AddOnsSection"
  description="Pricing-Refresh mit gestaffelten Features (✓/—/✓+Preis) und paket-unabhängiger Add-Ons-Sektion. Blitzsicht-Pricing-Pilot."
>
  <div class="example-section">
    <h2>Detailed-Modus (Tiered Services — Blitzsicht v0.13)</h2>
    <PaketeSection
      tilt={false}
      items={[
        {
          name: 'Starter',
          subtitle: 'Für Solo + kleine Teams',
          priceSetup: 2490,
          priceMonthly: 79,
          pages: '8–12 Seiten',
          features: [],
          detailedFeatures: [
            { label: 'Astro-Site + cw-core', variant: 'included' },
            { label: 'AI-SEO Starter-Pack', variant: 'included',
              tooltip: 'llms.txt, FAQ-Schema, Founder, sameAs, Content-Stats, WhatsApp-Sticky' },
            { label: 'Email-Signatur v1 (HTML+TXT pro Mitarbeiter)', variant: 'included' },
            { label: 'Plausible Analytics (Pageviews + Outbound)', variant: 'included' },
            { label: 'Telegram-Error-Monitor (5xx-Alerts)', variant: 'included' },
            { label: 'Mail-Hardening (SPF/DMARC/DKIM)', variant: 'included' },
            { label: '30 Min Support/Monat', variant: 'included' },
            { label: '48h Reaktion', variant: 'included' },
            { label: 'Plausible-Events (CTA/Scroll/FAQ)', variant: 'excluded' },
            { label: 'GMB-Setup + GSC-Verifizierung', variant: 'excluded' },
            { label: 'Email-Signatur v4 (vCard, Review-CTA, Booking-Link)', variant: 'excluded' },
            { label: 'Premium Mail (DNSSEC/MTA-STS/TLS-RPT)', variant: 'excluded' },
            { label: 'Cal-Booking inkl.', variant: 'addon', addonPrice: '+29 €/Mo',
              tooltip: 'Bei Business + Enterprise inkl.' },
          ],
        },
        {
          name: 'Business',
          subtitle: 'Meistgewählt',
          priceSetup: 4990,
          priceMonthly: 149,
          pages: '15–30 Seiten · bis 5 Standorte',
          highlighted: true,
          features: [],
          detailedFeatures: [
            { label: 'Astro-Site + cw-core', variant: 'included' },
            { label: 'AI-SEO Starter-Pack', variant: 'included' },
            { label: 'Email-Signatur v4 (vCard, Review-CTA, Booking)', variant: 'included' },
            { label: 'Plausible-Events (CTA/Scroll/FAQ)', variant: 'included' },
            { label: 'Telegram-Error-Monitor', variant: 'included' },
            { label: 'Premium Mail (DNSSEC/MTA-STS/TLS-RPT)', variant: 'included' },
            { label: 'GMB-Setup + GSC-Verifizierung', variant: 'included' },
            { label: 'Cal-Booking inkl.', variant: 'included' },
            { label: '60 Min Support/Monat', variant: 'included' },
            { label: '24h Reaktion', variant: 'included' },
            { label: 'Quartals-Audit-Service', variant: 'excluded' },
            { label: 'Bing/IndexNow Aktiv-Monitoring', variant: 'excluded' },
            { label: 'Schema-Subtype-Pflege (LocalBusiness → Plumber etc.)', variant: 'excluded' },
          ],
        },
        {
          name: 'Enterprise',
          subtitle: 'Für Filialen + Multi-Location',
          priceSetup: 9990,
          priceMonthly: 299,
          pages: '30–60+ Seiten · unlimited Standorte',
          features: [],
          detailedFeatures: [
            { label: 'Astro-Site + cw-core', variant: 'included' },
            { label: 'AI-SEO Starter-Pack', variant: 'included' },
            { label: 'Email-Signatur v4', variant: 'included' },
            { label: 'Plausible-Events + Custom-Funnels', variant: 'included' },
            { label: 'Telegram-Error-Monitor', variant: 'included' },
