---
import ExampleLayout from '../layouts/ExampleLayout.astro';
import AiLabel from '@cw/core/components/blocks/AiLabel.astro';
import { resolveBildHerkunft } from '@cw/core/utils/bildherkunft';

// Ein Regelwerk, wie es in einer Kunden-`site-data.ts` stünde.
const siteData = {
  bildHerkunft: [
    { pathPrefix: 'images/', herkunft: 'mensch' },
    {
      pathPrefix: 'images/team/',
      herkunft: 'ki-erzeugt',
      deepfake: 'ja',
      begruendung: 'Fotorealistisches Team, das so nie existiert hat',
    },
    {
      pathPrefix: 'images/render/',
      herkunft: 'ki-erzeugt',
      deepfake: 'nein',
      begruendung: 'Erkennbar illustratives Rendering, wirkt nicht als Aufnahme',
    },
  ],
};

const faelle = [
  ['images/team/gruppe.webp', 'KI-Bild, wirkt echt → Pflicht, Label erscheint'],
  ['images/render/produkt.webp', 'KI-Rendering, wirkt nicht echt → keine Pflicht, kein Label'],
  ['images/halle/aussen.webp', 'Menschliches Foto → kein Label'],
  ['bilder/unbekannt.webp', 'Keine Regel → ungeklaert, kein Label, aber ein Befund'],
];
---
<ExampleLayout
  title="AiLabel"
  description="Offenlegung nach Art. 50 Abs. 4 UAbs. 1 AI Act. Rendert nur, wo beide Merkmale der Legaldefinition zusammenkommen."
>
  <div class="example-section">
    <h2>Aus der Deklaration abgeleitet</h2>
    <p>
      Die Komponente entscheidet nicht selbst — sie rendert, was
      <code>resolveBildHerkunft</code> ergibt. Wo keine Pflicht besteht, erscheint nichts.
    </p>
    <table>
      <thead>
        <tr><th>Bildpfad</th><th>Erwartung</th><th>Label</th><th>Befund</th></tr>
      </thead>
      <tbody>
        {faelle.map(([pfad, erwartung]) => {
          const h = resolveBildHerkunft(siteData, pfad);
          return (
            <tr>
              <td><code>{pfad}</code></td>
              <td>{erwartung}</td>
              <td><AiLabel ergebnis={h} /></td>
              <td>{h.problem ? <small>{h.problem}</small> : '—'}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <div class="example-section">
    <h2>Explizit gesetzt</h2>
    <p>Für Fälle, in denen die Einordnung nicht aus der Deklaration kommt.</p>
    <p><AiLabel variante="erzeugt" /></p>
    <p><AiLabel variante="bearbeitet" /></p>
    <p><AiLabel variante="erzeugt" text="Hintergrund mit KI ersetzt" /></p>
  </div>

  <div class="example-section" style="background:#1f2328;padding:1rem;border-radius:.5rem">
    <h2 style="color:#f5f6f7">Auf dunklem Grund</h2>
    <p><AiLabel variante="erzeugt" theme="dunkel" /></p>
  </div>

  <div class="example-section">
    <h2>Am Bild, wo es hingehört</h2>
    <figure style="max-width:22rem;margin:0">
      <div style="aspect-ratio:3/2;background:#dfe3e8;border-radius:.375rem"></div>
      <figcaption style="margin-top:.5rem;font-size:.875rem;color:#57606a">
        Unser Team in der Werkstatt
        <AiLabel variante="erzeugt" style="margin-left:.5rem" />
      </figcaption>
    </figure>
  </div>

  <div class="example-section">
    <h2>Deckend gegen transparent</h2>
    <p>
      Die Kommission liefert jedes Symbol zweifach. <b>Deckend</b> (Standard) bringt den
      Kontrast selbst mit — die Pille ist der Hintergrund der Schrift, gemessen 21:1 bei
      Schwarz. <b>Transparent</b> lässt den Untergrund zu 50 % durchscheinen und braucht
      deshalb eine Umgebung, die den Kontrast nachweislich trägt.
    </p>
    <table>
      <tr><th style="text-align:left">Ausführung</th><th style="text-align:left">auf Weiß</th><th style="text-align:left">auf Foto-Hell</th></tr>
      <tr>
        <td>deckend schwarz</td>
        <td><AiLabel variante="erzeugt" ausfuehrung="deckend" theme="hell" beschriftung="im-alt" groesse="22px" /></td>
        <td style="background:linear-gradient(90deg,#e8f0fb,#fdfdfd)">
          <AiLabel variante="erzeugt" ausfuehrung="deckend" theme="hell" beschriftung="im-alt" groesse="22px" /></td>
      </tr>
      <tr>
        <td>transparent schwarz</td>
        <td><AiLabel variante="erzeugt" ausfuehrung="transparent" theme="hell" beschriftung="im-alt" groesse="22px" /></td>
        <td style="background:linear-gradient(90deg,#e8f0fb,#fdfdfd)">
          <AiLabel variante="erzeugt" ausfuehrung="transparent" theme="hell" beschriftung="im-alt" groesse="22px" /></td>
      </tr>
    </table>
  </div>

  <div class="example-section">
    <h2>Beschriftung: sichtbar oder nur vorlesbar</h2>
    <p>
      <code>nur-vorlesbar</code> entfernt den Text <b>nicht</b> — er steht weiterhin im DOM
      und wird von Screenreadern vorgelesen, ist aber visuell verborgen. Markiere die Zeile
      unten mit der Maus: der Text lässt sich weiterhin auswählen und kopieren.
    </p>
    <p>sichtbar: <AiLabel variante="erzeugt" groesse="22px" /></p>
    <p>nur vorlesbar: <AiLabel variante="erzeugt" beschriftung="nur-vorlesbar" groesse="22px" /></p>
    <p>im alt-Text: <AiLabel variante="erzeugt" beschriftung="im-alt" groesse="22px" /></p>
  </div>

  <div class="example-section">
    <h2>Größe</h2>
    <p>
      Ohne <code>groesse</code> hängt das Symbol an der Textzeile (<code>1.15em</code>). Steht
      es allein, braucht es eine feste Länge — sonst gäbe es keine Zeile, an der es sich
      orientieren könnte.
    </p>
    <p>
      <AiLabel variante="erzeugt" beschriftung="im-alt" groesse="16px" />
      <AiLabel variante="erzeugt" beschriftung="im-alt" groesse="22px" style="margin-left:.75rem" />
      <AiLabel variante="erzeugt" beschriftung="im-alt" groesse="28px" style="margin-left:.75rem" />
      <AiLabel variante="erzeugt" beschriftung="im-alt" groesse="36px" style="margin-left:.75rem" />
    </p>
  </div>
</ExampleLayout>
