{
  "name": "@cw/core",
  "version": "0.132.0",
  "type": "module",
  "description": "Shared Astro components, layouts and styles for Blitzsicht customer websites",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./layouts/*": "./src/layouts/*",
    "./components/*": "./src/components/*",
    "./styles/*": "./src/styles/*",
    "./templates/*": "./src/templates/*",
    "./integrations/ai-discovery": "./src/integrations/ai-discovery/index.ts",
    "./csp": "./src/integrations/ai-discovery/csp-public.js",
    "./integrations/sitemap-images": "./src/integrations/sitemap-images.ts",
    "./integrations/bing-indexnow": "./src/integrations/bing-indexnow/index.ts",
    "./integrations/quality-checks": "./src/integrations/quality-checks/index.ts",
    "./integrations/favicon-ico": "./src/integrations/favicon-ico/index.ts",
    "./og": "./src/og/index.mjs",
    "./og/*": "./src/og/*.mjs",
    "./schema": "./src/schema/index.ts",
    "./schema/*": "./src/schema/*.ts",
    "./utils/forms/handle-submission": "./src/utils/forms/handle-submission.js",
    "./utils/copyright": {
      "types": "./src/utils/copyright.d.ts",
      "default": "./src/utils/copyright.js"
    },
    "./utils/bildherkunft": {
      "types": "./src/utils/bildherkunft.d.ts",
      "default": "./src/utils/bildherkunft.js"
    },
    "./utils/image-format": "./src/utils/image-format.js",
    "./utils/labelfarbe": {
      "types": "./src/utils/labelfarbe.d.ts",
      "default": "./src/utils/labelfarbe.js"
    },
    "./utils/*": "./src/utils/*.ts",
    "./types/*": "./src/types/*",
    "./scripts/*": "./scripts/*",
    "./api/*": "./src/api/*.js"
  },
  "scripts": {
    "build": "echo '@cw/core is a source-only Astro component library — no build step (consumers compile via their own Astro pipeline).'",
    "check": "astro check",
    "test": "node --test 'tests/**/*.test.js' 'scripts/**/*.test.mjs' 'src/og/**/*.test.mjs' 'src/integrations/**/*.test.mjs'",
    "verify:reproducible": "node scripts/verify-reproducible-build.mjs --root examples",
    "optimize:images": "node scripts/optimize-images.mjs --delete-originals",
    "generate:og": "node scripts/generate-og.mjs",
    "sweep:favicon": "node scripts/sweep-favicon.mjs",
    "lint:css": "stylelint 'src/**/*.{astro,css}'",
    "sig:regenerate": "bash templates/email-signature/regenerate-all.sh",
    "sig:person": "bash templates/email-signature/onboard-person.sh",
    "examples:dev": "cd examples && pnpm dev",
    "examples:build": "cd examples && pnpm build"
  },
  "dependencies": {
    "exiftool-vendored": "^36.0.0",
    "satori": "^0.12.0"
  },
  "peerDependencies": {
    "@neondatabase/serverless": ">=0.9.0",
    "astro": ">=5.0.0",
    "lenis": ">=1.1.0",
    "sharp": ">=0.32.0",
    "tailwindcss": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@neondatabase/serverless": {
      "optional": true
    },
    "lenis": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@types/node": ">=22.0.0",
    "astro": "^5.0.0",
    "lenis": "^1.3.23",
    "pa11y-ci": "^4.1.1",
    "postcss-html": "^1.8.0",
    "satori": "^0.12.0",
    "schema-dts": "^2.0.0",
    "sharp": "^0.34.5",
    "simple-git-hooks": "^2.11.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "astro",
    "components",
    "customer-websites",
    "blitzsicht"
  ],
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/siluri/cw-core.git",
    "directory": "packages/@cw/core"
  }
}
