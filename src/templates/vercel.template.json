{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https://{{DOMAIN}}; script-src 'self' https://{{DOMAIN}} 'unsafe-inline' https://plausible.io https://tally.so https://app.cal.eu; script-src-elem 'self' https://{{DOMAIN}} 'unsafe-inline' https://plausible.io https://tally.so https://app.cal.eu; style-src 'self' https://{{DOMAIN}} 'unsafe-inline'; style-src-elem 'self' https://{{DOMAIN}} 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' https://{{DOMAIN}}; frame-src https://tally.so https://app.cal.eu https://www.youtube-nocookie.com; connect-src 'self' https://{{DOMAIN}} https://plausible.io https://app.cal.eu; font-src 'self' https://{{DOMAIN}} data:; object-src 'none'; base-uri 'self'; form-action 'self' https://tally.so; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(favicon|favicon-192|favicon-512|logo|logo-dark)\\.(svg|png|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    },
    {
      "source": "/js/script.js",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "1" },
        { "key": "CDN-Cache-Control", "value": "max-age=21600" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    }
  ]
}
