---
/**
 * @cw/core – ContactForm.astro
 *
 * Native HTML contact form (no iframe, GDPR-friendly).
 *   • Default backend: Web3Forms (https://web3forms.com) — pass `formKey`.
 *   • Custom endpoint: pass `actionUrl` to POST JSON to your own route
 *     (e.g. a Vercel Function bridging to Tally.so, Formspree, Resend,
 *     or a CRM). When `actionUrl` is set, Web3Forms fields are skipped.
 *
 * Primary submission path: AJAX fetch + inline success message.
 * Fallback (no JS): native HTML form POST.
 *
 * Fully prop-driven — no imports from customer data modules.
 *
 * @example Web3Forms
 *   <ContactForm
 *     formKey={siteData.contact.web3formsKey}
 *     subject={`Neue Anfrage – ${siteData.name}`}
 *     siteName={siteData.name}
 *     fallbackEmail={siteData.contact.email}
 *   />
 *
 * @example Custom endpoint (e.g. Tally.so bridge)
 *   <ContactForm
 *     actionUrl="/api/contact"
 *     fallbackEmail={siteData.contact.email}
 *   />
 */
interface Props {
  /** Web3Forms access key. Ignored if `actionUrl` is set. */
  formKey?: string;
  /** Email subject line injected as hidden field (Web3Forms only). */
  subject?: string;
  /** Site name used for default subject + `from_name` (Web3Forms only). */
  siteName?: string;
  /**
   * Form variant — determines which fields are rendered.
   * `waitlist`: Warteliste für Produkt-Sites (Felder: name, studio, email,
   * message optional) — Texte bewusst per Du (Produkt-Tonalität, z. B. platzfrei).
   */
  formType?: 'contact' | 'audit' | 'bewerbung' | 'waitlist';
  /** Email address shown in the no-JS / error fallback. */
  fallbackEmail?: string;
  /** Custom submit endpoint. When set, Web3Forms is bypassed. */
  actionUrl?: string;
  /** Cloudflare Turnstile site key. When set, renders the CAPTCHA widget. */
  turnstileSiteKey?: string;
  /**
   * Farbschema des Turnstile-Widgets. Default 'light' (bisheriges Verhalten,
   * alle bestehenden Sites unverändert). Dunkle Sites setzen 'dark' oder 'auto'.
   */
  turnstileTheme?: 'light' | 'dark' | 'auto';
  /**
   * Opt-in: rendert eine Marketing-Consent-Checkbox, die die Offline-Conversion-
   * Messung (gclid-Upload zu Google Ads) freischaltet. NUR für Ads-Sites — Default
   * aus, sonst erscheint keine Checkbox (die Nicht-Ads-Sites bleiben unverändert).
   */
  adsConsent?: boolean;
  /** Version des angezeigten Consent-Textes (DSGVO-Rechenschaft, wird mit-protokolliert). */
  adsConsentVersion?: string;
  /** Optionaler Override des Consent-Labels (Default: DSGVO-konformer Standardtext). */
  adsConsentText?: string;
  /**
   * Optionaler Zweitext hinter einem `<details>`-Aufklapper unter dem Label. Gedacht für
   * Sites, die das Label kurz halten wollen: Kurzsatz sichtbar, Pflichtangaben nach
   * Art. 13 DSGVO (Empfänger, Drittland, Widerruf) eine Klick-Ebene tiefer. Ohne den Prop
   * rendert der Consent-Block exakt wie bisher — die Nicht-Ads-Sites bleiben unberührt.
   */
  adsConsentDetails?: string;
}

const {
  formKey = '',
  siteName = '',
  subject = siteName ? `Neue Anfrage – ${siteName}` : 'Neue Anfrage',
  formType = 'contact',
  fallbackEmail = '',
  actionUrl,
  // Defensive default: liest PUBLIC_TURNSTILE_SITE_KEY direkt aus Build-Env
  // wenn Prop nicht übergeben — verhindert silent-fail wenn Customer-Page
  // den Prop vergessen hat (siehe v0.9.6 Form-Reliability-Plan).
  turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY,
  turnstileTheme = 'light',
  adsConsent = false,
  adsConsentVersion = 'ads-consent-v1',
  adsConsentText = 'Ich willige ein, dass zur Messung des Werbeerfolgs meine Google-Klick-Kennung an Google (Google Ireland Ltd. / Google LLC, USA) übermittelt wird. Freiwillig und jederzeit mit Wirkung für die Zukunft widerrufbar.',
  adsConsentDetails,
} = Astro.props;

// Build-Time-Warning wenn Form ohne Bot-Schutz produziert wird.
// Erscheint im Vercel-Deploy-Log → catchbar via Log-Monitoring.
if (!turnstileSiteKey && import.meta.env.PROD) {
  console.warn(
    '[cw-core ContactForm] Kein turnstileSiteKey — Form rendert OHNE Bot-Schutz. ' +
    'Setze PUBLIC_TURNSTILE_SITE_KEY in Vercel-Env oder übergib turnstileSiteKey-Prop.'
  );
}

const useWeb3Forms = !actionUrl;
const hasKey = useWeb3Forms ? (!!formKey && !formKey.startsWith('TODO')) : true;
const submitUrl = actionUrl ?? 'https://api.web3forms.com/submit';

// Ad-Attribution-Felder (gclid + utm_*) als Hidden-Inputs. Werden client-seitig
// aus sessionStorage/URL befüllt (s. Script unten) und beim Submit mitgesendet →
// cookielose Offline-Conversion-Zuordnung. Liste = ATTRIBUTION_KEYS (contact-handler.js).
const ATTRIBUTION_FIELDS = ['gclid', 'gbraid', 'wbraid', 'msclkid', 'fbclid',
  'utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];
---

{hasKey ? (
  <div class="contact-form-wrap">
    <form
      class="contact-form"
      action={submitUrl}
      method="POST"
      data-web3form
      data-submit-url={submitUrl}
      data-form-type={formType}
    >
      {useWeb3Forms && (
        <>
          <input type="hidden" name="access_key" value={formKey} />
          <input type="hidden" name="subject" value={subject} />
          <input type="hidden" name="from_name" value={siteName} />
        </>
      )}

      <!-- Honeypot Spam-Schutz (immer rendern, in beiden Submit-Pfaden) -->
      <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" />
      <!-- URL-Honeypot — Bots füllen oft "url" oder "website" automatisch aus -->
      <input type="text" name="url_honey" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;opacity:0" aria-hidden="true" />

      <!-- Ad-Attribution (gclid + utm_*) — client-seitig befüllt, cookielos -->
      {ATTRIBUTION_FIELDS.map((f) => (
        <input type="hidden" name={f} data-attribution={f} value="" />
      ))}

      {formType === 'contact' && (
        <>
          <div class="form-row">
            <label for="cf-name">Ihr Name <span aria-hidden="true">*</span></label>
            <input type="text" id="cf-name" name="name" required autocomplete="name" />
          </div>
          <div class="form-row">
            <label for="cf-email">E-Mail <span aria-hidden="true">*</span></label>
            <input type="email" id="cf-email" name="email" required autocomplete="email" />
          </div>
          <div class="form-row">
            <label for="cf-company">Unternehmen <span class="optional">(optional)</span></label>
            <input type="text" id="cf-company" name="company" autocomplete="organization" />
          </div>
          <div class="form-row">
            <label for="cf-message">Nachricht <span aria-hidden="true">*</span></label>
            <textarea id="cf-message" name="message" rows="4" required></textarea>
          </div>
        </>
      )}

      {formType === 'audit' && (
        <>
          <div class="form-row">
            <label for="cf-email">Ihre E-Mail <span aria-hidden="true">*</span></label>
            <input type="email" id="cf-email" name="email" required autocomplete="email" />
          </div>
          <div class="form-row">
            <label for="cf-url">Ihre Website-URL <span aria-hidden="true">*</span></label>
            <input type="url" id="cf-url" name="website" required placeholder="https://ihre-website.de" />
          </div>
          <div class="form-row">
            <label for="cf-name">Ihr Name <span class="optional">(optional)</span></label>
            <input type="text" id="cf-name" name="name" autocomplete="name" />
          </div>
        </>
      )}

      {formType === 'bewerbung' && (
        <>
          <div class="form-row">
            <label for="cf-name">Ihr Name <span aria-hidden="true">*</span></label>
            <input type="text" id="cf-name" name="name" required autocomplete="name" />
          </div>
          <div class="form-row">
            <label for="cf-email">E-Mail <span aria-hidden="true">*</span></label>
            <input type="email" id="cf-email" name="email" required autocomplete="email" />
          </div>
          <div class="form-row">
            <label for="cf-phone">Telefon <span class="optional">(optional)</span></label>
            <input type="tel" id="cf-phone" name="phone" autocomplete="tel" />
          </div>
          <div class="form-row">
            <label for="cf-message">Anschreiben <span aria-hidden="true">*</span></label>
            <textarea id="cf-message" name="message" rows="5" required
              placeholder="Bitte nenne die gewünschte Stelle oder schreibe &#34;Initiativbewerbung&#34;."></textarea>
          </div>
        </>
      )}

      {formType === 'waitlist' && (
        <>
          <div class="form-row">
            <label for="cf-name">Dein Name <span aria-hidden="true">*</span></label>
            <input type="text" id="cf-name" name="name" required autocomplete="name" />
          </div>
          <div class="form-row">
            <label for="cf-studio">Dein Studio <span aria-hidden="true">*</span></label>
            <input type="text" id="cf-studio" name="studio" required autocomplete="organization" />
          </div>
          <div class="form-row">
            <label for="cf-email">Deine E-Mail <span aria-hidden="true">*</span></label>
            <input type="email" id="cf-email" name="email" required autocomplete="email" />
          </div>
          <div class="form-row">
            <label for="cf-message">Nachricht <span class="optional">(optional)</span></label>
            <textarea id="cf-message" name="message" rows="3"></textarea>
          </div>
        </>
      )}

      {adsConsent && (
        <div class:list={['form-consent', adsConsentDetails && 'has-details']}>
          <input type="checkbox" id="cf-ads-consent" name="marketing_consent" value="true" />
          <label for="cf-ads-consent">{adsConsentText}</label>
          {adsConsentDetails && (
            <details class="consent-details">
              <summary>Details</summary>
              <p>{adsConsentDetails}</p>
            </details>
          )}
          <input type="hidden" name="marketing_consent_version" value={adsConsentVersion} />
        </div>
      )}

      {turnstileSiteKey && (
        <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme={turnstileTheme}></div>
      )}

      <div class="form-submit">
        <button type="submit" class="btn-accent">
          <span class="btn-label">Absenden</span>
          <span class="btn-loading" aria-hidden="true" hidden>
            <span class="spinner" aria-hidden="true"></span>
            Wird gesendet…
          </span>
        </button>
      </div>
    </form>

    <!-- aria-live: ohne das erfährt ein Screenreader-Nutzer vom Erfolg nichts.
         Das Formular verschwindet, ein Block erscheint — beides still. Das
         Häkchen ist aria-hidden (richtig: es ist Dekoration), die Überschrift
         trägt die Aussage, wird ohne Live-Region aber nie angesagt.
         `polite` statt `assertive`: der Erfolg ist wichtig, aber nicht so
         dringend, dass er laufende Ausgabe unterbrechen müsste. -->
    <div class="form-success" hidden role="status" aria-live="polite">
      <div class="success-icon" aria-hidden="true">✓</div>
      <h3>{formType === 'waitlist' ? 'Du stehst auf der Liste!' : 'Vielen Dank!'}</h3>
      {formType === 'audit' && <p>Wir analysieren Ihre Website und melden uns innerhalb von 48 Stunden.</p>}
      {formType === 'bewerbung' && <p>Wir haben Ihre Bewerbung erhalten und melden uns innerhalb von 48 Stunden.</p>}
      {formType === 'contact' && <p>Wir melden uns innerhalb von 24 Stunden bei Ihnen.</p>}
      {formType === 'waitlist' && <p>Wir melden uns, sobald es für dein Studio losgehen kann.</p>}
    </div>

    <div class="form-error" hidden>
      <p>
        Etwas ist schiefgelaufen.{fallbackEmail && (
          formType === 'waitlist'
            ? <> Bitte schreib uns direkt an <a href={`mailto:${fallbackEmail}`}>{fallbackEmail}</a>.</>
            : <> Bitte schreiben Sie uns direkt an <a href={`mailto:${fallbackEmail}`}>{fallbackEmail}</a>.</>
        )}
      </p>
    </div>
  </div>
) : (
  <div class="form-email-fallback">
    <p>Kontaktieren Sie uns direkt per E-Mail:</p>
    {fallbackEmail && <a href={`mailto:${fallbackEmail}`} class="btn-accent">{fallbackEmail}</a>}
  </div>
)}

{turnstileSiteKey && (
  <>
    <link rel="preconnect" href="https://challenges.cloudflare.com" />
    <script is:inline>
      // Turnstile lazy-load (Speed-Rollout 2026-07-09): api.js + Challenge-
      // Assets (~100–200 KB) erst laden, wenn das Formular in Viewport-Nähe
      // kommt oder fokussiert wird — nicht im Startup-Critical-Path.
      // api.js scannt beim Laden alle .cf-turnstile-Container (implicit
      // rendering), spätes Injecten ist daher sicher. Dedup über
      // window.__cwTsLoad (geteilt mit TurnstilePreClearance).
      (function () {
        var w = window;
        var load = (w.__cwTsLoad =
          w.__cwTsLoad ||
          function () {
            if (load.done) return;
            load.done = true;
            var s = document.createElement('script');
            s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
            s.async = true;
            document.head.appendChild(s);
          });
        var el = document.querySelector('.cf-turnstile');
        if (!el) return;
        var form = el.closest('form');
        if (form) form.addEventListener('focusin', load, { once: true });
        if ('IntersectionObserver' in w) {
          var io = new IntersectionObserver(
            function (entries) {
              for (var i = 0; i < entries.length; i++) {
                if (entries[i].isIntersecting) {
                  load();
                  io.disconnect();
                  return;
                }
              }
            },
            { rootMargin: '600px' },
          );
          io.observe(el);
        } else {
          load();
        }
      })();
    </script>
  </>
)}

<script>
  import { track } from '../../utils/analytics/track';

  // Ad-Attribution: aktuelle URL-Parameter cookielos persistieren (Standalone-Fall:
  // Formular direkt auf einer ?gclid-Landing, ohne dass PlausibleEvents zuvor lief).
  // Idempotent — PlausibleEvents nutzt denselben `cw_attr_`-Namensraum.
  const AD_KEYS = ['gclid', 'gbraid', 'wbraid', 'msclkid', 'fbclid',
    'utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];
  try {
    const params = new URLSearchParams(window.location.search);
    for (const k of AD_KEYS) {
      const v = params.get(k);
      if (v) sessionStorage.setItem('cw_attr_' + k, v.slice(0, 512));
    }
  } catch { /* sessionStorage/URL nicht verfügbar */ }

  document.querySelectorAll('form[data-web3form]').forEach((formEl) => {
    const form = formEl as HTMLFormElement;
    const wrap = form.closest('.contact-form-wrap') as HTMLElement | null;
    if (!wrap) return;

    // Hidden-Attribution-Felder aus sessionStorage befüllen (leer, wenn kein Ad-Klick).
    form.querySelectorAll<HTMLInputElement>('input[data-attribution]').forEach((input) => {
      try {
        const stored = sessionStorage.getItem('cw_attr_' + input.name);
        if (stored) input.value = stored;
      } catch { /* ignore */ }
    });

    const success = wrap.querySelector('.form-success') as HTMLElement | null;
    const error = wrap.querySelector('.form-error') as HTMLElement | null;
    const btnLabel = form.querySelector('.btn-label') as HTMLElement | null;
    const btnLoading = form.querySelector('.btn-loading') as HTMLElement | null;
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const formType = form.dataset.formType ?? 'contact';

    let formStartTracked = false;
    let formSubmitted = false;
    form.addEventListener('input', () => {
      if (!formStartTracked) {
        formStartTracked = true;
        track('Form Start', { type: formType });
      }
    }, { passive: true });
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden' && formStartTracked && !formSubmitted) {
        track('Form Abandoned', { type: formType });
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (btn) btn.disabled = true;
      if (btnLabel) btnLabel.hidden = true;
      if (btnLoading) btnLoading.hidden = false;
      if (error) error.hidden = true;
      form.dataset.submitting = 'true';

      try {
        const data = new FormData(form);
        const submitUrl = form.dataset.submitUrl ?? 'https://api.web3forms.com/submit';
        const isCustomEndpoint = !!form.dataset.submitUrl && !submitUrl.includes('web3forms.com');

        let res: Response;
        if (isCustomEndpoint) {
          // Eigener Endpoint: JSON senden (Vercel parst multipart/form-data nicht automatisch)
          const obj: Record<string, string> = {};
          data.forEach((v, k) => { if (typeof v === 'string') obj[k] = v; });
          res = await fetch(submitUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(obj),
          });
        } else {
          res = await fetch(submitUrl, { method: 'POST', body: data });
        }

        const json = await res.json() as { success?: boolean; ok?: boolean; message?: string };
        if (json.success || json.ok) {
          (form as HTMLElement).hidden = true;
          if (success) success.hidden = false;
          formSubmitted = true;
          track('Form Submit', { type: formType, status: 'success' });
        } else {
          throw new Error(json.message ?? 'Unknown error');
        }
      } catch {
        if (btn) { btn.disabled = false; }
        if (btnLabel) btnLabel.hidden = false;
        if (btnLoading) btnLoading.hidden = true;
        if (error) error.hidden = false;
        delete form.dataset.submitting;
        track('Form Submit', { type: formType, status: 'error' });
      }
    });
  });
</script>

<style>
  .contact-form-wrap { width: 100%; }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-row {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .contact-form label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .contact-form .optional {
    font-weight: 400;
    color: var(--color-muted);
    font-size: 0.8125rem;
  }

  .contact-form input,
  .contact-form textarea {
    padding: 0.625rem 0.875rem;
    border: 1px solid #d1d5db;
    border-radius: 0.375rem;
    font-size: 0.9375rem;
    font-family: inherit;
    width: 100%;
    box-sizing: border-box;
    background: #fff;
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
    border-color: transparent;
  }

  .contact-form textarea { resize: vertical; }

  /* Marketing-Consent-Checkbox (nur Ads-Sites, opt-in) — überschreibt die
     Text-Input-Defaults, damit die native Checkbox nicht als Textfeld gestylt wird. */
  .form-consent {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    line-height: 1.4;
  }
  .form-consent input[type="checkbox"] {
    width: 1rem;
    height: 1rem;
    margin: 0.15rem 0 0 0;
    padding: 0;
    flex-shrink: 0;
    box-sizing: border-box;
  }
  .form-consent label {
    font-weight: 400;
    font-size: 0.8125rem;
    color: var(--color-muted);
    cursor: pointer;
  }

  /* Nur wenn adsConsentDetails gesetzt ist: Grid statt Flex, damit der Aufklapper
     unter dem Label in derselben Spalte sitzt. Sites ohne den Prop behalten den
     unveränderten Flex-Block darüber. */
  .form-consent.has-details {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    row-gap: 0.25rem;
  }
  .form-consent .consent-details {
    grid-column: 2;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .form-consent .consent-details summary {
    cursor: pointer;
    width: fit-content;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .form-consent .consent-details p {
    margin: 0.375rem 0 0;
    line-height: 1.5;
  }

  /* Konvention „Vorwärts gehört nach rechts" (docs/ux-conventions.md): Absenden
     ist die Vorwärts-Aktion des Formulars und steht rechts. Auf schmalen
     Viewports volle Breite — dort gibt es kein „rechts". */
  .form-submit {
    margin-top: 0.5rem;
    display: flex;
    justify-content: flex-end;
  }
  /* stylelint-disable-next-line plugin/no-max-width-media -- konsistent zum Desktop-First-Rest dieser Datei */
  @media (max-width: 640px) {
    .form-submit { display: block; }
    .form-submit button { width: 100%; justify-content: center; }
  }

  /* Spinner */
  .spinner {
    display: inline-block;
    width: 1em;
    height: 1em;
    border: 2px solid rgba(255,255,255,0.4);
    border-top-color: white;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
    vertical-align: middle;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* Form ausgegraut während Submit */
  .contact-form[data-submitting] input,
  .contact-form[data-submitting] textarea,
  .contact-form[data-submitting] select {
    opacity: 0.5;
    pointer-events: none;
  }

  /* Erfolg */
  .form-success {
    text-align: center;
    padding: 2.5rem 1rem;
  }
  .success-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    background: #dcfce7;
    color: #16a34a;
    border-radius: 50%;
    font-size: 1.75rem;
    margin-bottom: 1.25rem;
    /* Die Quittung: der einzige Moment im System, in dem etwas geschafft ist.
     * Der Taktschlag davor (--motion-ack-delay) trennt Handlung und
     * Bestätigung — ohne ihn wirkt es hektisch, mit ihm wie eine Antwort.
     * `both` hält den Endzustand, damit das Häkchen nach der Animation
     * sichtbar bleibt und nicht auf scale(0.6) zurückfällt. */
    animation: cw-ack-pop var(--motion-ack, 420ms)
               cubic-bezier(0.34, 1.56, 0.64, 1)
               var(--motion-ack-delay, 90ms) both;
  }
  /* Der Keyframe wohnt bewusst HIER, nicht in tokens-base.css: sonst hinge
   * die Sichtbarkeit des Häkchens daran, ob das Kundenprojekt jene Datei
   * eingebunden hat. Overshoot ist im System die Ausnahme — dies ist der
   * einzige Moment, in dem etwas geschafft ist. */
  @keyframes cw-ack-pop {
    from { transform: scale(0.6); opacity: 0; }
    to   { transform: scale(1);   opacity: 1; }
  }
  /* Weniger Bewegung: Dauer kollabiert, Endzustand bleibt erreicht.
   * `animation: none` würde das Häkchen auf dem Startbild einfrieren
   * (scale 0.6, opacity 0) — also unsichtbar machen. */
  @media (prefers-reduced-motion: reduce) {
    .success-icon {
      animation-duration: 0.01ms;
      animation-delay: 0ms;
    }
  }
  .form-success h3 { font-size: 1.25rem; margin-bottom: 0.5rem; color: var(--color-primary); }
  .form-success p { color: var(--color-muted); margin: 0; }

  /* Fehler */
