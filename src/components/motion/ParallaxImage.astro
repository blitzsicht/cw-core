---
/**
 * @cw/core – motion/ParallaxImage.astro
 *
 * Translates a child image on the Y axis at a fraction of the scroll
 * speed using `requestAnimationFrame`. Drop-in for Astro `<Image>` or
 * raw `<img>`. Respects `prefers-reduced-motion` (tokens-base.css disables
 * the transform entirely).
 *
 * Die Bewegung steht in `scripts/motion-runtime.ts` und findet dieses Element
 * über `[data-motion-parallax]`; die Stärke liest sie aus dem Attributwert.
 * Bis 11.08.2026 lag sie als Inline-IIFE pro Instanz im HTML und fand sich
 * über eine `Math.random()`-ID selbst (blitzsicht-ops#650).
 *
 * @example
 *   <ParallaxImage speed={0.3}>
 *     <Image src={hero} alt="…" />
 *   </ParallaxImage>
 */
import MotionRuntime from './MotionRuntime.astro';

interface Props {
  /** Parallax strength. Positive = slower than scroll (floats up), 0.3 by default. */
  speed?: number;
  class?: string;
}

const { speed = 0.3, class: className = '' } = Astro.props;

---
<div class:list={['motion-parallax', className]} data-motion-parallax={speed}>
  <slot />
</div>

<style>
  .motion-parallax {
    overflow: hidden;
    display: block;
  }
  .motion-parallax > :global(img),
  .motion-parallax > :global(picture),
  .motion-parallax > :global(picture > img) {
    display: block;
    width: 100%;
    height: 100%;
    will-change: transform;
  }
</style>

<MotionRuntime />
