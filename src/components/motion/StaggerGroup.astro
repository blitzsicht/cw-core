---
/**
 * @cw/core – motion/StaggerGroup.astro
 *
 * Reveals direct children one after another with a configurable stagger.
 * Reines CSS: der Vorzustand, die Richtung und die Staffelung stehen in
 * `tokens-base.css` (`[data-motion-stagger]`), die Zeitwerte kommen als
 * Custom Properties am Wurzelelement an. JavaScript setzt nur `.is-visible`,
 * sobald die Gruppe in den Viewport kommt.
 *
 * ## Warum kein Script mehr die Kinder anfasst (blitzsicht-ops#650)
 *
 * Bis 11.08.2026 stempelte ein `is:inline`-Script beim Parsen jedem Kind
 * `data-motion-reveal` und ein `transition-delay` auf. Um sich selbst zu
 * finden, brauchte es eine ID — aus `Math.random()`. Zwei Builds derselben
 * Quelle erzeugten damit unterschiedliches HTML.
 *
 * Die Stempelei in ein gebündeltes Modul zu verschieben wäre schlimmer als der
 * Fehler: sie liefe dann NACH dem Parsen, die Kinder wären einen Moment
 * sichtbar und würden danach auf `opacity: 0` springen. Ein Vorzustand gehört
 * ins CSS, nicht in einen Nachtrag.
 *
 * ## Verhalten
 *
 * Beobachtet wird die GRUPPE, nicht mehr jedes Kind einzeln: die Staffel
 * startet, sobald die Gruppe zu 15 % im Bild ist. Bei einer Kachelreihe ist
 * das die Bewegung, die gemeint war; bei einer sehr langen Liste beginnt sie
 * früher als vorher.
 *
 * @example
 *   <StaggerGroup direction="up" gap={0.08}>
 *     <div>1</div><div>2</div><div>3</div>
 *   </StaggerGroup>
 */
import MotionRuntime from './MotionRuntime.astro';

export type StaggerDirection = 'up' | 'down' | 'left' | 'right' | 'zoom';

interface Props {
  direction?: StaggerDirection;
  /** Stagger gap between children in seconds. Defaults to 0.08. */
  gap?: number;
  /** Initial delay for the first child in seconds. Defaults to 0. */
  delay?: number;
  class?: string;
  as?: string;
}

const {
  direction = 'up',
  gap = 0.08,
  delay = 0,
  class: className = '',
  as: Tag = 'div',
} = Astro.props;

---
<Tag
  class:list={['motion-stagger', className]}
  data-motion-stagger={direction}
  data-motion-gap={gap}
  data-motion-delay={delay}
  style={`--stagger-gap:${gap}s;--stagger-start:${delay}s`}
>
  <slot />
</Tag>

<MotionRuntime />
