---
/**
 * @cw/core – motion/ScrollProgress.astro
 *
 * Fixed progress bar at the top of the viewport that scales with
 * document scroll position. Vanilla JS, no dependencies.
 *
 * @example
 *   <ScrollProgress />                 // uses accent color
 *   <ScrollProgress color="#EF7612" height="4px" />
 */
interface Props {
  color?: string;
  height?: string;
}

const { color, height = '3px' } = Astro.props;
const style = [
  color ? `background: ${color}` : '',
  height ? `height: ${height}` : '',
].filter(Boolean).join('; ');
---
<div class="motion-scroll-progress" data-motion-progress style={style || undefined} aria-hidden="true"></div>

<script>
  const init = () => {
    // Scroll-Zeitleiste vorhanden: CSS fährt den Balken (tokens-base.css), hier gibt es nichts zu tun.
    if (CSS.supports('animation-timeline: scroll()')) return;
    const bar = document.querySelector<HTMLElement>('[data-motion-progress]');
    if (!bar || bar.dataset.motionInit) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    // `astro:page-load` folgt auf `DOMContentLoaded`: ohne Sperre hingen zwei Paar Listener dran.
    bar.dataset.motionInit = '1';
    let ticking = false;
    const update = () => {
      const h = document.documentElement;
      const total = h.scrollHeight - h.clientHeight;
      const p = total > 0 ? h.scrollTop / total : 0;
      bar.style.transform = `scaleX(${p.toFixed(4)})`;
      ticking = false;
    };
    const onScroll = () => {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    };
    // Rückfall ohne Scroll-Zeitleiste: während des Ladens nichts lesen. Ein Lesen beim Start,
    // auch im requestAnimationFrame, erzwang einen Umbruch (Lighthouse spedition-steller.de
    // 09.11.2026). Den Startwert holt ein einziges Lesen nach `load`: Wurde schon gescrollt,
    // bevor dieser Listener hing (Sprung zu einem #Anker, wiederhergestellte Position), käme
    // sonst kein `scroll`-Ereignis mehr, und der Balken stünde bis zum ersten Scrollen auf 0.
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    if (document.readyState === 'complete') onScroll();
    else window.addEventListener('load', onScroll, { once: true });
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
  document.addEventListener('astro:page-load', init);
</script>
