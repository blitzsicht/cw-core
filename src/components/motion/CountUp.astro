---
/**
 * @cw/core – motion/CountUp.astro
 *
 * Counts from 0 (or `from`) to `value` when it enters the viewport.
 * Falls back to static number if `prefers-reduced-motion: reduce` or
 * IntersectionObserver is unavailable.
 *
 * Die Zählmechanik steht in `scripts/motion-runtime.ts` und findet dieses
 * Element über `[data-motion-countup]`. Bis 11.08.2026 lag sie als Inline-IIFE
 * pro Instanz im HTML und fand sich über eine `Math.random()`-ID selbst — zwei
 * Builds derselben Quelle ergaben dadurch unterschiedliche Bytes
 * (blitzsicht-ops#650).
 *
 * @example
 *   <CountUp value={127} suffix="+" duration={1.2} />
 *   <CountUp value={7} prefix="In " suffix=" Tagen live" />
 */
import MotionRuntime from './MotionRuntime.astro';

interface Props {
  value: number;
  from?: number;
  /** Duration in seconds. Defaults to 1.5. */
  duration?: number;
  /** Prefix text (e.g. "€ "). */
  prefix?: string;
  /** Suffix text (e.g. "+", "%"). */
  suffix?: string;
  /** Decimal digits. Defaults to 0. */
  decimals?: number;
  /** Thousands separator. Defaults to "." (de-DE). */
  separator?: string;
  class?: string;
  as?: string;
}

const {
  value,
  from = 0,
  duration = 1.5,
  prefix = '',
  suffix = '',
  decimals = 0,
  separator = '.',
  class: className = '',
  as: Tag = 'span',
} = Astro.props;

const fmt = (n: number) => {
  const fixed = n.toFixed(decimals);
  if (decimals > 0) {
    const [intPart, decPart] = fixed.split('.');
    return `${intPart!.replace(/\B(?=(\d{3})+(?!\d))/g, separator)},${decPart}`;
  }
  return fixed.replace(/\B(?=(\d{3})+(?!\d))/g, separator);
};
const initial = fmt(from);
const final = fmt(value);

---
<Tag
  class:list={['motion-countup', className]}
  data-motion-countup
  data-value={value}
  data-from={from}
  data-duration={duration}
  data-decimals={decimals}
  data-separator={separator}
  data-prefix={prefix}
  data-suffix={suffix}
><span data-motion-countup-vis>{prefix}<span data-motion-countup-num>{initial}</span>{suffix}</span><span class="sr-only">{prefix}{final}{suffix}</span></Tag>

<style>
  /* Ohne JavaScript zaehlt nichts hoch — dann bliebe der STARTWERT sichtbar
   * stehen und behauptete etwas anderes als gemeint. Gemessen auf
   * blitzsicht.com: die StatsBar zeigte "90+" statt "95+" beim PageSpeed-Score,
   * also eine Falschaussage ueber die eigene Leistung; auf platzfrei.club
   * stuende "0 Sekunden" statt "10 Sekunden".
   *
   * Der Endwert steht ohnehin im Markup — er ist das sr-only-Span fuer
   * Screenreader. Faellt das Skript aus, wird der laufende Zaehler samt Prefix
   * und Suffix ausgeblendet und dieses Span sichtbar gemacht. Deshalb liegt der
   * sichtbare Teil jetzt in einem eigenen Wrapper: sonst liessen sich Prefix
   * und Suffix nicht mit ausblenden und stuenden doppelt da.
   *
   * `not (scripting: enabled)` statt `(scripting: none)`: das trifft auch
   * `initial-only`, wo Skripte nur beim Laden laufen. */
  @media not (scripting: enabled) {
    [data-motion-countup-vis] { display: none; }
    .motion-countup .sr-only {
      position: static;
      width: auto;
      height: auto;
      margin: 0;
      overflow: visible;
      clip: auto;
      white-space: normal;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<MotionRuntime />
