---
import cwCorePkg from '../../../package.json';
import { phoneToTelHref } from '../../utils/text/tel-href';
const cwCoreVersion = cwCorePkg.version;

/**
 * @cw/core – Footer.astro
 *
 * Multi-column footer with brand info, service links, legal links, and a
 * copyright line. All content is prop-driven; no imports from customer
 * data modules.
 *
 * @example
 *   <Footer
 *     siteName={siteData.name}
 *     description={siteData.description}
 *     tagline={siteData.tagline}
 *     email={siteData.contact.email}
 *     phone={siteData.contact.phone}
 *     owner={siteData.legal.owner}
 *     legalForm={siteData.legal.form}
 *     city={siteData.legal.city}
 *     logoSrc="/logo.svg"
 *     leistungenLinks={siteData.nav.footer.leistungen}
 *     rechtlichesLinks={siteData.nav.footer.rechtliches}
 *     showKarriereLink={siteData.karriere?.enabled !== false}
 *   />
 */

export interface FooterLink {
  label: string;
  href: string;
}

interface Props {
  /** Site name (used as logo alt + text + default owner). */
  siteName: string;
  /** Short tagline shown bottom-right (italic). */
  tagline?: string;
  /** Business description shown under the logo. */
  description?: string;
  /** Contact email (rendered as mailto link). */
  email?: string;
  /** Optional phone number (rendered as tel link). */
  phone?: string;
  /** Optional WhatsApp number (rendered as wa.me link, new tab). */
  whatsapp?: string;
  /** Optional booking URL (cal.eu/cal.com), rendered as "Termin buchen" link, new tab. */
  bookingUrl?: string;
  /** Logo image path (light backgrounds, default). Defaults to `/logo.svg`. */
  logoSrc?: string;
  /** Logo for dark backgrounds (Footer is always dark). Defaults to `logoSrc`.
   *  Customers with a multi-color logo provide `/logo-inverted.svg` and pass it here. */
  logoSrcDark?: string;
  /** Logo width in px. */
  logoWidth?: number;
  /** Logo height in px. */
  logoHeight?: number;
  /**
   * When true, suppresses the brand-name link below the logo image.
   * Use this when the logo SVG already contains the brand name as text
   * (text-logo), to avoid "Brand Name Brand Name" in the footer.
   * Gegenstück zu `Header.hideBrandName`. Defaults to `false`.
   */
  hideBrandName?: boolean;
  /** Legal owner for copyright line. Falls back to `siteName`. */
  owner?: string;
  /** Legal form, e.g. "Einzelunternehmen". */
  legalForm?: string;
  /** Legal city shown in copyright line. */
  city?: string;
  /** Heading for the "services" column. Defaults to "Leistungen". */
  leistungenHeading?: string;
  /** Links rendered in the "services" column. */
  leistungenLinks?: readonly FooterLink[];
  /** Heading for the "legal" column. Defaults to "Rechtliches". */
  rechtlichesHeading?: string;
  /** Links rendered in the "legal" column. Defaults to Impressum + Datenschutz. */
  rechtlichesLinks?: readonly FooterLink[];
  /** Optional 4th column heading (e.g. "Für Ihre Branche"). */
  extraHeading?: string;
  /** Optional 4th column links (landing pages, verticals, etc.). */
  extraLinks?: readonly FooterLink[];
  /** Optional 5th column heading. */
  extraHeading2?: string;
  /** Optional 5th column links. */
  extraLinks2?: readonly FooterLink[];
  /** Show "/karriere" link in the services column. */
  showKarriereLink?: boolean;
  /** Karriere link label. Defaults to "Karriere". */
  karriereLabel?: string;
  /** Karriere link href. Defaults to "/karriere". */
  karriereHref?: string;
  /**
   * Optional Blitzsicht-Status-Badge (status.blitzsicht.com) im Footer.
   * Subtil unten neben Credit-Line gerendert — Customer-Vertrauen + Sales-Asset.
   *
   * Auto-Detection (seit v0.16.0): Wenn nicht gesetzt, leitet cw-core den Slug aus
   * `import.meta.env.CW_CUSTOMER_SLUG` ab (gefüllt via Vite-Define aus
   * `package.json.name` — siehe docs/STATUS-BADGE-AUTO.md).
   *
   * - `statusBadge: { slug: 'x' }` → explizit, Override gewinnt immer
   * - `statusBadge: null`          → Opt-Out, kein Badge auch bei vorhandener Env
   * - `statusBadge: undefined`     → Auto-Detection (Default)
   *
   * @example
   *   statusBadge: { slug: 'hausamlago' }
   *   → <img src="https://status.blitzsicht.com/badge/hausamlago.svg">
   */
  statusBadge?: {
    /** Customer-Slug aus cw-uptime CUSTOMERS-Array (z.B. 'hausamlago', 'soleno'). */
    slug: string;
    /** Override Status-Page-URL. Default: https://status.blitzsicht.com/ */
    statusUrl?: string;
    /** Override Badge-URL-Base. Default: https://status.blitzsicht.com/badge/ */
    badgeUrlBase?: string;
    /** Alt-Text für Screenreader. Default: "Systemstatus" */
    alt?: string;
  } | null;
  /**
   * Optionales Google-PSI-Score-Badge („Gemessen von Google") neben dem
   * Status-Badge. Opt-in (Default false) — erscheint nur bei `psiBadge: true`
   * UND vorhandenem Slug (gleiche Auto-Detection wie statusBadge). Der Worker
   * liefert das Badge ausschließlich für Slugs mit dokumentiertem
   * Messwert-Consent (PSI_PUBLIC_ALLOWLIST in cw-uptime) — pro Customer erst
   * aktivieren, wenn der Consent in customer-registry.json reference.metrics
   * steht. Verlinkt auf die öffentliche Beweis-Detailseite des Customers.
   */
  psiBadge?: boolean;
}

const {
  siteName,
  tagline,
  description,
  email,
  phone,
  whatsapp,
  bookingUrl,
  logoSrc = '/logo.svg',
  logoSrcDark,
  logoWidth = 50,
  logoHeight = 24,
  hideBrandName = false,
  owner,
  legalForm = 'Einzelunternehmen',
  city,
  leistungenHeading = 'Leistungen',
  leistungenLinks = [],
  rechtlichesHeading = 'Rechtliches',
  rechtlichesLinks = [
    { label: 'Impressum', href: '/impressum' },
    { label: 'Datenschutz', href: '/datenschutz' },
  ],
  extraHeading,
  extraLinks,
  extraHeading2,
  extraLinks2,
  showKarriereLink = false,
  karriereLabel = 'Karriere',
  karriereHref = '/karriere/',
  statusBadge,
  psiBadge = false,
} = Astro.props;

const year = new Date().getFullYear();
const copyrightOwner = owner ?? siteName;

const waDigits = whatsapp?.replace(/\D/g, '');
const footerWaLink = waDigits ? `https://wa.me/${waDigits}` : null;

const explicitOptOut = statusBadge === null;
const autoSlugRaw = (import.meta.env as Record<string, unknown>).CW_CUSTOMER_SLUG;
const autoSlug = typeof autoSlugRaw === 'string' && autoSlugRaw.length > 0 ? autoSlugRaw : null;
const effectiveSlug = explicitOptOut
  ? null
  : (statusBadge?.slug ?? autoSlug);

// Deep-Link auf die EIGENE Status-Detailseite statt der Kunden-Übersicht:
// die Übersicht listet alle Blitzsicht-Kunden — auf einer Kundensite wäre das
// die sichtbare Kundenliste für jeden Besucher (Operator-Fund 2026-07-09).
// Explizites statusUrl-Override gewinnt weiterhin; ohne Slug bleibt die Übersicht.
const statusUrl = statusBadge?.statusUrl
  ?? (effectiveSlug ? `https://status.blitzsicht.com/customer/${effectiveSlug}/` : 'https://status.blitzsicht.com/');
const badgeUrl = effectiveSlug
  ? `${statusBadge?.badgeUrlBase ?? 'https://status.blitzsicht.com/badge/'}${effectiveSlug}.svg`
  : null;
const badgeAlt = statusBadge?.alt ?? 'Systemstatus';

/**
 * Eigen-Marken-Backlink im Footer („Erstellt von Blitzsicht") mit Attribution.
 *
 * `utm_source` = die servende Kunden-Domain, damit auf blitzsicht.com sichtbar
 * ist, VON WELCHER Kundenseite ein Klick kam. Ohne die Angabe landet alles
 * ununterscheidbar unter `utm_medium=footer` (Operator-Fund 2026-08-05).
 *
 * Warum hier serverseitig und nicht (nur) im Client-Script: `PlausibleEvents.astro`
 * ergänzt `utm_source` bereits per JS — aber diese Komponente ist optional und
 * wird nur bei `trackingMode: 'full'` gemountet. Auf Sites ohne Analytics-Mount
 * (z.B. vor dem onboard-site-Lauf, wie platzfrei.club) fehlte die Attribution
 * daher komplett, obwohl der Link immer ausgeliefert wird. Der Link trägt seine
 * Herkunft jetzt selbst; das Client-Script bleibt als Fallback für Sites ohne
 * konfigurierte `site`-URL und überschreibt diesen Wert nicht (es setzt
 * `utm_source` nur, wenn der Parameter fehlt).
 *
 * Wert bewusst der Hostname (nicht der Customer-Slug): identisch zu dem, was
 * das Client-Script schon immer geschrieben hat — sonst zersplittert dieselbe
 * Kundenseite in der Auswertung auf zwei verschiedene Quellen.
 */
const brandBacklinkSource = Astro.site?.hostname;
const brandBacklinkHref = brandBacklinkSource
  ? `https://blitzsicht.com/?utm_source=${encodeURIComponent(brandBacklinkSource)}&utm_medium=footer`
  : 'https://blitzsicht.com/?utm_medium=footer';

const psiBadgeUrl = psiBadge && effectiveSlug
  ? `https://status.blitzsicht.com/badge/${effectiveSlug}/psi.svg`
  : null;
const psiDetailUrl = effectiveSlug
  ? `https://status.blitzsicht.com/customer/${effectiveSlug}/`
  : 'https://status.blitzsicht.com/';
---
<footer data-section="footer">
  <div class="container">
    <div class="footer-grid" style={(extraLinks2?.length ?? 0) > 0 ? 'grid-template-columns: 2fr 1fr 1fr 1fr 1fr' : (extraLinks?.length ?? 0) > 0 ? 'grid-template-columns: 2fr 1fr 1fr 1fr' : undefined}>
      <div class="footer-brand">
        <a href="/" class="logo-img">
          <img src={logoSrcDark ?? logoSrc} alt={siteName} width={logoWidth} height={logoHeight} loading="lazy" />
        </a>
        {!hideBrandName && (
          <a href="/" class="logo-name">
            {siteName}
          </a>
        )}
        {description && <p>{description}</p>}
        {email && (
          <a href={`mailto:${email}`} class="contact-link">
            {email}
          </a>
        )}
        {phone && (
          <a href={`tel:${phoneToTelHref(phone)}`} class="contact-link">
            {phone}
          </a>
        )}
        {footerWaLink && (
          <a href={footerWaLink} class="contact-link" target="_blank" rel="noopener noreferrer">
            WhatsApp
          </a>
        )}
        {bookingUrl && (
          <a href={bookingUrl} class="contact-link" target="_blank" rel="noopener noreferrer" data-cta="footer:booking">
            Termin buchen
          </a>
        )}
      </div>

      <div class="footer-links">
        <h3>{leistungenHeading}</h3>
        <ul>
          {leistungenLinks.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
          {showKarriereLink && <li><a href={karriereHref}>{karriereLabel}</a></li>}
        </ul>
      </div>

      <div class="footer-links">
        <h3>{rechtlichesHeading}</h3>
        <ul>
          {rechtlichesLinks.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </div>

      {(extraLinks?.length ?? 0) > 0 && (
        <div class="footer-links">
          <h3>{extraHeading ?? 'Mehr'}</h3>
          <ul>
            {extraLinks!.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </div>
      )}

      {(extraLinks2?.length ?? 0) > 0 && (
        <div class="footer-links">
          <h3>{extraHeading2 ?? 'Mehr'}</h3>
          <ul>
            {extraLinks2!.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <div class="footer-bottom">
      <p>© {year} {copyrightOwner}{legalForm ? ` · ${legalForm}` : ''}{city ? ` · ${city}` : ''}</p>
      <p class="footer-credit">{tagline && <span class="footer-tagline">{tagline} · </span>}Erstellt von <a href={brandBacklinkHref} target="_blank" rel="noopener" data-brand-backlink>Blitzsicht</a></p>
    </div>

    {(badgeUrl || psiBadgeUrl) && (
      <div class="footer-status">
        {badgeUrl && (
          <a href={statusUrl} target="_blank" rel="noopener" aria-label={`${badgeAlt} — Live-Verfügbarkeit prüfen`}>
            <img src={badgeUrl} alt={badgeAlt} width="120" height="20" loading="lazy" />
          </a>
        )}
        {psiBadgeUrl && (
          <a href={psiDetailUrl} target="_blank" rel="noopener" aria-label="Google PageSpeed Score — täglich gemessen, Details ansehen">
            <img src={psiBadgeUrl} alt="Google PageSpeed Score — täglich gemessen" width="120" height="20" loading="lazy" />
          </a>
        )}
      </div>
    )}
  </div>
</footer>

<script is:inline define:vars={{ cwCoreVersion }}>
  console.log('%c@cw/core v' + cwCoreVersion, 'color:#EF7612;font-weight:bold;font-size:12px');
</script>

<style>
  /*
   * _SILURI-CHANGE-LOG: 2026-05-19 — Issue #180
   * WCAG 2.1 AA Kontrast-Fix: alle Footer-Text-Farben auf ≥ 4.5:1 angehoben.
   * CSS Custom Properties eingeführt damit Customer-Repos bei Bedarf überschreiben können.
   * --color-footer-text-muted:   h3-Labels     0.5 → 0.85 (war ~3.1:1, jetzt ~8.0:1)
   * --color-footer-text-bottom:  Copyright-Bar 0.6 → 0.75 (war ~3.9:1, jetzt ~6.0:1)
   * --color-footer-credit-link:  Blitzsicht-Link 0.55 → 0.75 (war ~3.5:1, jetzt ~6.0:1)
   */
  footer {
    background: var(--color-footer-bg, var(--color-primary-dark, #111));
    color: rgba(255,255,255,0.75);
    padding-top: 3.5rem;
    padding-bottom: 1.5rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 3rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }
  .logo-img {
    display: block;
    margin-bottom: 1rem;
  }
  .logo-img img {
    display: block;
    width: auto;
    height: auto;
    max-width: 200px;
    max-height: 80px;
  }
  .logo-name {
    display: block;
    font-weight: 700;
    font-size: 1.125rem;
    color: white;
    text-decoration: none;
    margin-bottom: 0.875rem;
  }
  .footer-brand p {
    font-size: 0.9rem;
    line-height: 1.7;
    max-width: 28ch;
  }
  .contact-link {
    display: block;
    margin-top: 0.5rem;
    color: rgba(255,255,255,0.9);
    text-decoration: none;
    font-size: 0.9rem;
  }
  .contact-link:hover { text-decoration: underline; color: white; }
  .footer-links h3 {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-footer-text-muted, rgba(255,255,255,0.85));
    margin-bottom: 1rem;
  }
  .footer-links ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.625rem; }
  .footer-links a {
    color: rgba(255,255,255,0.75);
    text-decoration: none;
    font-size: 0.9375rem;
    transition: color 0.15s;
  }
  .footer-links a:hover { color: white; }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.5rem;
    font-size: 0.8125rem;
    color: var(--color-footer-text-bottom, rgba(255,255,255,0.75));
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .footer-tagline { font-style: italic; }
  .footer-credit a {
    color: var(--color-footer-credit-link, rgba(255,255,255,0.75));
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.15s;
  }
  .footer-credit a:hover { color: white; }
  .footer-status {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
    opacity: 0.6;
    transition: opacity 0.2s;
  }
  .footer-status:hover { opacity: 1; }
  .footer-status img {
    height: 20px;
    width: auto;
    display: block;
  }

  /* stylelint-disable-next-line plugin/no-max-width-media -- Legacy Desktop-First, TODO: refactor to Mobile-First */
  @media (max-width: 1023px) {
    .footer-grid { grid-template-columns: 1fr 1fr !important; }
  }
  /* stylelint-disable-next-line plugin/no-max-width-media -- Legacy Desktop-First, TODO: refactor to Mobile-First */
  @media (max-width: 767px) {
    .footer-grid { grid-template-columns: 1fr !important; gap: 2rem; }
    .footer-bottom { flex-direction: column; align-items: flex-start; }
  }
</style>
