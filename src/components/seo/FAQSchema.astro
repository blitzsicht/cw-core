---
// @cw/core – FAQSchema.astro
// Standalone FAQPage JSON-LD — props-driven, kein siteData-Import erforderlich.
// Verwendung: auf jeder Seite die FAQ-Inhalte hat, unabhängig vom FAQ-Block.

interface Props {
  items: Array<{ question: string; answer: string }>;
}
const { items } = Astro.props;
---
{items.length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": items.map(i => ({
      "@type": "Question",
      "name": i.question,
      "acceptedAnswer": { "@type": "Answer", "text": i.answer },
    })),
  })} />
)}
