---
/**
 * DankePage — full-screen "thank you" confirmation page.
 *
 * Used after form submissions. Renders a centered success message
 * with checkmark icon (or an optional founder/team photo) and
 * back-to-home CTA. Uses CSS variables for brand colors — no
 * hardcoded hex values.
 *
 * Should be wrapped in BaseLayout with `robots="noindex"`.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import AiLabelAmBild from './AiLabelAmBild.astro';
import { bildLabel } from '../../utils/bildlabel.js';

interface Props {
  heading?: string;
  message?: string;
  ctaLabel?: string;
  ctaHref?: string;
  /** Optional founder/team photo. Replaces the checkmark icon when set. */
  photo?: ImageMetadata;
  /**
   * `siteData.bildHerkunft`. Das Portrait ist hier nur 96 px gross — ein 48x24-Badge
   * darauf verdeckte das Motiv fast zur Haelfte. Die Kennzeichnung steht deshalb
   * darunter; Art. 50 Abs. 5 verlangt sie am Bild, nicht an einer bestimmten Ecke.
   *
   * Ohne diese Prop aendert sich an der gerenderten Seite nichts.
   */
  bildHerkunft?: unknown[];
  /** Alt text for `photo`. Required if `photo` is set. */
  photoAlt?: string;
  /**
   * Nächste Schritte als nummerierte Liste unter der Nachricht (z. B. nach einem
   * Rückruf-Wunsch). Ohne den Prop (oder mit leerem Array) bleibt das Markup unverändert.
   */
  nextSteps?: string[];
  /** Zusatzhinweis zum Rückruf als eigener Absatz unter Nachricht bzw. Liste. */
  callbackNote?: string;
}

const {
  heading = 'Danke für Ihre Nachricht!',
  message = 'Wir melden uns innerhalb von 24 Stunden bei Ihnen.',
  ctaLabel = 'Zur Startseite',
  ctaHref = '/',
  photo,
  photoAlt = heading,
  bildHerkunft,
  nextSteps,
  callbackNote,
} = Astro.props;

/* Kein Farbabgleich: das Badge sitzt unter dem Bild auf hellem Seitengrund, nicht auf
   dem Motiv. Die Messung waere hier ohne Bezugspunkt. */
const fotoLabel = photo ? await bildLabel({ bildHerkunft }, photo) : null;

/* `nextSteps` und `callbackNote` hängen im Template ohne Leerraum an der Nachricht:
   jede eigene Zeile (auch ein JSX-Kommentar) hinterließe ohne die Props zusätzliche
   Leerzeichen im HTML. Ohne die Props soll das Markup Byte für Byte das bisherige sein
   (Test gegen den v0.159.1-Schnappschuss: tests/blocks/contactform-rueckruf.test.js). */
---
<main class="danke-page">
  <div class="danke-content">
    {photo ? (
      <div class="danke-photo">
        <Image src={photo} alt={photoAlt} width={96} height={96} widths={[96, 192, 288]} sizes="96px" />
        {fotoLabel && <AiLabelAmBild ergebnis={fotoLabel.ergebnis} theme="hell" platzierung="unter-bild" />}
      </div>
    ) : (
      <div class="danke-icon">
        <svg
          width="96"
          height="96"
          fill="none"
          stroke="var(--color-accent)"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          viewBox="0 0 24 24"
        >
          <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
    )}

    <h1 class="danke-heading">{heading}</h1>
    <p class="danke-message">{message}</p>{nextSteps && nextSteps.length > 0 && (
      <ol class="danke-next-steps">
        {nextSteps.map((schritt) => <li>{schritt}</li>)}
      </ol>
    )}{callbackNote && <p class="danke-callback-note">{callbackNote}</p>}

    <a href={ctaHref} class="danke-cta">{ctaLabel}</a>
  </div>
</main>

<style>
  .danke-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary);
  }
  .danke-content {
    text-align: center;
    max-width: 28rem;
    margin: 0 auto;
    padding: 0 1rem;
  }
  .danke-icon {
    margin-bottom: 1.5rem;
  }
  .danke-photo {
    margin: 0 auto 1.5rem;
    width: 96px;
    height: 96px;
  }
  .danke-photo img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-accent);
  }
  .danke-heading {
    font-size: 1.875rem;
    font-weight: 700;
    color: white;
    margin-bottom: 1rem;
  }
  .danke-message {
    /* Volle Deckkraft statt 0.65. Anders als bei Hero und CTABlock liegt hier eine
       Volltonflaeche (--color-primary), kein Verlauf: der Wert war mit 2.68:1 an
       Zink gemessen der schlechteste der Site, und der Fix wird deshalb auch in der
       pa11y-Zahl sichtbar. Voll deckend sind es 4.99:1. */
    color: #ffffff;
    margin-bottom: 2rem;
  }
  /* Nächste Schritte / Rückruf-Hinweis: gleiche Volltonfläche wie .danke-message,
     deshalb ebenfalls volle Deckkraft (Kontrast s. dort). */
  .danke-next-steps {
    display: inline-block;
    text-align: left;
    color: #ffffff;
    margin: -1rem 0 2rem;
    padding-left: 1.25rem;
  }
  .danke-next-steps li + li { margin-top: 0.375rem; }
  .danke-callback-note {
    color: #ffffff;
    margin-bottom: 2rem;
  }
  .danke-cta {
    display: inline-block;
    background: var(--color-accent);
    color: var(--color-accent-btn-text, white);
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .danke-cta:hover {
    opacity: 0.9;
  }
</style>

<script>
  import { track } from '../../utils/analytics/track';
  track('Thank You Page Viewed');
</script>
