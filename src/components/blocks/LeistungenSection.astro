---
/**
 * @cw/core – LeistungenSection.astro
 *
 * Feature/services grid. Accepts an array of items and renders a responsive
 * card grid. Returns nothing if `items` is empty.
 *
 * Prop-driven: no imports from customer data modules.
 *
 * @example
 *   <LeistungenSection
 *     heading="Unsere Leistungen"
 *     subheading={siteData.tagline}
 *     items={siteData.leistungen}
 *   />
 */
import { linkifyPhones } from '../../utils/text/linkify-phones';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface LeistungItem {
  /** Emoji or short string used as a decorative icon. */
  icon?: string;
  /** Path to an SVG icon (e.g. `/icons/zahnrad.svg`). When set, overrides `icon`. */
  iconSvg?: string;
  /** Short title of the service/feature. */
  title: string;
  /** Optional descriptive body text. */
  description?: string;
  /** Optional link target. If set, a "Mehr erfahren" link is rendered. */
  href?: string;
  /**
   * Optionales Karten-Bild (Astro-optimierter Import via astro:assets, NICHT
   * String-Pfad — Muster wie Hero.image). Wird oben in der Karte gerendert,
   * wenn `cardStyle='image'`. Ohne imageSrc greift pro Item das Icon.
   */
  imageSrc?: ImageMetadata;
  /** Alt-Text für `imageSrc`. Fällt auf `title` zurück. */
  imageAlt?: string;
  /**
   * Optionale Telefonnummer für einen prominenten Anruf-Button in der Karte
   * (z. B. Notdienst/Schnellhilfe). Ist sie gesetzt, wird die Karte NICHT als
   * Ganzflächen-Link gerendert (das gäbe verschachtelte <a>), sondern mit
   * expliziten Buttons: "Mehr erfahren" (→ href) + Anruf-Button (tel:).
   */
  ctaPhone?: string;
}

interface Props {
  /** Section heading. Defaults to "Unsere Leistungen". */
  heading?: string;
  /** Section subheading, typically a tagline. */
  subheading?: string;
  /** Feature items to render. Section is hidden if array is empty. */
  items?: readonly LeistungItem[];
  /** Label for the "read more" link. Defaults to "Mehr erfahren". */
  readMoreLabel?: string;
  /** Max columns on desktop. Defaults to 2. */
  columns?: 2 | 3 | 4;
  /** Visual style for icons. 'plain' = SVG direkt. 'container' = SVG in farbigem Kreis-Container (Brand-V2-Print-Style). */
  iconStyle?: 'plain' | 'container';
  /** Hintergrundfarbe des Icon-Containers (nur wenn iconStyle='container'). Default: var(--color-accent). */
  iconContainerColor?: string;
  /**
   * Karten-Darstellung: 'icon' (Default — Icon oben) oder 'image' (Karten-Bild
   * oben, wenn `item.imageSrc` gesetzt; sonst Fallback aufs Icon pro Item).
   */
  cardStyle?: 'icon' | 'image';
  /** Label des Anruf-Buttons bei Items mit `ctaPhone`. Default "Anrufen". */
  ctaCallLabel?: string;
}

const {
  heading = 'Unsere Leistungen',
  subheading,
  items = [],
  readMoreLabel = 'Mehr erfahren',
  columns = 2,
  iconStyle = 'plain',
  iconContainerColor,
  cardStyle = 'icon',
  ctaCallLabel = 'Anrufen',
} = Astro.props;

const containerStyle = iconContainerColor ? `--icon-container-color:${iconContainerColor}` : undefined;
const toTelHref = (p?: string) => {
  if (!p) return '';
  const d = p.replace(/[^\d+]/g, '');
  return d.startsWith('+') ? d : '+49' + d.replace(/^0/, '');
};
---

{items.length > 0 && (
  <section class="leistungen-section">
    <div class="container">
      <h2 class="section-heading">{heading}</h2>
      {subheading && <p class="section-subheading">{subheading}</p>}
      <div class="leistungen-grid" style={`--cols:${columns}`}>
        {items.map((item) => item.ctaPhone ? (
          <div class="leistung-card leistung-card-cta">
            {cardStyle === 'image' && item.imageSrc
              ? <div class="leistung-image"><Image src={item.imageSrc} alt={item.imageAlt ?? item.title} widths={[400, 600, 800]} sizes="(max-width: 640px) 100vw, (max-width: 900px) 50vw, 33vw" loading="lazy" /></div>
              : item.iconSvg
                ? <div class:list={["leistung-icon leistung-icon-svg", `style-${iconStyle}`]} style={containerStyle} aria-hidden="true"><img src={item.iconSvg} alt="" aria-hidden="true" loading="lazy" decoding="async" /></div>
                : item.icon && <div class="leistung-icon" aria-hidden="true">{item.icon}</div>
            }
            <h3>{item.title}</h3>
            {item.description && <p>{item.description}</p>}
            <div class="leistung-card-actions">
              <a href={`tel:${toTelHref(item.ctaPhone)}`} class="leistung-call-btn" data-cta={`card-call:${item.title}`} aria-label={`${ctaCallLabel}: ${item.ctaPhone}`}>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/></svg>
                {ctaCallLabel}
              </a>
              {item.href && <a href={item.href} class="leistung-link leistung-link--btn">{readMoreLabel}<span> →</span></a>}
            </div>
          </div>
        ) : item.href ? (
          <a href={item.href} class="leistung-card leistung-card-link" data-cta={`leistung-card:${item.title}`}>
            {cardStyle === 'image' && item.imageSrc
              ? <div class="leistung-image"><Image src={item.imageSrc} alt={item.imageAlt ?? item.title} widths={[400, 600, 800]} sizes="(max-width: 640px) 100vw, (max-width: 900px) 50vw, 33vw" loading="lazy" /></div>
              : item.iconSvg
                ? <div class:list={["leistung-icon leistung-icon-svg", `style-${iconStyle}`]} style={containerStyle} aria-hidden="true"><img src={item.iconSvg} alt="" aria-hidden="true" loading="lazy" decoding="async" /></div>
                : item.icon && <div class="leistung-icon" aria-hidden="true">{item.icon}</div>
            }
            <h3>{item.title}</h3>
            {/* Link-Card ist selbst ein <a> → KEIN linkifyPhones (verschachtelte
                <a> sind ungültiges HTML und brechen die Karte). Nummer bleibt
                Plain-Text; die tel:-Verlinkung greift auf der Detailseite. */}
            {item.description && <p>{item.description}</p>}
            <span class="leistung-link" aria-hidden="true">
              {readMoreLabel}<span> →</span>
            </span>
          </a>
        ) : (
          <div class="leistung-card">
            {cardStyle === 'image' && item.imageSrc
              ? <div class="leistung-image"><Image src={item.imageSrc} alt={item.imageAlt ?? item.title} widths={[400, 600, 800]} sizes="(max-width: 640px) 100vw, (max-width: 900px) 50vw, 33vw" loading="lazy" /></div>
              : item.iconSvg
                ? <div class:list={["leistung-icon leistung-icon-svg", `style-${iconStyle}`]} style={containerStyle} aria-hidden="true"><img src={item.iconSvg} alt="" aria-hidden="true" loading="lazy" decoding="async" /></div>
                : item.icon && <div class="leistung-icon" aria-hidden="true">{item.icon}</div>
            }
            <h3>{item.title}</h3>
            {item.description && <p set:html={linkifyPhones(item.description)} />}
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .leistungen-section {
    padding: var(--section-padding, 5rem) 0;
    background: white;
  }

  .leistungen-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols, 2), 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
  }
  /* stylelint-disable-next-line plugin/no-max-width-media -- Legacy Desktop-First, TODO: refactor to Mobile-First */
  @media (max-width: 640px) {
    .leistungen-grid { grid-template-columns: 1fr; }
  }

  .leistung-card {
    background: var(--color-surface);
    border-radius: 0.75rem;
    padding: 2rem;
    border: 1px solid #e5e7eb;
    transition: box-shadow 0.2s, transform 0.2s, border-color 0.2s;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .leistung-card:hover {
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    transform: translateY(-2px);
  }

  /* Ganze Karte klickbar wenn href gesetzt — Card als <a>. */
  .leistung-card-link {
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }
  .leistung-card-link:hover {
    box-shadow: 0 8px 28px rgba(0, 70, 80, 0.15);
    border-color: var(--color-accent);
  }
  .leistung-card-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .leistung-icon {
    font-size: 2.25rem;
    line-height: 1;
    margin-bottom: 0.25rem;
  }

  .leistung-icon-svg {
    width: 3rem;
    height: 3rem;
    margin-bottom: 0.5rem;
  }
  .leistung-icon-svg img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Brand-V2 Container-Variant: Icon im farbigen Kreis (Print-Style aus Designer-Flyer). */
  .leistung-icon-svg.style-container {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: var(--icon-container-color, var(--color-accent));
    display: grid;
    place-items: center;
    padding: 0.875rem;
    margin-bottom: 0.875rem;
  }
  .leistung-icon-svg.style-container img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Karten-Bild (cardStyle='image'): randlos oben, 16:9, obere Ecken rund. */
  .leistung-image {
    margin: -2rem -2rem 1rem;
    border-radius: 0.75rem 0.75rem 0 0;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--color-surface);
  }
  .leistung-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .leistung-card h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0;
  }

  .leistung-card p {
    font-size: 0.9rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin: 0;
    flex: 1;
  }

  .leistung-link {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-accent-text);
    text-decoration: none;
  }

  .leistung-link:hover {
    text-decoration: underline;
  }

  /* ctaPhone-Karte: explizite Buttons (Mehr erfahren + Anrufen) statt Ganzflächen-Link. */
  .leistung-card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem 1rem;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.75rem;
  }
  .leistung-link--btn { margin-top: 0; }
  .leistung-call-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.05rem;
    border-radius: 0.5rem;
    background: var(--color-accent);
    color: var(--color-accent-btn-text, var(--color-primary));
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    transition: filter 0.15s, transform 0.15s;
  }
  .leistung-call-btn:hover { filter: brightness(0.95); transform: translateY(-1px); }
  .leistung-call-btn:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
</style>

<script>
  import { track } from '../../utils/analytics/track';
  // cw-tracking-safe: Selektor 'a.leistung-link' trifft NUR den Read-More-Anchor
  // (Branch A, kein data-cta) — nicht den dekorativen <span class="leistung-link">
  // in der Link-Card (Branch B), der in einem <a data-cta="leistung-card:"> liegt.
  // So feuert ein Karten-Klick entweder "Service Click" ODER "CTA Click", nie
  // beide (Doppelfeuer-Fix 2026-07-10, Guard: cta-double-fire.test.js).
  document.querySelectorAll<HTMLAnchorElement>('a.leistung-link').forEach((link) => {
    link.addEventListener('click', () => {
      const service = link.closest('.leistung-card')?.querySelector('h3')?.textContent?.trim() ?? '';
      track('Service Click', { service });
    });
  });
</script>
