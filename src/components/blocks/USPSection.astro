---
/**
 * @cw/core – USPSection.astro
 *
 * Grid of USP/value-prop cards. Prop-driven: no `@/data/site-data` import.
 *
 * @example
 *   <USPSection items={siteData.usps} />
 *
 * Opt-in seit v0.171.0: `items[].image` setzt ein Bild oben in die Karte (statt des
 * Symbols), `bildHerkunft` die KI-Kennzeichnung daran.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import AiLabelAmBild from './AiLabelAmBild.astro';
import { bildLabel } from '../../utils/bildlabel.js';

export interface USPItem {
  /** Emoji or short string used as visual icon. Optional — Cards können auch textbasiert rendern. */
  icon?: string;
  /** SVG-Pfad (z.B. /icons/zahnrad.svg). Wenn gesetzt, gewinnt es über `icon`. */
  iconSvg?: string;
  /**
   * Karten-Bild (Astro-Import aus astro:assets), opt-in seit v0.171.0. Gewinnt ueber
   * `iconSvg` und `icon`. Steht randlos oben in der Karte, 16:9.
   */
  image?: ImageMetadata;
  /** Alt-Text fuer `image`: das Motiv. Ohne Angabe leer (dekorativ). */
  imageAlt?: string;
  /** Card heading. */
  title: string;
  /** Card body copy. */
  description: string;
}

interface Props {
  /** USP items to render. Section is omitted entirely if empty. */
  items?: readonly USPItem[];
  /** Icon-Style. 'plain' = SVG direkt. 'container' = farbiger Kreis (Brand-V2-Print). Default: 'plain'. */
  iconStyle?: 'plain' | 'container';
  /** Container-Hintergrund (nur wenn iconStyle='container'). Default: var(--color-accent). */
  iconContainerColor?: string;
  /** Optionale Section-Überschrift über dem Grid. Ohne diesen Prop rendert das Grid headerlos (Backward-Compat). */
  heading?: string;
  /** Optionaler Untertitel unter der Überschrift. */
  subheading?: string;
  /**
   * `siteData.bildHerkunft` — Kennzeichnung nach Art. 50 AI Act an Karten-Bildern.
   * Ohne diese Prop aendert sich nichts.
   */
  bildHerkunft?: unknown[];
}

const { items = [], iconStyle = 'plain', iconContainerColor, heading, subheading, bildHerkunft } = Astro.props;
const bildDaten = { bildHerkunft };
const kartenLabel = await Promise.all(items.map((usp) => (usp.image ? bildLabel(bildDaten, usp.image) : null)));
const containerStyle = iconContainerColor ? `--icon-container-color:${iconContainerColor}` : undefined;
// Ohne Section-H2 wären die Karten-H3 ein Sprung direkt unter die H1 der Seite.
// Dann sind die Kartentitel Text, keine Überschriften; mit `heading` bleiben sie H3.
const TitleTag = heading ? 'h3' : 'p';
---
{items.length > 0 && (
<section class="usp-section">
  <div class="container">
    {(heading || subheading) && (
      <header class="usp-header">
        {heading && <h2>{heading}</h2>}
        {subheading && <p class="usp-sub">{subheading}</p>}
      </header>
    )}
    <div class="usp-grid">
      {items.map((usp, idx) => (
        <div class="usp-card">
          {usp.image
            ? <div class="usp-image"><Image src={usp.image} alt={usp.imageAlt ?? ''} widths={[320, 480, 640]} sizes="(max-width: 640px) 100vw, 33vw" loading="lazy" format="webp" />{kartenLabel[idx] && <AiLabelAmBild ergebnis={kartenLabel[idx]!.ergebnis} theme={kartenLabel[idx]!.theme} />}</div>
            : usp.iconSvg
            ? <div class:list={["usp-icon usp-icon-svg", `style-${iconStyle}`]} style={containerStyle} aria-hidden="true"><img src={usp.iconSvg} alt="" aria-hidden="true" loading="lazy" decoding="async" /></div>
            : usp.icon && <div class="usp-icon" aria-hidden="true">{usp.icon}</div>
          }
          <TitleTag class="usp-title">{usp.title}</TitleTag>
          <p>{usp.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
)}

<style>
  .usp-section { padding: 5rem 0; background: var(--color-surface); }
  .usp-header { text-align: center; margin-bottom: 2rem; }
  .usp-header h2 { color: var(--color-primary); font-size: 1.75rem; margin: 0 0 0.5rem; }
  .usp-header .usp-sub { color: var(--color-muted); font-size: 1.0625rem; max-width: 44rem; margin: 0 auto; line-height: 1.6; }
  .usp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }
  .usp-card {
    background: white;
    border-radius: 0.75rem;
    padding: 1.75rem;
    border: 1px solid #e5e7eb;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .usp-card:hover {
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    transform: translateY(-2px);
  }
  .usp-icon { font-size: 2rem; margin-bottom: 0.875rem; display: block; }
  .usp-icon-svg { width: 2.5rem; height: 2.5rem; margin-bottom: 0.875rem; }
  .usp-icon-svg img { width: 100%; height: 100%; object-fit: contain; }
  /* Opt-in v0.171.0: Karten-Bild randlos oben. */
  .usp-image {
    position: relative;
    container-type: inline-size;
    margin: -1.75rem -1.75rem 1.25rem;
    border-radius: 0.75rem 0.75rem 0 0;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--color-surface);
  }
  .usp-image :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* Brand-V2 Container-Variant analog LeistungenSection */
  .usp-icon-svg.style-container {
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: var(--icon-container-color, var(--color-accent));
    display: grid;
    place-items: center;
    padding: 0.75rem;
  }
  .usp-card .usp-title { font-family: var(--font-heading, var(--font-sans)); font-weight: 700; line-height: 1.2; overflow-wrap: break-word; font-size: 1rem; margin: 0 0 0.5rem; color: var(--color-primary); }
  .usp-card p { font-size: 0.9rem; color: var(--color-muted); line-height: 1.6; margin: 0; }
</style>
