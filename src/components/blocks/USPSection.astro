---
/**
 * @cw/core – USPSection.astro
 *
 * Grid of USP/value-prop cards. Prop-driven: no `@/data/site-data` import.
 *
 * @example
 *   <USPSection items={siteData.usps} />
 */
export interface USPItem {
  /** Emoji or short string used as visual icon. Optional — Cards können auch textbasiert rendern. */
  icon?: string;
  /** SVG-Pfad (z.B. /icons/zahnrad.svg). Wenn gesetzt, gewinnt es über `icon`. */
  iconSvg?: string;
  /** Card heading. */
  title: string;
  /** Card body copy. */
  description: string;
}

interface Props {
  /** USP items to render. Section is omitted entirely if empty. */
  items?: readonly USPItem[];
  /** Icon-Style. 'plain' = SVG direkt. 'container' = farbiger Kreis (Brand-V2-Print). Default: 'plain'. */
  iconStyle?: 'plain' | 'container';
  /** Container-Hintergrund (nur wenn iconStyle='container'). Default: var(--color-accent). */
  iconContainerColor?: string;
}

const { items = [], iconStyle = 'plain', iconContainerColor } = Astro.props;
const containerStyle = iconContainerColor ? `--icon-container-color:${iconContainerColor}` : undefined;
---
{items.length > 0 && (
<section class="usp-section">
  <div class="container">
    <div class="usp-grid">
      {items.map((usp) => (
        <div class="usp-card">
          {usp.iconSvg
            ? <div class:list={["usp-icon usp-icon-svg", `style-${iconStyle}`]} style={containerStyle} aria-hidden="true"><img src={usp.iconSvg} alt="" /></div>
            : usp.icon && <div class="usp-icon" aria-hidden="true">{usp.icon}</div>
          }
          <h3>{usp.title}</h3>
          <p>{usp.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
)}

<style>
  .usp-section { padding: 5rem 0; background: var(--color-surface); }
  .usp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }
  .usp-card {
    background: white;
    border-radius: 0.75rem;
    padding: 1.75rem;
    border: 1px solid #e5e7eb;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .usp-card:hover {
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    transform: translateY(-2px);
  }
  .usp-icon { font-size: 2rem; margin-bottom: 0.875rem; display: block; }
  .usp-icon-svg { width: 2.5rem; height: 2.5rem; margin-bottom: 0.875rem; }
  .usp-icon-svg img { width: 100%; height: 100%; object-fit: contain; }
  /* Brand-V2 Container-Variant analog LeistungenSection */
  .usp-icon-svg.style-container {
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: var(--icon-container-color, var(--color-accent));
    display: grid;
    place-items: center;
    padding: 0.75rem;
  }
  .usp-card h3 { font-size: 1rem; margin-bottom: 0.5rem; color: var(--color-primary); }
  .usp-card p { font-size: 0.9rem; color: var(--color-muted); line-height: 1.6; margin: 0; }
</style>
