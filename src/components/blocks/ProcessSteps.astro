---
/**
 * @cw/core – ProcessSteps.astro
 *
 * Numbered "how it works" step grid. Prop-driven: no `@/data/site-data`
 * import.
 *
 * @example
 *   <ProcessSteps items={siteData.processSteps} />
 *
 * Opt-in seit v0.171.0: `items[].image` zeigt statt des Symbols ein Bild oben in der
 * Karte, `bildHerkunft` setzt daran die KI-Kennzeichnung, `numberStyle="solid"` malt
 * die grosse Ziffer gefuellt statt als Kontur.
 *
 * Opt-in seit v0.177.0: `layout="weg"` erzaehlt die Schritte als Weg — je Schritt eine
 * Zeile mit grossem Bild, abwechselnd links und rechts, verbunden durch eine gepunktete
 * Linie. Fuer echte Abfolgen mit Fotos (Anfahrt, erster Besuch), nicht fuer Feature-Listen.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import AiLabelAmBild from './AiLabelAmBild.astro';
import { bildLabel } from '../../utils/bildlabel.js';

export interface ProcessStep {
  /** Step number (rendered as large faded background number). */
  nr: string | number;
  /** Emoji or short string used as visual icon. Entfaellt, wenn `image` gesetzt ist. */
  icon?: string;
  /**
   * Bild statt Symbol (Astro-Import aus astro:assets, kein String-Pfad), opt-in seit
   * v0.171.0. Steht oben in der Karte, 4:3, randlos.
   */
  image?: ImageMetadata;
  /** Alt-Text fuer `image`: das Motiv, nicht der Schritt-Titel. Ohne Angabe leer und als dekorativ markiert (`role="presentation"`). */
  imageAlt?: string;
  /** Step title. */
  title: string;
  /** Step description. */
  desc: string;
}

interface Props {
  /** Step entries. Section is omitted entirely if empty. */
  items?: readonly ProcessStep[];
  /** Optional override for the section heading. */
  heading?: string;
  /** Optional override for the section subheading. `{count}` is replaced with `items.length`. */
  subheadingTemplate?: string;
  /** Fixed column count. Default: auto (smart calcCols). */
  columns?: 2 | 3 | 4 | 5;
  /**
   * `siteData.bildHerkunft` — setzt an Schritt-Bildern die Kennzeichnung nach Art. 50
   * AI Act, wie Hero und LeistungenSection. Ohne diese Prop aendert sich nichts.
   */
  bildHerkunft?: unknown[];
  /**
   * Darstellung der grossen Schritt-Ziffer, opt-in seit v0.171.0. `outline` (Default)
   * ist die bisherige Kontur per `-webkit-text-stroke`. `solid` malt sie gefuellt in
   * der Akzentfarbe mit geringer Deckkraft — fuer Schriften mit ueberlappenden
   * Konturen, bei denen der Strich die inneren Ueberlappungen als Linien sichtbar macht.
   *
   * Gemessen 08.10.2026 auf haarwerk (system-ui, unter macOS SF Pro, Gewicht 800):
   * die Kontur-„2“ zeigt dort, wo Diagonale und Fuss sich ueberlappen, ein
   * Sternchen-Artefakt; 1, 3 und 4 nicht. Mit `solid` ist es weg. Belege:
   * `reports/2026-10-08-ziffer-2/`.
   */
  numberStyle?: 'outline' | 'solid';
  /**
   * Anordnung, opt-in seit v0.177.0. `raster` (Default) ist das bisherige Kartenraster.
   * `weg` setzt jeden Schritt in eine eigene Zeile: Bild (4:3, gross) und Text
   * nebeneinander, die Seiten wechseln von Zeile zu Zeile, eine gepunktete Linie fuehrt
   * zum naechsten Schritt. Unter 760 px einspaltig, Bild oben. `columns` wirkt hier nicht.
   * Schritte ohne `image` zeigen ihr Symbol in einer Flaeche gleicher Groesse.
   *
   * Anlass: levia-therapiezentrum, Redesign 19.10.2026 („Der Weg zu uns“: Schild,
   * Windfang, Eingang, Therapieraum — die Angst vor dem ersten Termin nehmen).
   */
  layout?: 'raster' | 'weg';
}

const {
  items = [],
  heading = "So funktioniert's",
  subheadingTemplate = 'Von Erstgespräch bis Live-Gang in {count} einfachen Schritten.',
  columns,
  bildHerkunft,
  numberStyle = 'outline',
  layout = 'raster',
} = Astro.props;
const istWeg = layout === 'weg';

/* Je Schritt einmal im Frontmatter aufgeloest — `bildLabel` ist asynchron. */
const bildDaten = { bildHerkunft };
const schrittLabel = await Promise.all(
  items.map((step) => (step.image ? bildLabel(bildDaten, step.image) : null)),
);

// Symmetrisches Grid ohne Orphan-Zeilen.
// Formel: cols = min(5, ceil(n/2)) — erzeugt immer ≥ 2 Zeilen mit gleichmäßiger Füllung.
// Bei Einzelwaisen (n % cols === 1) einen Schritt runter.
// n=4→2×2, n=5→3+2, n=6→3×2, n=7→4+3, n=8→4×2, n=9→3×3, n=10→5×2
function calcCols(n: number): 2 | 3 | 4 | 5 | undefined {
  if (n <= 3) return undefined;
  let c = Math.min(5, Math.ceil(n / 2)) as 2 | 3 | 4 | 5;
  if (n % c === 1 && c > 2) {
    const alt = (c - 1) as 2 | 3 | 4;
    if (n % alt !== 1) c = alt;
  }
  return c;
}
const smartColumns: 2 | 3 | 4 | 5 | undefined = columns ?? calcCols(items.length);

const subheading = subheadingTemplate.replace('{count}', String(items.length));
---
{items.length > 0 && (
<section class="process-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-heading">{heading}</h2>
      <p class="section-subheading">{subheading}</p>
    </div>

    {istWeg ? (
    <ol class={`weg${numberStyle === 'solid' ? ' nr-solid' : ''}`}>
      {items.map((step, idx) => (
        <li class="weg-schritt">
          <div class="weg-bild">
            {step.image
              ? <><Image src={step.image} alt={step.imageAlt ?? ''} role={step.imageAlt ? undefined : 'presentation'} widths={[480, 720, 960, 1200]} sizes="(max-width: 759px) 100vw, 55vw" loading="lazy" format="webp" class="weg-img" />{schrittLabel[idx] && <AiLabelAmBild ergebnis={schrittLabel[idx]!.ergebnis} theme={schrittLabel[idx]!.theme} />}</>
              : <div class="weg-symbol" aria-hidden="true">{step.icon}</div>}
          </div>
          <div class="weg-text">
            <span class="weg-nr" aria-hidden="true">{step.nr}</span>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </div>
        </li>
      ))}
    </ol>
    ) : (
    <div class={`steps${smartColumns ? ` cols-${smartColumns}` : ''}${numberStyle === 'solid' ? ' nr-solid' : ''}`}>
      {items.map((step, idx) => (
        <div class="step" data-step-nr={step.nr}>
          <div class="step-body">
            {step.image
              ? <div class="step-image"><Image src={step.image} alt={step.imageAlt ?? ''} role={step.imageAlt ? undefined : 'presentation'} widths={[320, 480, 640]} sizes="(max-width: 559px) 100vw, (max-width: 919px) 50vw, 25vw" loading="lazy" format="webp" class="step-img" />{schrittLabel[idx] && <AiLabelAmBild ergebnis={schrittLabel[idx]!.ergebnis} theme={schrittLabel[idx]!.theme} />}</div>
              : <div class="step-icon" aria-hidden="true">{step.icon}</div>}
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </div>
        </div>
      ))}
    </div>
    )}
  </div>
</section>
)}

<style>
  /* Mobile-first: immer 1 Spalte auf schmalen Screens, auch wenn
     `columns={2|3|4}` gesetzt ist. Davor brach `.cols-4` (specificity 0,2,0)
     die `@media (max-width: 500px) .steps { 1fr }` Override (specificity 0,1,0)
     und zwang 4 Spalten bei 375 px. */
  .process-section { padding: 4.5rem 0 5rem; background: white; }
  .section-header { text-align: center; margin-bottom: 2.5rem; }

  .steps,
  .steps.cols-2,
  .steps.cols-3,
  .steps.cols-4,
  .steps.cols-5 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .step { position: relative; }
  /* Decorative big-number watermark via ::before pseudo-element.
     Wichtig: kein DOM-Element — axe-core prüft color-contrast nicht
     auf generated content via content: attr(...). Visueller Effekt
     identisch zum vorherigen .step-nr (Outline via text-stroke). */
  .step::before {
    content: attr(data-step-nr);
    display: block;
    font-size: 3rem;
    font-weight: 800;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--color-accent);
    line-height: 1;
    margin-bottom: 0.5rem;
    opacity: 0.55;
  }
  .step-body {
    background: var(--color-surface);
    border-radius: 0.75rem;
    padding: 1.5rem;
    height: 100%;
  }
  .step-icon { font-size: 1.75rem; margin-bottom: 0.75rem; display: block; }
  /* Opt-in v0.171.0: gefuellte Ziffer statt Kontur.
     Deckkraft 0.3 → 0.8 und `--color-accent-text` statt `--color-accent` (25.10.2026).
     ANLASS spedition-steller: `numberStyle="solid"` sollte die Ziffer sichtbar machen und
     tat das Gegenteil — 0.3 Deckkraft auf der Akzentfarbe ergab 1,48:1 bis 1,50:1, also
     praktisch unsichtbar. Gemeldet hat das kein Audit: `::before` ist ein Pseudo-Element,
     und axe prueft darauf keinen Farbkontrast. Aufgefallen ist es erst an der Weg-Variante
     unten, die dieselbe Mechanik in einem echten <span> traegt.
     `--color-accent-text` ist in tokens-base.css als "WCAG AA 4,5:1 auf Weiss" definiert;
     der Fallback haelt Kunden ohne diesen Token lauffaehig. Gerechnet ueber 21 Flotten-
     Werte: bei 0.8 ist der schlechteste Fall 3,31:1 (gowohnen), bei 0.7 nur 2,77:1 — die
     Ziffer ist 56 px / 900, also Large Text mit Schwelle 3:1 (WCAG 1.4.3). */
  .nr-solid .step::before {
    color: var(--color-accent-text, var(--color-accent));
    -webkit-text-stroke: 0;
    opacity: 0.8;
  }
  /* Opt-in v0.171.0: Bild statt Symbol, randlos oben in der Karte. */
  .step-image {
    /* Anker und Bezugsbreite fuer die KI-Kennzeichnung. */
    position: relative;
    container-type: inline-size;
    margin: -1.5rem -1.5rem 1rem;
    border-radius: 0.75rem 0.75rem 0 0;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--color-surface);
  }
  .step-image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .step-body h3 { font-size: 1.0625rem; margin-bottom: 0.5rem; }
  .step-body p { font-size: 0.9rem; color: var(--color-muted); line-height: 1.65; margin: 0; }

  @media (min-width: 560px) {
    .process-section { padding: 5rem 0; }
    .section-header { margin-bottom: 3.5rem; }
    .steps { gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
    .steps.cols-2,
    .steps.cols-3,
    .steps.cols-4,
    .steps.cols-5 { gap: 1.5rem; grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 760px) {
    .steps.cols-3,
    .steps.cols-4,
    .steps.cols-5 { grid-template-columns: repeat(3, 1fr); }
  }

  @media (min-width: 920px) {
    .steps.cols-4,
    .steps.cols-5 { grid-template-columns: repeat(4, 1fr); }
  }

  @media (min-width: 1100px) {
    .steps.cols-5 { grid-template-columns: repeat(5, 1fr); }
  }

  /* --- Weg (opt-in `layout="weg"`, v0.177.0) ------------------------------
   * Liste statt Raster: die Reihenfolge ist Inhalt, deshalb <ol>. Die Ziffer steht
   * als eigenes Element (aria-hidden, die Liste zaehlt fuer Screenreader selbst). */
  .weg { list-style: none; margin: 0; padding: 0; display: grid; gap: 3.5rem; }
  .weg-schritt { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.25rem; position: relative; }
  .weg-bild {
    position: relative;
    container-type: inline-size;
    border-radius: 1.125rem;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--color-surface);
  }
  .weg-img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .weg-symbol { display: grid; place-items: center; height: 100%; font-size: 4rem; }
  .weg-nr {
    display: block;
    font-size: clamp(3.5rem, 7vw, 6rem);
    font-weight: 900;
    line-height: 0.85;
    color: transparent;
    -webkit-text-stroke: 2px var(--color-primary);
    opacity: 0.55;
  }
  /* Deckkraft 0.25 → 0.8 (25.10.2026, siehe Begruendung bei .nr-solid .step::before).
     Hier traegt die Primaerfarbe, nicht der Akzent: schlechtester Flotten-Wert 4,10:1. */
  .weg.nr-solid .weg-nr { color: var(--color-primary); -webkit-text-stroke: 0; opacity: 0.8; }
  .weg-text h3 { margin: 1rem 0 0.5rem; font-size: clamp(1.4rem, 2.6vw, 1.9rem); line-height: 1.15; }
  .weg-text p { margin: 0; font-size: 1.1rem; line-height: 1.6; max-width: 36ch; }

  @media (min-width: 760px) {
    .weg { gap: 6rem; }
    .weg-schritt { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 4rem; align-items: center; }
    .weg-schritt:nth-child(even) { grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); }
    .weg-schritt:nth-child(even) .weg-bild { order: 2; }
    /* Gepunktete Linie zum naechsten Schritt, mittig in der Luecke. */
    .weg-schritt:not(:last-child)::after {
      content: '';
      position: absolute;
      left: 50%;
      top: 100%;
      height: 6rem;
      border-left: 3px dotted color-mix(in srgb, var(--color-primary) 35%, transparent);
    }
  }
</style>
