---
/**
 * @cw/core – Hero.astro
 *
 * Reusable hero section with two layout variants:
 *   • `image` prop set  → Split-Layout (Text 55%, Image 45%)
 *   • `image` not set   → Gradient-Only (Text left-aligned, full-width)
 *
 * Prop-driven: no imports from customer data modules. The consuming page
 * (or a higher-level page component) is responsible for passing site data
 * from `@/data/site-data` (or equivalent) via props.
 *
 * @example
 *   <Hero
 *     badge="Fertig in 7 Tagen"
 *     headline="Professionelle Website.<br/>Ohne Warteliste."
 *     subtext="…"
 *     ctaPrimary={{ label: 'Beratung anfragen', href: '/kontakt' }}
 *     ctaSecondary={{ label: 'Audit', href: '/website-audit' }}
 *     usps={siteData.usps}
 *     siteName={siteData.name}
 *   />
 */
import { Image, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import AnimatedBlob from '../motion/AnimatedBlob.astro';
import TextReveal from '../motion/TextReveal.astro';
import StaggerGroup from '../motion/StaggerGroup.astro';
import ParallaxImage from '../motion/ParallaxImage.astro';
import MagneticButton from '../motion/MagneticButton.astro';
import TiltCard from '../motion/TiltCard.astro';
import AiLabelAmBild from './AiLabelAmBild.astro';
import { bildLabel } from '../../utils/bildlabel.js';

export interface HeroCollageImage {
  src: ImageMetadata;
  alt?: string;
}

export interface HeroCTA {
  label: string;
  href: string;
  /** Optional link target (e.g. "_blank" for external booking links). */
  target?: string;
  /** Optional rel attribute. Set "noopener noreferrer" when target="_blank". */
  rel?: string;
}

export interface HeroUSP {
  icon: string;
  title: string;
}

export interface HeroMotionConfig {
  /** Animated mesh-gradient blob background. */
  blob?: boolean;
  /** Character/word reveal on headline. */
  textReveal?: boolean;
  /** Stagger USP chips. */
  stagger?: boolean;
  /** Parallax on hero image. */
  parallax?: boolean;
  /** Magnetic pull on the PRIMARY CTA (secondary stays static by design). */
  magnetic?: boolean;
}

interface Props {
  /** Small badge above the headline. Defaults to "Fertig in 7 Tagen – garantiert". */
  badge?: string;
  /** Main headline. Supports HTML (e.g. `<br/>`) via set:html. */
  headline: string;
  /** Sub-copy under the headline. */
  subtext?: string;
  /**
   * Optional hero image. If set, triggers split layout.
   *
   * MUST be an `ImageMetadata` (Astro-optimierter Import), NICHT ein String-Pfad —
   * nur so greift Astros Bild-Pipeline (responsive `srcset`, Rekompression, moderne Formate).
   *
   * @example
   *   import heroImage from '@/assets/images/hero.webp';
   *   <Hero image={heroImage} ... />
   */
  image?: ImageMetadata;
  /**
   * Optionales Hero-Bild als **public-URL-String** (Alternative zu `image`) — für
   * Customer, deren Foto in `public/` liegt (z.B. zusätzlich als CSS-Background genutzt)
   * und bereits eigene responsive Varianten hat. Triggert ebenfalls das Split-Layout.
   *
   * `image` (ImageMetadata) hat Vorrang, falls beide gesetzt sind.
   *
   * @example
   *   <Hero imageSrc="/images/team.webp"
   *         imageSrcset="/images/team-sm.webp 500w, /images/team.webp 1024w"
   *         imageSizes="(max-width: 768px) 100vw, 45vw"
   *         imageWidth={1024} imageHeight={664} ... />
   */
  imageSrc?: string;
  /** `srcset` für `imageSrc` (responsive). */
  imageSrcset?: string;
  /** `sizes` für `imageSrc`. */
  imageSizes?: string;
  /** Intrinsische Breite für `imageSrc` (CLS-Schutz). */
  imageWidth?: number;
  /** Intrinsische Höhe für `imageSrc` (CLS-Schutz). */
  imageHeight?: number;
  /**
   * Optional Hero-Collage (2–3 overlapping images). If set, takes precedence
   * over `image` and triggers a third layout mode: three staggered, rotated
   * photos with subtle TiltCard interactivity on hover (same motion as
   * PaketeSection). On narrow viewports the collage stacks vertically.
   *
   * @example
   *   import img1 from '@/assets/images/hero/a.webp';
   *   <Hero images={[{ src: img1 }, { src: img2 }, { src: img3 }]} ... />
   */
  images?: readonly HeroCollageImage[];
  /** Alt text for the hero image. Falls back to `siteName`. */
  imageAlt?: string;
  /**
   * Set to `true` for cut-out / transparent-background hero images
   * (PNG/WebP with alpha channel — e.g. freigestellte Person, Produkt).
   *
   * Effects:
   * - Removes the card-style frame (no border-radius, no box-shadow, no overflow-clip)
   *   so the rectangle around the silhouette disappears.
   * - Replaces the box-shadow with a `drop-shadow()` filter that follows the alpha mask.
   * - On mobile (≤900px) drops the fixed `height: 280px` cap so the motive isn't cropped;
   *   uses `max-height: 60vh` + `object-fit: contain` instead.
   *
   * Leave `false` (default) for opaque/photographic hero images that should fill
   * the card with `object-fit: cover`.
   */
  transparentImage?: boolean;
  /**
   * Ersetzt das Hero-Bild durch den `visual`-Slot, SOBALD JavaScript laeuft.
   *
   * Gedacht fuer interaktive Inhalte, die ohne Skript nichts anzeigen koennen —
   * eine Demo, ein Rechner. Ohne JavaScript bleibt das Bild stehen, es gibt also
   * nie eine leere Flaeche neben der Schlagzeile.
   *
   * Wirkt nur zusammen mit einem befuellten `visual`-Slot. Ist er leer, aendert
   * das Flag nichts.
   *
   * @example
   *   <Hero image={foto} visualSwap>
   *     <MeineDemo slot="visual" />
   *   </Hero>
   */
  visualSwap?: boolean;
  /** Site name used as image alt fallback. */
  siteName?: string;
  /** Primary CTA (accent button). */
  ctaPrimary?: HeroCTA;
  /** Optional secondary CTA (outline button). */
  ctaSecondary?: HeroCTA;
  /** Optional USP chips shown below the CTAs. */
  usps?: readonly HeroUSP[];
  /** Opt-in motion effects. Any omitted flags default to off (static hero). */
  motion?: HeroMotionConfig | boolean;
  /**
   * `siteData.bildHerkunft` — die Bild-Deklaration des Kunden. Ist sie gesetzt und weist
   * das Hero-Bild als Deepfake im Sinne von Art. 3 Nr. 60 aus, setzt der Hero die
   * Kennzeichnung nach Art. 50 Abs. 4 UAbs. 1 AI Act selbst.
   *
   * Warum hier und nicht in der Seite: der Hero rendert sein `<Image>` im eigenen Markup,
   * von aussen ist darin nichts zu platzieren. Bei mika-elektrotechnik war dasselbe
   * KI-Bild deshalb auf der Leistungsseite gekennzeichnet und als Startseiten-Kachel nicht.
   *
   * Ohne diese Prop aendert sich am gerenderten Hero nichts.
   *
   * @example
   *   <Hero image={heroImage} bildHerkunft={siteData.bildHerkunft} ... />
   */
  bildHerkunft?: unknown[];
}

const {
  badge = 'Fertig in 7 Tagen – garantiert',
  headline,
  subtext,
  image,
  imageSrc,
  imageSrcset,
  imageSizes,
  imageWidth,
  imageHeight,
  images,
  imageAlt,
  transparentImage = false,
  visualSwap = false,
  siteName,
  ctaPrimary = { label: 'Kostenlose Beratung anfragen', href: '/kontakt' },
  ctaSecondary,
  usps = [],
  motion,
  bildHerkunft,
} = Astro.props;

const hasImages = Array.isArray(images) && images.length >= 2;
const hasImage = !hasImages && (!!image || !!imageSrc);
const hasMedia = hasImages || hasImage;
/* Der Slot ersetzt das Bild nur, wenn er auch befuellt ist — sonst stuende bei
   gesetztem Flag eine leere Flaeche, wo vorher ein Foto war. Gleiches Muster wie
   `shouldFlush` in ContentPage.astro. */
const hatVisual = Astro.slots.has('visual');
const tauscheVisual = visualSwap && hatVisual;
const motionCfg: HeroMotionConfig =
  motion === true
    ? { blob: true, textReveal: true, stagger: true, parallax: true, magnetic: true }
    : (motion || {});

/* Die Kennzeichnung wird im Frontmatter aufgeloest, nicht im Markup: `bildLabel` ist
   asynchron (es misst bei Pflicht die Helligkeit der Badge-Ecke), und in einem `.map()`
   im Template gibt es kein `await`. */
const bildDaten = { bildHerkunft };
const heroLabel = hasImage ? await bildLabel(bildDaten, image ?? imageSrc) : null;
const collagenLabel = hasImages
  ? await Promise.all(images!.slice(0, 3).map((img) => bildLabel(bildDaten, img.src)))
  : [];
---
<section class:list={['hero', (hasMedia || hatVisual) && 'hero--split', hasImages && 'hero--collage', motionCfg.blob && 'hero--with-blob', hasImage && transparentImage && 'hero--transparent-image', tauscheVisual && 'hero--visual-swap']}>
  {motionCfg.blob && <AnimatedBlob opacity={0.85} blur="100px" />}
  <div class="container">
    <div class="hero-content">
      <div class="hero-badge">
        <svg width="14" height="14" viewBox="0 0 512 512" aria-hidden="true">
          <polygon points="296,80 176,288 248,288 216,432 336,224 264,224" fill="currentColor"/>
        </svg>
        {badge}
      </div>

      {/* `hero-title` in BEIDEN Zweigen — die Ueberschrift wird im textReveal-Zweig von
          TextReveal gerendert und traegt dann DEREN Astro-Scope, nicht den des Hero. Ein
          scoped `h1 { … }` hier kann sie deshalb nicht treffen. Gestylt wird ueber
          `.hero-content :global(.hero-title)`, siehe Style-Block. */}
      {motionCfg.textReveal ? (
        <TextReveal as="h1" class="hero-title" split="word" delay={0.05}>
          <Fragment set:html={headline} />
        </TextReveal>
      ) : (
        <h1 class="hero-title" set:html={headline} />
      )}

      {subtext && <p class="hero-sub">{subtext}</p>}

      <div class="hero-cta">
        {motionCfg.magnetic ? (
          <MagneticButton>
            <a href={ctaPrimary.href} target={ctaPrimary.target} rel={ctaPrimary.rel} class="btn-accent" data-cta={`hero-primary:${ctaPrimary.label}`}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
              {ctaPrimary.label}
            </a>
          </MagneticButton>
        ) : (
          <a href={ctaPrimary.href} target={ctaPrimary.target} rel={ctaPrimary.rel} class="btn-accent" data-cta={`hero-primary:${ctaPrimary.label}`}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
            {ctaPrimary.label}
          </a>
        )}
        {ctaSecondary && (
          <a href={ctaSecondary.href} target={ctaSecondary.target} rel={ctaSecondary.rel} class="btn-outline" data-cta={`hero-secondary:${ctaSecondary.label}`}>
            {ctaSecondary.label}
          </a>
        )}
      </div>

      {usps.length > 0 && (
        motionCfg.stagger ? (
          <StaggerGroup class="hero-usps" direction="up" gap={0.08} delay={0.2}>
            {usps.map((usp: HeroUSP) => (
              <div class="hero-usp-item">
                <span class="usp-icon" aria-hidden="true">{usp.icon}</span>
                <span>{usp.title}</span>
              </div>
            ))}
          </StaggerGroup>
        ) : (
          <div class="hero-usps">
            {usps.map((usp: HeroUSP) => (
              <div class="hero-usp-item">
                <span class="usp-icon" aria-hidden="true">{usp.icon}</span>
                <span>{usp.title}</span>
              </div>
            ))}
          </div>
        )
      )}
    </div>

    {/*
      fallbackFormat="webp" ist Pflicht, nicht Kosmetik: `formats` steuert nur die
      <source>-Eintraege, das <img>-Fallback erzeugt Astro sonst im Default — PNG,
      unkomprimiert. Aus einer 144-KB-WebP-Quelle wurde so ein 1900-KB-PNG, das in
      jedem dist/ mitliegt (gemessen 10.08.2026 an zink/mika/schiller/steller).
      Moderne Browser laden es nie, aber es zaehlt gegen das Perf-Budget und hielt
      fuenf Kunden dauerhaft rot. Siehe blitzsicht-ops#641.
    */}
    {hasImage && (
      motionCfg.parallax ? (
        <ParallaxImage class="hero-image-wrap" speed={0.2}>
          {image ? (
            <Picture
              src={image}
              alt={imageAlt ?? siteName ?? ''}
              widths={[400, 600, 800]}
              sizes="(max-width: 767px) 100vw, 45vw"
              loading={tauscheVisual ? 'lazy' : 'eager'}
              fetchpriority={tauscheVisual ? 'auto' : 'high'}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              class="hero-img"
            />
          ) : (
            <img
              src={imageSrc!}
              srcset={imageSrcset}
              sizes={imageSizes ?? '(max-width: 767px) 100vw, 45vw'}
              width={imageWidth}
              height={imageHeight}
              alt={imageAlt ?? siteName ?? ''}
              loading={tauscheVisual ? 'lazy' : 'eager'}
              fetchpriority={tauscheVisual ? 'auto' : 'high'}
              decoding="async"
              class="hero-img"
            />
          )}{heroLabel && <AiLabelAmBild ergebnis={heroLabel.ergebnis} theme={heroLabel.theme} />}
        </ParallaxImage>
      ) : (
        <div class="hero-image-wrap">
          {image ? (
            <Picture
              src={image}
              alt={imageAlt ?? siteName ?? ''}
              widths={[400, 600, 800]}
              sizes="(max-width: 767px) 100vw, 45vw"
              loading={tauscheVisual ? 'lazy' : 'eager'}
              fetchpriority={tauscheVisual ? 'auto' : 'high'}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              class="hero-img"
            />
          ) : (
            <img
              src={imageSrc!}
              srcset={imageSrcset}
              sizes={imageSizes ?? '(max-width: 767px) 100vw, 45vw'}
              width={imageWidth}
              height={imageHeight}
              alt={imageAlt ?? siteName ?? ''}
              loading={tauscheVisual ? 'lazy' : 'eager'}
              fetchpriority={tauscheVisual ? 'auto' : 'high'}
              decoding="async"
              class="hero-img"
            />
          )}{heroLabel && <AiLabelAmBild ergebnis={heroLabel.ergebnis} theme={heroLabel.theme} />}
        </div>
      )
    )}

    {/*
      Der Slot steht NEBEN dem Bild, nicht statt seiner: welches von beiden zu
      sehen ist, entscheidet CSS. Waere das Bild bei gesetztem `visualSwap` gar
      nicht erst im Markup, gaebe es ohne JavaScript eine leere Flaeche — und
      genau dafuer ist der Fallback da.

      Das Bild verliert dabei seine Ladepriorität (siehe oben): es ist dann nur
      noch Rueckfallebene und darf den kritischen Pfad nicht belegen. Ohne das
      laedt der Browser ein grosses Foto mit `fetchpriority="high"`, das
      anschliessend versteckt wird — das Schlechteste aus beiden Welten.
    */}
    {hatVisual && (
      <div class="hero-visual-wrap" data-hero-visual>
        <slot name="visual" />
      </div>
    )}

    {hasImages && (
      <div class="hero-collage" aria-hidden="false">
        {images!.slice(0, 3).map((img, idx) => (
          <TiltCard class={`hero-collage-item hero-collage-item--${idx + 1}`} maxTilt={4} scale={1.02}>
            <div class="hero-collage-frame">
              <Image
                src={img.src}
                alt={img.alt ?? imageAlt ?? siteName ?? ''}
                widths={[320, 480, 640]}
                sizes="(max-width: 900px) 70vw, 28vw"
                loading="eager"
                fetchpriority={idx === 1 ? 'high' : 'auto'}
                format="webp"
                class="hero-collage-img"
              />
              {collagenLabel[idx] && (
                <AiLabelAmBild ergebnis={collagenLabel[idx]!.ergebnis} theme={collagenLabel[idx]!.theme} />
              )}
            </div>
          </TiltCard>
        ))}
      </div>
    )}
  </div>
</section>

<!--
  Kein komponenten-lokaler CTA-Click-Listener mehr (entfernt v0.66):
  '.hero-cta a' trägt data-cta (hero-primary:/hero-secondary:), das der globale
  BaseLayout-Listener (inline) bzw. <PlausibleEvents> (full) als SSOT-Goal
  "CTA Click" abfängt. Der frühere track('Hero CTA Click') war ein totes
  Non-Goal-Event, das auf denselben Klick doppelt feuerte (Tracking-Audit
  2026-07-10). Guard: tests/ai-discovery/cta-double-fire.test.js.
-->
<style>
  .hero {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-hero-gradient-end, color-mix(in srgb, var(--color-primary), #000 35%)) 100%);
    color: white;
    padding: 5rem 0 4rem;
  }
  /* When AnimatedBlob is rendered as a child, the section must clip and
     stack its own content above the absolute-positioned blob layer.
     We drop the linear-gradient so the animated blobs become the
     dominant background layer instead of fighting a static gradient. */
  .hero--with-blob {
    position: relative;
    overflow: hidden;
    background: var(--color-primary, #1D1E3B);
  }
  .hero--with-blob .container { position: relative; z-index: 1; }

  /* Split-Layout (mit Bild) */
  .hero--split .container {
    display: grid;
    /* minmax(0, …) statt blossem fr: `55fr` ist `minmax(auto, 55fr)`, und
       `auto` heisst min-content. Ein langes Wort im Hero zieht die Spalte
       damit ueber ihren Anteil hinaus und sprengt den Container. */
    grid-template-columns: minmax(0, 55fr) minmax(0, 45fr);
    gap: 3rem;
    align-items: center;
  }
  .hero-image-wrap {
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 24px 64px rgba(0,0,0,0.35);
  }
  /* Anker fuer die KI-Kennzeichnung, die unten links im Bild sitzt.
     `:global` ist hier Pflicht, nicht Stil: mit `motion.parallax` rendert ParallaxImage
     diesen Wrapper, und er traegt dann DESSEN Scope-Kennung statt der von Hero — eine
     gescopte Regel greift an ihm nicht, und das Badge fiele aus dem Bild heraus an den
     Seitenrand. Dieselbe Ursache wie bei `.hero--visual-swap` und `.hero--collage`. */
  .hero :global(.hero-image-wrap) {
    position: relative;
    /* Bezugsbreite fuer die Badge-Groesse (clamp(..., 2.4cqw, ...) in AiLabelAmBild).
       Ohne diesen Container misst cqw das Browserfenster statt des Bildes. */
    container-type: inline-size;
  }

  /* --- visual-Slot ------------------------------------------------------
   * Ohne `visualSwap` ist der Slot einfach da — der Aufrufer entscheidet, was
   * darin steht.
   *
   * MIT `visualSwap` wird getauscht, und zwar an `scripting`, nicht an einer
   * Klasse, die JavaScript setzt: der Wechsel passiert dann im ersten Frame
   * statt nach dem Laden. Ein per Skript gesetzter Umschalter waere ein
   * sichtbarer Sprung — erst Foto, dann Demo.
   *
   * Ohne Skript bleibt es beim Foto und der Slot-Container ist weg. Damit gibt
   * es nie eine leere Flaeche neben der Schlagzeile. */
  /* `min-width: 0` ist Pflicht, nicht Feinschliff: der Wrapper ist ein
     Grid-Item, und Grid-Items haben per Default `min-width: auto`. Sie lassen
     sich also von unteilbarem Inhalt aufdruecken — und weil der Track dann
     breiter wird, wachsen ALLE Items der Spalte mit, auch der Text daneben.
     Gemessen auf platzfrei.club bei 390 px: `.hero-content` sprang von 342 auf
     389 px und ragte ueber den Viewport, die Schlagzeile wurde abgeschnitten.
     Der Slot-Inhalt selbst war unschuldig. */
  .hero-visual-wrap { min-width: 0; max-width: 100%; }

  .hero--visual-swap .hero-visual-wrap { display: none; }

  @media (scripting: enabled) {
    .hero--visual-swap .hero-visual-wrap { display: block; }
    /* `:global` ist PFLICHT, nicht Stil: mit `motion.parallax` rendert
       ParallaxImage diesen Wrapper, und er traegt dann dessen Scope-Kennung
       statt der von Hero — die gescopte Regel greift an ihm nicht. Gemessen:
       das Foto blieb im Layout und schob den visual-Slot um 486 px nach unten,
       also aus dem ersten Bildschirm heraus, den der Slot gewinnen sollte.
       Dieselbe Loesung wie bei `.hero--collage` weiter unten. */
    .hero--visual-swap :global(.hero-image-wrap) { display: none; }
  }
  .hero-img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }
  /* <Picture> (AVIF+WebP) wickelt das <img> in <picture>. display:contents macht
     den Wrapper layout-transparent → .hero-img (width:100%) füllt weiter .hero-image-wrap,
     kein CLS/Layout-Shift ggü. dem alten <Image>. */
  .hero-image-wrap picture {
    display: contents;
  }

  /* Cut-out / transparent hero motive — remove card frame, use silhouette-following
     drop-shadow instead. Opt-in via the `transparentImage` prop. */
  .hero--transparent-image .hero-image-wrap {
    border-radius: 0;
    box-shadow: none;
    background: transparent;
    overflow: visible;
  }
  .hero--transparent-image .hero-img {
    object-fit: contain;
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.35));
  }

  /* Bento-Layout (mit `images`-Array, 3 Bilder) — ein großes Hauptbild + zwei
     überlappende Inset-Cards. Ersetzt das Collage-Konzept aus v0.7.0-0.7.5,
     das im 45%-Grid-Slot visuell nicht zündete (3 gleich große Bilder ohne
     Hierarchie stecken zu eng zusammen).

     Positions-Konzept:
     - `--1` (Big Hero): Grund-Layer oben, volle Collage-Breite
     - `--2` (Medium Inset): rechts-unten, 50%, überlappt --1
     - `--3` (Small Inset): mitte-unten, 42%, überlappt --2 von links

     Scoping-Patterns (gereift über 5 Versionen):
     1. `.hero-collage :global(child)` — scoped Parent bindet die data-cid,
        :global()-Child umgeht TiltCard's eigenen Scope. Verhindert auch das
        @media-Stripping in Astros Compiler (v0.7.4-Fix).
     2. `height: auto` auf Items überschreibt TiltCard's internes `.motion-tilt
        { height: 100% }`, sodass Items Content-Höhe annehmen (v0.7.5-Fix). */
  .hero--collage :global(.hero-image-wrap) { display: none; }
  .hero--collage .container { overflow: visible; }
  .hero-collage {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: visible;
  }
  .hero-collage :global(.hero-collage-item) {
    position: absolute;
    height: auto;
  }
  /* Symmetrisches Triangle-Bento: Hero oben zentriert, zwei gleich große
     Inset-Cards unten gespiegelt (gleiche Breite, gleiche Höhe, gleicher
     Kantenabstand). Vertikale Symmetrie-Achse durch die Container-Mitte. */
  .hero-collage :global(.hero-collage-item--1) {
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 95%;
  }
  .hero-collage :global(.hero-collage-item--2) {
    bottom: 0;
    right: 0;
    width: 45%;
    z-index: 2;
  }
  .hero-collage :global(.hero-collage-item--3) {
    bottom: 0;
    left: 0;
    width: 45%;
    z-index: 2;
  }
  .hero-collage :global(.hero-collage-frame) {
    /* Anker fuer die KI-Kennzeichnung — siehe `.hero :global(.hero-image-wrap)`. */
