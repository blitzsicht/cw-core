---
/**
 * @cw/core – ImpressumBlock.astro
 *
 * Reusable §5-DDG-konforme Impressum-Section. Wird in customer-{slug}/src/pages/impressum.astro
 * innerhalb von <ContentPage> verwendet. Nimmt das siteData.legal-Objekt + email + Editorial-Flag
 * und rendert die Pflicht-Sections konditional.
 *
 * @example
 *   <ContentPage {...landingBaseProps} title="Impressum">
 *     <ImpressumBlock legal={siteData.legal} email={siteData.contact.email} hasEditorial={false} />
 *   </ContentPage>
 *
 * Customer kann zusätzliche Sections via slot oben/unten ergänzen (z.B. customer-spezifischer
 * Haftungsausschluss). Standard-Disclaimer-Block ist NICHT enthalten — gehört nicht ins
 * Impressum nach BGH-Rechtsprechung; Customer bei Bedarf separat ergänzen.
 *
 * Phase 1–4: DACH only (DE/AT/CH). Italienische D.Lgs. 70/2003-Variante kommt in Phase 5+
 * als ImpressumBlockIT.astro (siehe BS_ONBOARDING_PLAN.md ADR-005).
 *
 * Property-Naming: registerCourt/registerNumber (englisch, SSOT-Konvention aus
 * customer-site-data.ts) wird gegenüber registergericht/registerNummer (deutsch, Bestand)
 * bevorzugt. Beide Schreibweisen werden akzeptiert; bei doppelter Setzung gewinnt das
 * englische (neuere) Naming.
 */
export interface LegalProps {
  owner: string;
  form: string;
  /** Firmenname inkl. Rechtsform (z. B. "Muster GmbH", "X Y Z eGbR"). Bei Gesellschaften
   *  (GmbH/UG/AG/GbR/eGbR/…) gehört die Firma + Rechtsform ins Impressum (§ 5 DDG). Wenn gesetzt,
   *  wird `company` als erste Zeile gerendert und `owner` als reine Vertreter-Person behandelt
   *  (über `representatives`). Einzelunternehmer lassen `company` leer → `owner` ist die erste Zeile. */
  company?: string | undefined;
  street: string;
  zip: string;
  city: string;
  country: string;
  phone: string;
  ustIdNr?: string | undefined;
  /** Steuernummer des Finanzamts (optional). Nicht §5-DDG-Pflicht — nur anzeigen, wenn vom Kunden gewünscht. */
  steuernummer?: string | undefined;
  handelsregister?: string | undefined;
  rechtsform: 'einzelunternehmer' | 'ek' | 'gbr' | 'egbr' | 'ug' | 'gmbh' | 'gmbh-co-kg' | 'ag';
  register: 'none' | 'hrb' | 'hra' | 'gnr' | 'vr';
  /** Deutsche Schreibweise — Bestand. */
  registerNummer?: string | undefined;
  /** Deutsche Schreibweise — Bestand. */
  registergericht?: string | undefined;
  /** Englische SSOT-Schreibweise (customer-site-data.ts) — Vorrang bei Doppel-Setzung. */
  registerNumber?: string | undefined;
  /** Englische SSOT-Schreibweise — Vorrang bei Doppel-Setzung. */
  registerCourt?: string | undefined;
  /** Vertretungsberechtigte gemäß § 35 GmbHG (Pflicht für GmbH/UG/AG/GmbH-Co-KG). */
  representatives?: string[] | undefined;
  hasUstId: boolean;
  aufsichtspflichtig: boolean;
  aufsichtsbehoerde?: { name: string; url: string } | undefined;
  kammerMitglied: boolean;
  kammer?: { name: string; berufsbezeichnung: string; verleihungsStaat: string; berufsrechtLink: string } | undefined;
  vsbgPflichtig: boolean;
}

import { phoneToTelHref } from '../../utils/text/tel-href';

interface Props {
  legal: LegalProps;
  /** Kontakt-E-Mail-Adresse für das Impressum (§ 5 Abs. 1 Nr. 2 DDG — schnelle elektronische
   *  Kontaktaufnahme). Optional: wenn nicht gesetzt, wird kein E-Mail-Link gerendert und
   *  nur das Kontaktformular als elektronischer Kontaktweg aufgeführt. */
  email?: string;
  /** § 18 Abs. 2 MStV — bei journalistisch-redaktionellen Inhalten Pflicht. Default false. */
  hasEditorial?: boolean;
  /** V.i.S.d.P.-Name falls hasEditorial=true. Default: legal.owner. */
  editorialVertreter?: string | undefined;
  /** Optional: Kontaktformular-Pfad. Default: '/kontakt'. */
  contactFormPath?: string;
  /**
   * Abschnitt „Streitbeilegung" anzeigen (VSBG-Standard-Klausel nach § 36).
   * Default: true.
   *
   * Der Name stammt aus der Zeit, als dieser Zweig zusaetzlich die OS-Plattform
   * verlinkte; die ist seit 20.07.2025 eingestellt (blitzsicht-ops#702). Der Prop
   * heisst weiter so, weil ihn 6 Repos setzen — umbenannt wuerde er dort still
   * auf den Default zurueckfallen und die VSBG-Klausel wieder einblenden.
   */
  osPlatformDisclaimer?: boolean;
  /** Urheberrecht-Standard-Block am Ende anzeigen. Default: true. */
  copyrightBlock?: boolean;
  /** Hat die Site ein Kontaktformular? Default true (backward-compat).
   *  Bei false wird die §5 Abs.1 Nr.2 DDG-Klausel über das Kontaktformular nicht gerendert
   *  und der Formular-Link entfällt aus dem Kontakt-Block. Nur Telefon (+ ggf. E-Mail)
   *  werden als elektronische Kontaktwege ausgewiesen. */
  hasContactForm?: boolean;
}

const {
  legal: l,
  email,
  hasEditorial = false,
  editorialVertreter,
  contactFormPath = '/kontakt',
  osPlatformDisclaimer = true,
  copyrightBlock = true,
  hasContactForm = true,
} = Astro.props;

// Property-Naming-Auflösung: englisch (SSOT) hat Vorrang vor deutsch (Bestand).
const regCourt = l.registerCourt ?? l.registergericht;
const regNumber = l.registerNumber ?? l.registerNummer;

const showRegister = l.register !== 'none' && !!regNumber;
const registerLabel: Record<LegalProps['register'], string> = {
  none: '',
  hrb: 'Handelsregister B',
  hra: 'Handelsregister A',
  gnr: 'Gesellschaftsregister',
  vr: 'Vereinsregister',
};

// Vertretungsberechtigte: Pflicht bei juristischen Personen (§ 35 GmbHG) UND bei (e)GbR —
// dort sind die Gesellschafter gemeinsam vertretungsberechtigt und müssen genannt werden.
const showRepresentatives =
  l.representatives &&
  l.representatives.length > 0 &&
  (['gbr', 'egbr', 'gmbh', 'ug', 'ag', 'gmbh-co-kg'] as const).includes(
    l.rechtsform as 'gbr' | 'egbr' | 'gmbh' | 'ug' | 'ag' | 'gmbh-co-kg');
---

<div class="impressum-block">
  <h2>Angaben gemäß § 5 DDG</h2>
  <p>
    {l.company ? <>{l.company}<br /></> : <>{l.owner}<br /></>}
    {l.street}<br />
    {l.zip} {l.city}{l.country !== 'DE' ? <>, {l.country}</> : null}
  </p>

  {showRepresentatives && (
    <>
      <h2>Vertretungsberechtigt</h2>
      <p>{l.representatives!.join(', ')}</p>
    </>
  )}

  <h2>Kontakt</h2>
  <p>
    Telefon: <a href={`tel:${phoneToTelHref(l.phone)}`}>{l.phone}</a><br />
    {email && <>E-Mail: <a href={`mailto:${email}`}>{email}</a><br /></>}
    {hasContactForm && <>Kontaktformular: <a href={contactFormPath}>{contactFormPath}</a></>}
  </p>
  {hasContactForm ? (
    <p>
      <small>
        Schnelle elektronische Kontaktaufnahme nach § 5 Abs. 1 Nr. 2 DDG erfolgt über das Kontaktformular
        {email && <>oder direkt per E-Mail</>}.
      </small>
    </p>
  ) : email ? (
    <p>
      <small>
        Schnelle elektronische Kontaktaufnahme nach § 5 Abs. 1 Nr. 2 DDG erfolgt per E-Mail.
      </small>
    </p>
  ) : (
    <p>
      <small>
        Schnelle elektronische Kontaktaufnahme nach § 5 Abs. 1 Nr. 2 DDG erfolgt telefonisch.
      </small>
    </p>
  )}

  {showRegister && (
    <>
      <h2>Registereintrag</h2>
      <p>
        Eintragung im {registerLabel[l.register]}<br />
        Registernummer: {regNumber}
        {regCourt ? <><br />Registergericht: {regCourt}</> : null}
      </p>
    </>
  )}

  {!showRegister && l.handelsregister && (
    <>
      <h2>Registereintrag</h2>
      <p>{l.handelsregister}</p>
    </>
  )}

  {l.hasUstId && l.ustIdNr && (
    <>
      <h2>Umsatzsteuer-Identifikationsnummer</h2>
      <p>USt-IdNr. gemäß § 27 a UStG: {l.ustIdNr}</p>
    </>
  )}

  {l.steuernummer && (
    <>
      <h2>Steuernummer</h2>
      <p>Steuernummer: {l.steuernummer}</p>
    </>
  )}

  {l.aufsichtspflichtig && l.aufsichtsbehoerde && (
    <>
      <h2>Aufsichtsbehörde</h2>
      <p>
        {l.aufsichtsbehoerde.name}<br />
        <a href={l.aufsichtsbehoerde.url} target="_blank" rel="noopener">{l.aufsichtsbehoerde.url}</a>
      </p>
    </>
  )}

  {l.kammerMitglied && l.kammer && (
    <>
      <h2>Berufsbezeichnung und berufsrechtliche Regelungen</h2>
      <p>
        Berufsbezeichnung: {l.kammer.berufsbezeichnung}<br />
        Verliehen in: {l.kammer.verleihungsStaat}<br />
        Zuständige Kammer: {l.kammer.name}
      </p>
      <p>
        Berufsrechtliche Regelungen:
        <a href={l.kammer.berufsrechtLink} target="_blank" rel="noopener">{l.kammer.berufsrechtLink}</a>
      </p>
    </>
  )}

  {l.kammerMitglied && !l.kammer && (
    <>
      <h2>Berufsbezeichnung und berufsrechtliche Regelungen</h2>
      <p>Mitglied der zuständigen Handwerks- bzw. Berufskammer (Details auf Anfrage).</p>
    </>
  )}

  {hasEditorial && (
    <>
      <h2>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
      <p>
        {editorialVertreter ?? l.owner}<br />
        {l.street}<br />
        {l.zip} {l.city}
      </p>
    </>
  )}

  {/*
    * KEIN Verweis auf die OS-Plattform mehr — sie existiert nicht mehr.
    *
    * Die EU-Plattform zur Online-Streitbeilegung wurde am 20.07.2025 durch
    * VO (EU) 2024/3228 eingestellt. `https://ec.europa.eu/consumers/odr/` liefert
    * weiterhin HTTP 200 und leitet auf `consumer-redress.ec.europa.eu/site-relocation_en`
    * mit dem Satz „The Online dispute resolution (ODR) platform is now closed"
    * (direkt nachgeprueft am 19.08.2026, blitzsicht-ops#702).
    *
    * Kein toter Link im technischen Sinn, und genau deshalb faellt er niemandem auf:
    * eine Rechtsangabe, die nicht mehr stimmt. Gemessen trugen ihn 11 von 14 Impressen
    * der Flotte.
    *
    * 🔴 DER ZWEITE SATZ BLEIBT. Dieser Zweig traegt ZWEI Aussagen, und nur eine ist
    * hinfaellig: Die Erklaerung nach § 36 VSBG („nicht bereit oder verpflichtet") ist
    * davon unberuehrt. Sie beim Entfernen des Links mitzuloeschen ist der naheliegende
    * Fehler — der Prop-Name legt nahe, hier ginge es nur um die OS-Plattform.
    *
    * Wortlaut nicht neu erfunden: customer-hausamlago fuehrt ihn seit 25.05.2026,
    * customer-schiller-gartenbau ebenso. `tests/blocks/impressum-os-plattform.test.js`
    * haelt beides fest.
    */}
  {osPlatformDisclaimer && (
    <>
      <h2>Streitbeilegung</h2>
      <p>
        Die EU-Online-Streitbeilegungs-Plattform wurde am 20.07.2025 eingestellt.
        Wir sind nicht bereit oder verpflichtet, an Streitbeilegungsverfahren vor einer
        Verbraucherschlichtungsstelle teilzunehmen.
      </p>
    </>
  )}

  {l.vsbgPflichtig && (
    <>
      <h2>Verbraucherstreitbeilegung / Universalschlichtungsstelle</h2>
      <p>
        Wir sind verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle
        teilzunehmen.
      </p>
    </>
  )}

  {copyrightBlock && (
    <>
      <h2>Urheberrecht</h2>
      <p>
        Die durch den Seitenbetreiber erstellten Inhalte und Werke auf diesen Seiten unterliegen
        dem deutschen Urheberrecht. Die Vervielfältigung, Bearbeitung, Verbreitung und jede Art
        der Verwertung außerhalb der Grenzen des Urheberrechtes bedürfen der schriftlichen
        Zustimmung des jeweiligen Autors bzw. Erstellers.
      </p>
    </>
  )}

  <slot name="extra" />
</div>

<style>
  .impressum-block :global(h2) {
    margin: 2rem 0 0.75rem;
    color: var(--color-primary);
    font-size: 1.25rem;
  }
  .impressum-block :global(p) {
    margin-bottom: 1rem;
    line-height: 1.75;
  }
  .impressum-block :global(a) {
    color: var(--color-accent-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .impressum-block :global(small) {
    color: var(--color-muted, #6b7280);
    font-size: 0.875rem;
  }
</style>
