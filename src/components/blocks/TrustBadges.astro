---
/**
 * TrustBadges — certifications / trust signals.
 *
 * Generic, prop-driven. Two layouts cover the patterns seen across customer sites:
 *   • variant 'cards' (default) — bordered badge cards (label + description),
 *     optional banner image above (e.g. a certificate collage). [gottl "trust"]
 *   • variant 'bar' — compact inline credential strip. [the recurring "trust-bar"]
 *   • variant 'logo' (opt-in, v0.171.0) — ruhige Reihe ohne Kartenrahmen: Logo oben,
 *     darunter Label und Beschreibung, getrennt durch feine Linien. Fuer Partner- und
 *     Herstellerstatus mit offiziellem Logo (Anlass haarwerk: Hairdreams SILVER-Salon).
 *
 * `badges[].logoSrc` (opt-in, v0.171.0) zeigt in jeder Variante ein Logo am Badge.
 *
 * Every field except a badge `label` is optional.
 *
 * @example
 *   <TrustBadges
 *     heading="Zertifizierungen und Mitgliedschaften"
 *     bannerSrc="/images/zertifikate-banner.webp" bannerAlt="…"
 *     badges={[{ label: 'RICS', description: 'Royal Institution of Chartered Surveyors' }]}
 *   />
 *   <TrustBadges variant="bar" badges={[{ label: '30 Jahre Erfahrung' }, { label: 'ö.b.u.v.' }]} />
 */
export interface TrustBadge {
  /** Short label, e.g. "RICS". Required. */
  label: string;
  /** Optional explanatory line (shown in 'cards' and 'logo' variant). */
  description?: string;
  /**
   * Logo als public-Pfad (z. B. `/logos/hairdreams-silver.svg`), opt-in seit v0.171.0.
   * Nur offizielle Dateien des Rechteinhabers — kein Nachzeichnen, keine KI-Neuerstellung.
   */
  logoSrc?: string;
  /** Alt-Text des Logos. Ohne Angabe leer, weil das Label daneben dasselbe sagt. */
  logoAlt?: string;
}

interface Props {
  /** Optional section heading. */
  heading?: string;
  /** Optional banner image above the badges (e.g. certificate collage). */
  bannerSrc?: string;
  bannerAlt?: string;
  /** Badges. Section is omitted entirely if empty. */
  badges?: readonly TrustBadge[];
  /** Layout. 'cards' = bordered cards (default), 'bar' = compact inline strip, 'logo' = Logo-Reihe (v0.171.0). */
  variant?: 'cards' | 'bar' | 'logo';
  /** Background variant. Default 'default'. */
  background?: 'surface' | 'default';
}

const {
  heading,
  bannerSrc,
  bannerAlt = '',
  badges = [],
  variant = 'cards',
  background = 'default',
} = Astro.props;
---
{badges.length > 0 && (
<section class:list={['trust-badges-section', `is-${variant}`, background === 'surface' && 'is-surface']}>
  <div class="container">
    {heading && <h2 class="trust-badges-heading">{heading}</h2>}

    {bannerSrc && (
      <div class="trust-banner">
        <img src={bannerSrc} alt={bannerAlt} width="1200" height="225" loading="lazy" />
      </div>
    )}

    <div class:list={['trust-badges', variant === 'bar' ? 'badge-bar' : variant === 'logo' ? 'badge-logos' : 'badge-row']}>
      {badges.map((b) => (
        <div class="badge">
          {b.logoSrc && <img class="badge-logo" src={b.logoSrc} alt={b.logoAlt ?? ''} loading="lazy" decoding="async" />}
          <strong>{b.label}</strong>
          {variant !== 'bar' && b.description && <span>{b.description}</span>}
        </div>
      ))}
    </div>
  </div>
</section>
)}

<style>
  .trust-badges-section { padding: var(--section-padding, 4rem) 0; background: #fff; }
  .trust-badges-section.is-surface { background: var(--color-surface, #f8fafc); }
  .container { max-width: var(--container-max, 72rem); margin: 0 auto; padding: 0 1.5rem; }
  .trust-badges-heading {
    text-align: center;
    font-family: var(--font-heading, inherit);
    color: var(--color-primary);
    font-size: 2rem;
    margin: 0 0 1.5rem;
  }
  .trust-banner { max-width: 48rem; margin: 0 auto 2.5rem; text-align: center; }
  .trust-banner img { width: 100%; max-width: 48rem; border-radius: 0.5rem; }

  /* variant 'cards' */
  .badge-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1.5rem;
  }
  .badge-row .badge {
    text-align: center;
    padding: 1.5rem;
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    background: var(--color-surface, #f8fafc);
  }
  .is-surface .badge-row .badge { background: #fff; }
  .badge-row .badge strong { display: block; color: var(--color-primary); font-size: 1.25rem; margin-bottom: 0.5rem; }
  .badge-row .badge span { color: var(--color-muted, #4b5563); font-size: 0.875rem; }

  /* variant 'bar' */
  .badge-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1.5rem;
  }
  .badge-bar .badge strong {
    display: inline-block;
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.9375rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid #e5e7eb;
    border-radius: 999px;
    background: var(--color-surface, #f8fafc);
  }
  .is-surface .badge-bar .badge strong { background: #fff; }
  /* Nur mit Logo: ohne Logo bleibt die Leiste exakt wie vor v0.171.0. */
  .badge-bar .badge:has(.badge-logo) { display: inline-flex; align-items: center; gap: 0.5rem; }
  .badge-bar .badge-logo { height: 1.5rem; width: auto; }

  /* Logo in 'cards' (opt-in per logoSrc). */
  .badge-row .badge-logo { display: block; height: 3rem; width: auto; max-width: 100%; margin: 0 auto 0.75rem; object-fit: contain; }

  /* variant 'logo' (opt-in, v0.171.0) */
  .badge-logos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 2rem 0;
  }
  .badge-logos .badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.35rem;
    padding: 0.5rem 1.75rem;
  }
  .badge-logos .badge + .badge { border-left: 1px solid color-mix(in srgb, var(--color-primary) 14%, transparent); }
  .badge-logos .badge-logo { height: 3.5rem; width: auto; max-width: 100%; object-fit: contain; margin-bottom: 0.5rem; }
  .badge-logos .badge strong {
    font-family: var(--font-heading, inherit);
    color: var(--color-primary);
    font-size: 1.125rem;
    letter-spacing: 0.01em;
  }
  .badge-logos .badge span { color: var(--color-muted, #4b5563); font-size: 0.875rem; line-height: 1.5; }
  /* stylelint-disable-next-line plugin/no-max-width-media -- Trennlinien nur nebeneinander sinnvoll */
  @media (max-width: 640px) {
    .badge-logos .badge + .badge { border-left: 0; border-top: 1px solid color-mix(in srgb, var(--color-primary) 14%, transparent); padding-top: 1.5rem; }
  }
</style>
