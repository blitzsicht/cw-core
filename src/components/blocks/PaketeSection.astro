---
/**
 * @cw/core – PaketeSection.astro
 *
 * Pricing/packages section. Prop-driven: no `@/data/site-data` import.
 *
 * Layout pattern (from Blitzsicht-Audit):
 * - 3-column grid; middle card with shadow-xl + negative margin
 * - Badge absolutely positioned as pill above the card
 * - Inline SVG checkmarks (no icon library import)
 * - CTA as pill (border-radius: 100px)
 * - Price display: 2.25rem bold
 *
 * @example
 *   <PaketeSection items={siteData.packages} tilt={true} />
 */
import TiltCard from '../motion/TiltCard.astro';

/**
 * Feature-Variant für gestaffelte Paket-Differenzierung (v0.12).
 *
 * - `included`: ✓ — Feature ist im Paket enthalten
 * - `excluded`: — — Feature ist nicht enthalten (graues Em-Dash, kein roter Strike)
 * - `addon`: ✓ +Preis — Feature ist als monatlicher Add-On verfügbar (z.B. Cal-Booking auf Starter)
 */
export interface PaketeFeature {
  /** Label, kann HTML enthalten (vorsichtig — wird via set:html gerendert). */
  label: string;
  /** Anzeige-Variante. */
  variant: 'included' | 'excluded' | 'addon';
  /** Optionaler Tooltip (Hover/Tap-Erklärung). */
  tooltip?: string;
  /** Add-On-Preis-Label, z.B. "+29 €/Mo". Nur bei variant='addon'. */
  addonPrice?: string;
}

export interface PaketeItem {
  /** Package name (large heading). */
  name: string;
  /** Subtitle / eyebrow. */
  subtitle: string;
  /** One-time setup price (number, formatted with de-DE locale). */
  priceSetup: number;
  /** Monthly recurring price (number). */
  priceMonthly: number;
  /** Optional pages/scope hint (rendered as small pill). */
  pages?: string;
  /**
   * Bullet feature list (Legacy/Simple-Modus).
   *
   * Wenn `detailedFeatures` gesetzt ist, wird `features` ignoriert.
   */
  features: readonly string[];
  /**
   * Detaillierte Feature-Matrix mit Variants (v0.12, optional).
   *
   * Wenn gesetzt, ersetzt `features` und ermöglicht ✓/—/✓+Preis-Differenzierung
   * pro Item. Plan-Phase 2 Pricing-Refresh.
   */
  detailedFeatures?: readonly PaketeFeature[];
  /** If true, the card is highlighted (accent border, shadow, "Meistgewählt" badge). */
  highlighted?: boolean;
  /** CTA href; defaults to `/kontakt`. */
  ctaHref?: string;
  /** CTA label; defaults to `${name} anfragen`. */
  ctaLabel?: string;
  /**
   * Optional sekundärer CTA innerhalb der Karte — z.B. "Alle Leistungen ansehen →".
   * Rendert unter dem primären CTA als text-only Link mit Pfeil.
   * v0.14.2+ (Plan-Phase 9).
   */
  ctaSecondaryHref?: string;
  /** Label für sekundären CTA. Default: 'Alle Leistungen ansehen →' wenn ctaSecondaryHref gesetzt. */
  ctaSecondaryLabel?: string;
}

interface Props {
  /** Package cards. */
  items?: readonly PaketeItem[];
  /** Whether to render the section header. */
  showTitle?: boolean;
  /** Optional override for the section heading. */
  heading?: string;
  /** Optional override for the section subheading. */
  subheading?: string;
  /** Footnote rendered below the grid. */
  note?: string;
  /** Wrap each card in a `<TiltCard>` for 3D hover-tilt. Default true (opt-out with `tilt={false}`). */
  tilt?: boolean;
  /** Single-card mode: centers the card, removes highlight negative margins. Use when showing only the highlighted package on a landing page. */
  single?: boolean;
}

const {
  items = [],
  showTitle = true,
  heading = 'Transparente Preise. Keine Überraschungen.',
  subheading = 'Einmalige Einrichtung + monatliche Betreuung. Alle Preise netto zzgl. 19\u00a0% MwSt.',
  note = 'Alle Pakete: Source-Code gehört Ihnen · Hosting + Domain inklusive · DSGVO-konform ohne Cookie-Banner',
  tilt = true,
  single = false,
} = Astro.props;
---
<section class="pakete-section">
  <div class="container">
    {showTitle && (
      <div class="section-header">
        <h2 class="section-heading">{heading}</h2>
        <p class="section-subheading" set:html={subheading} />
      </div>
    )}

    <div class:list={['pakete-grid', single && 'pakete-grid--single']}>
      {items.map((pkg) => {
        const card = (
          <div class:list={['paket-card', pkg.highlighted && 'highlighted']}>
            {pkg.highlighted && <span class="highlight-badge">Meistgewählt</span>}
            <p class="paket-eyebrow">{pkg.subtitle}</p>
            <h3 class="paket-name">{pkg.name}</h3>

            <div class="paket-pricing">
              {pkg.priceSetup > 0 ? (
                <>
                  <span class="price-amount">{pkg.priceSetup.toLocaleString('de-DE')}&thinsp;€</span>
                  <span class="price-label">einmalig</span>
                </>
              ) : (
                <span class="price-amount price-anfrage">Auf Anfrage</span>
              )}
            </div>
            {pkg.priceMonthly > 0 && (
              <div class="paket-pricing-monthly">
                <span>danach</span>
                <strong>{pkg.priceMonthly}&thinsp;€</strong>
                <span>/ Monat</span>
              </div>
            )}

            {pkg.pages && <p class="paket-pages">{pkg.pages}</p>}

            {pkg.detailedFeatures && pkg.detailedFeatures.length > 0 ? (
              <ul class="feature-list feature-list--detailed">
                {pkg.detailedFeatures.map((f) => (
                  <li class:list={['feature-row', `feature-row--${f.variant}`]} title={f.tooltip}>
                    {f.variant === 'included' && (
                      <svg class="check-icon" width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 111.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                      </svg>
                    )}
                    {f.variant === 'excluded' && (
                      <span class="dash-icon" aria-hidden="true">—</span>
                    )}
                    {f.variant === 'addon' && (
                      <svg class="plus-icon" width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"/>
                      </svg>
                    )}
                    <span class="feature-label" set:html={f.label} />
                    {f.variant === 'addon' && f.addonPrice && (
                      <span class="addon-price-badge">{f.addonPrice}</span>
                    )}
                    {f.tooltip && <span class="feature-info" aria-hidden="true">ⓘ</span>}
                  </li>
                ))}
              </ul>
            ) : (
              <ul class="feature-list">
                {pkg.features.map((f) => (
                  <li>
                    <svg class="check-icon" width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 111.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                    {f}
                  </li>
                ))}
              </ul>
            )}

            <a
              href={pkg.ctaHref ?? '/kontakt'}
              class:list={['paket-cta', pkg.highlighted ? 'cta-primary' : 'cta-outline']}
            >
              {pkg.ctaLabel ?? `${pkg.name} anfragen`}
            </a>
            {pkg.ctaSecondaryHref && (
              <a
                href={pkg.ctaSecondaryHref}
                class="paket-cta-secondary"
                data-paket-secondary={pkg.name}
              >
                {pkg.ctaSecondaryLabel ?? 'Alle Leistungen ansehen →'}
              </a>
            )}
          </div>
        );
        return tilt ? <TiltCard>{card}</TiltCard> : card;
      })}
    </div>

    {note && <p class="pakete-note">{note}</p>}
  </div>
</section>

<script>
  import { track } from '../../utils/analytics/track';
  document.querySelectorAll<HTMLAnchorElement>('.paket-cta').forEach((link) => {
    link.addEventListener('click', () => {
      const name = link.closest('.paket-card')?.querySelector('.paket-name')?.textContent?.trim() ?? '';
      track('Package Click', { package_name: name });
    });
  });
  // v0.14.2 — Sekundärer CTA Tracking (Plan-Phase 9 Plausible-Events)
  document.querySelectorAll<HTMLAnchorElement>('.paket-cta-secondary').forEach((link) => {
    link.addEventListener('click', () => {
      const name = link.dataset.paketSecondary ?? '';
      track('Paket Card Detail-Link Click', { tier: name.toLowerCase() });
    });
  });
</script>

<style>
  .pakete-section { padding: 5rem 0; background: var(--color-surface); }
  .section-header { text-align: center; margin-bottom: 3.5rem; }

  .pakete-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: start;
    max-width: 72rem;
    margin-inline: auto;
  }
  .paket-card {
    position: relative;
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 1rem;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .paket-card.highlighted {
    border-color: var(--color-accent);
    box-shadow: 0 20px 48px -12px rgba(0, 0, 0, 0.15);
    margin-top: -1rem;
    margin-bottom: -1rem;
    padding: 2.5rem 2rem;
    z-index: 1;
  }
  .highlight-badge {
    position: absolute;
    top: -0.75rem;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-primary);
    color: white;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.25rem 1rem;
    border-radius: 100px;
    white-space: nowrap;
  }
  .paket-eyebrow {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    margin: 0 0 0.5rem;
  }
  .paket-name { font-size: 1.75rem; font-weight: 700; margin: 0 0 1rem; }
  .paket-pricing {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
    margin-bottom: 0.25rem;
  }
  .price-amount { font-size: 2.25rem; font-weight: 700; color: var(--color-primary); line-height: 1; }
  .price-anfrage { font-size: 1.5rem; }
  .price-label { font-size: 0.875rem; color: var(--color-muted); }
  .paket-pricing-monthly {
    font-size: 0.875rem;
    color: var(--color-muted);
    margin-bottom: 1rem;
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
  }
  .paket-pricing-monthly strong { color: var(--color-primary); font-size: 1rem; }
  .paket-pages {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    background: var(--color-surface);
    padding: 0.25rem 0.75rem;
    border-radius: 100px;
    color: var(--color-primary);
    margin: 0 0 1.5rem;
    align-self: flex-start;
  }
  .paket-card.highlighted .paket-pages {
    background: rgba(239, 118, 18, 0.08);
    color: var(--color-accent-text, #B85A0D);
  }
  .feature-list {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }
  .feature-list li { display: flex; align-items: flex-start; gap: 0.5rem; font-size: 0.875rem; line-height: 1.5; }
  .check-icon { flex-shrink: 0; margin-top: 1px; color: var(--color-accent); }

  /* v0.12 — Detailed Features mit Variants (included/excluded/addon) */
  .feature-list--detailed .feature-row {
    align-items: center;
    gap: 0.5rem;
  }
  .feature-list--detailed .feature-label { flex: 1; }
  .feature-row--excluded { color: var(--color-muted, #9ca3af); }
  .feature-row--excluded .feature-label { opacity: 0.7; }
  .dash-icon {
    flex-shrink: 0;
    width: 20px;
    text-align: center;
    color: var(--color-muted, #9ca3af);
    font-weight: 600;
  }
  .plus-icon { flex-shrink: 0; margin-top: 1px; color: var(--color-accent); }
  .addon-price-badge {
    flex-shrink: 0;
    font-size: 0.6875rem;
    font-weight: 700;
    background: rgba(239, 118, 18, 0.1);
    color: var(--color-accent-text, #B85A0D);
    padding: 0.125rem 0.5rem;
    border-radius: 100px;
    white-space: nowrap;
  }
  .feature-info {
    cursor: help;
    color: var(--color-muted, #9ca3af);
    font-size: 0.75rem;
    margin-left: auto;
  }
  .paket-cta {
    display: block;
    text-align: center;
    padding: 0.875rem 1.5rem;
    border-radius: 100px;
    font-weight: 700;
    font-size: 0.9375rem;
    text-decoration: none;
    min-height: 48px;
    transition: background 0.2s, border-color 0.2s, transform 0.1s;
  }
  .cta-primary { background: var(--color-accent); color: var(--color-accent-btn-text, white); }
  .cta-primary:hover { background: var(--color-accent-hover); transform: translateY(-1px); }
  .cta-outline { background: transparent; color: var(--color-primary); border: 2px solid #e5e7eb; }
  .cta-outline:hover { border-color: var(--color-primary); background: var(--color-surface); }

  /* v0.14.2 — Sekundärer CTA (Plan-Phase 9): dezent unter Primary-CTA, text-only mit Pfeil */
  .paket-cta-secondary {
    display: block;
    margin-top: 0.625rem;
    text-align: center;
    padding: 0.5rem 1rem;
    color: var(--color-primary, #1D1E3B);
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 600;
    border-bottom: 1px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }
  .paket-cta-secondary:hover {
    color: var(--color-accent, #EF7612);
    border-bottom-color: var(--color-accent, #EF7612);
  }
  .pakete-note { text-align: center; margin-top: 2rem; font-size: 0.8125rem; color: var(--color-muted); }

  .pakete-grid--single {
    grid-template-columns: 1fr;
    max-width: 460px;
    margin-inline: auto;
  }
  .pakete-grid--single .paket-card.highlighted {
    margin-top: 0;
    margin-bottom: 0;
  }

  /* stylelint-disable-next-line plugin/no-max-width-media -- Legacy Desktop-First, TODO: refactor to Mobile-First */
  @media (max-width: 900px) {
    .pakete-grid { grid-template-columns: 1fr; max-width: 480px; margin-inline: auto; }
    .paket-card.highlighted { margin-top: 0; margin-bottom: 0; }
  }
</style>
