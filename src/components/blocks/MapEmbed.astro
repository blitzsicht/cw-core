---
/**
 * @cw/core – MapEmbed.astro
 *
 * Privacy-by-default OpenStreetMap-Embed (click-to-load). Es wird KEIN Request an
 * OpenStreetMap ausgelöst, bevor der Nutzer aktiv "Karte laden" klickt — damit ist die
 * Karte DSGVO-konform ohne Consent-Banner einbettbar (kein Drittanbieter-Call beim Seitenaufruf).
 *
 * Erster OSM-Embed im cw-core-Cluster. Voll prop-driven, keine Customer-Daten-Imports.
 *
 * CSP-Voraussetzung beim Customer (vercel.json): `frame-src https://www.openstreetmap.org`.
 * (Die Karten-Kacheln lädt das OSM-iframe-Dokument selbst — sie unterliegen NICHT der
 *  Customer-CSP, daher genügt frame-src.)
 *
 * @example
 *   <MapEmbed
 *     lat={49.0123} lng={11.9876} zoom={15}
 *     heading="So findest du uns"
 *     markerLabel="Braustall Deuerling"
 *     address="Regensburger Str. 33, 93180 Deuerling"
 *   />
 */
interface Props {
  /** Breitengrad des Markers. */
  lat: number;
  /** Längengrad des Markers. */
  lng: number;
  /** Zoom-Stufe (höher = näher). Default 15. */
  zoom?: number;
  /** Fett dargestellter Ort/Name im Platzhalter. */
  markerLabel?: string;
  /** Adresszeile im Platzhalter. */
  address?: string;
  /** Optionale Section-Überschrift. */
  heading?: string;
  /** Optionale Section-Unterüberschrift. */
  subheading?: string;
  /** Höhe der Karte (CSS-Wert). Default '420px'. */
  height?: string;
  /** Beschriftung des Lade-Buttons. */
  loadLabel?: string;
  /** Datenschutz-Hinweis unter dem Button. */
  privacyNote?: string;
}
const {
  lat,
  lng,
  zoom = 15,
  markerLabel,
  address,
  heading,
  subheading,
  height = '420px',
  loadLabel = 'Karte laden',
  privacyNote = 'Beim Laden der Karte werden Daten an OpenStreetMap übertragen.',
} = Astro.props;

// bbox grob aus der Zoom-Stufe um den Punkt ableiten.
const span = 360 / 2 ** zoom;
const spanLat = span * 0.6;
const bbox = [lng - span, lat - spanLat, lng + span, lat + spanLat]
  .map((n) => n.toFixed(5))
  .join('%2C');
const mlat = lat.toFixed(5);
const mlng = lng.toFixed(5);
const embedSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${mlat}%2C${mlng}`;
const largeSrc = `https://www.openstreetmap.org/?mlat=${mlat}&mlon=${mlng}#map=${zoom}/${mlat}/${mlng}`;
const routeSrc = `https://www.openstreetmap.org/directions?to=${mlat}%2C${mlng}`;
---

<section class="mapembed-section">
  <div class="container">
    {heading && <h2 class="section-heading">{heading}</h2>}
    {subheading && <p class="section-subheading">{subheading}</p>}

    <figure class="map-embed" data-embed-src={embedSrc} style={`--map-h:${height}`}>
      <div class="map-placeholder">
        <div class="map-pin" aria-hidden="true">📍</div>
        {markerLabel && <p class="map-label">{markerLabel}</p>}
        {address && <p class="map-addr">{address}</p>}
        <button type="button" class="btn-accent map-load" data-cta="map:load">{loadLabel}</button>
        <p class="map-privacy">{privacyNote}</p>
      </div>
    </figure>

    <p class="map-links">
      <a href={largeSrc} target="_blank" rel="noopener noreferrer">Größere Karte öffnen</a>
      <span aria-hidden="true">·</span>
      <a href={routeSrc} target="_blank" rel="noopener noreferrer">Route planen</a>
    </p>
  </div>
</section>

<style>
  .mapembed-section { padding: var(--section-padding, 5rem) 0; }
  .map-embed {
    position: relative;
    margin: 1.5rem 0 0.75rem;
    border-radius: 14px;
    overflow: hidden;
    height: var(--map-h, 420px);
    background: var(--color-surface, #f4f4f4);
    border: 1px solid color-mix(in srgb, var(--color-muted, #888) 35%, transparent);
  }
  .map-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    text-align: center;
    padding: 1.5rem;
    background-image: radial-gradient(color-mix(in srgb, var(--color-muted, #888) 16%, transparent) 1px, transparent 1px);
    background-size: 22px 22px;
  }
  .map-pin { font-size: 2.4rem; line-height: 1; }
  .map-label { font-weight: 700; color: var(--color-primary); margin: 0; }
  .map-addr { color: var(--color-muted); margin: 0; }
  .map-privacy { font-size: 0.8rem; color: var(--color-muted); margin: 0.4rem 0 0; max-width: 34ch; }
  .map-embed :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .map-links { display: flex; gap: 0.6rem; justify-content: center; font-size: 0.95rem; margin-top: 0.5rem; }
  .map-links a { color: var(--color-accent-text, var(--color-accent)); font-weight: 600; text-decoration: none; }
  .map-links a:hover { text-decoration: underline; }
</style>

<script>
  document.querySelectorAll('.map-embed').forEach((el) => {
    const btn = el.querySelector('.map-load');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const src = el.getAttribute('data-embed-src');
      if (!src) return;
      const iframe = document.createElement('iframe');
      iframe.setAttribute('src', src);
      iframe.setAttribute('title', 'Karte (OpenStreetMap)');
      iframe.setAttribute('loading', 'lazy');
      iframe.setAttribute('referrerpolicy', 'no-referrer');
      el.replaceChildren(iframe);
      const w = window as unknown as { plausible?: (e: string) => void };
      if (typeof w.plausible === 'function') w.plausible('Map Load');
    });
  });
</script>
