---
/**
 * StickyContact — schwebender WhatsApp + Telefon Button (fixed, bottom-right).
 *
 * Mobile-first: maximiert Conversions im Smartphone-Traffic, der bei
 * lokalen Handwerks- und Dienstleistungs-Sites typisch 60-75% beträgt.
 * Tap auf WhatsApp öffnet wa.me-Link, Tap auf Phone löst tel:-Call aus.
 *
 * Plausible-Events: 'Sticky Contact Click' mit Prop channel='sticky-wa'|'sticky-phone'.
 *
 * Zugänglichkeit: role="complementary" + aria-label, focus-visible outline,
 * prefers-reduced-motion respektiert (kein Puls-Effekt).
 *
 * @example
 *   <StickyContact
 *     whatsapp="+49151xxxxxxxx"
 *     phone="+498xxxxxxxxxxx"
 *     prefilledMessage="Hallo, ich interessiere mich für Ihr Angebot."
 *   />
 *
 * @example Nur WhatsApp, kein Phone-Button
 *   <StickyContact whatsapp="+49151xxxxxxxx" />
 *
 * @example Custom PrefilledMessage per Customer
 *   <StickyContact
 *     whatsapp="+4915156083331"
 *     phone="+4994029380193"
 *     prefilledMessage="Hallo Soleno, ich interessiere mich für eine PV-Beratung."
 *   />
 */

interface Props {
  /** WhatsApp-Nummer inkl. Ländervorwahl, z.B. "+49151xxxxxxxx". */
  whatsapp?: string;
  /** Telefonnummer inkl. Ländervorwahl, z.B. "+498xxxxxxxxxxx". */
  phone?: string;
  /**
   * Vorbefüllte WhatsApp-Nachricht.
   * Default ist generisch und sollte pro Customer mit einer spezifischen
   * Ansprache überschrieben werden (z.B. "Hallo Soleno, ich interessiere
   * mich für eine PV-Beratung.").
   */
  prefilledMessage?: string;
}

const {
  whatsapp,
  phone,
  prefilledMessage = 'Hallo, ich interessiere mich für Ihr Angebot.',
} = Astro.props;

const waNumber = whatsapp?.replace(/\D/g, '');
const waLink = waNumber
  ? `https://wa.me/${waNumber}?text=${encodeURIComponent(prefilledMessage)}`
  : null;
const telLink = phone ? `tel:${phone.replace(/\s/g, '')}` : null;
---
{(waLink || telLink) && (
  <div class="sticky-contact" role="complementary" aria-label="Schnellkontakt">
    {waLink && (
      <a
        href={waLink}
        class="sticky-btn sticky-btn--wa"
        aria-label="Per WhatsApp anfragen"
        target="_blank"
        rel="noopener"
        data-track="sticky-wa"
      >
        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.464 3.488"/>
        </svg>
      </a>
    )}
    {telLink && (
      <a
        href={telLink}
        class="sticky-btn sticky-btn--phone"
        aria-label="Anrufen"
        data-track="sticky-phone"
      >
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
        </svg>
      </a>
    )}
  </div>
)}

<script>
  // Plausible-friendly click tracking
  document.querySelectorAll<HTMLAnchorElement>('.sticky-btn').forEach((el) => {
    el.addEventListener('click', () => {
      const channel = el.getAttribute('data-track');
      if (typeof (window as any).plausible === 'function') {
        (window as any).plausible('Sticky Contact Click', { props: { channel } });
      }
    });
  });
</script>

<style>
  .sticky-contact {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 50;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    pointer-events: none;
  }
  .sticky-btn {
    pointer-events: auto;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    text-decoration: none;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18), 0 2px 6px rgba(0, 0, 0, 0.12);
    transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
  }
  .sticky-btn:hover,
  .sticky-btn:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.22), 0 3px 8px rgba(0, 0, 0, 0.14);
  }
  .sticky-btn:focus-visible {
    outline: 3px solid var(--color-accent, #fbbf24);
    outline-offset: 3px;
  }
  .sticky-btn--wa {
    background: #25D366;
  }
  .sticky-btn--wa:hover { background: #1ebd5a; }
  .sticky-btn--phone {
    background: var(--color-primary, #1f2937);
  }
  .sticky-btn--phone:hover { filter: brightness(1.1); }

  /* Pulse dezent damit der WA-Button auffällt ohne zu nerven */
  .sticky-btn--wa::after {
    content: '';
    position: absolute;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #25D366;
    opacity: 0.45;
    z-index: -1;
    animation: sticky-pulse 2.6s ease-out infinite;
  }
  @keyframes sticky-pulse {
    0%   { transform: scale(1);    opacity: 0.45; }
    70%  { transform: scale(1.6);  opacity: 0; }
    100% { transform: scale(1.6);  opacity: 0; }
  }

  /* stylelint-disable-next-line plugin/no-max-width-media -- Legacy Desktop-First, refactor tracked in siluri/blitzsicht-ops#184 */
  @media (max-width: 480px) {
    .sticky-contact {
      right: 0.75rem;
      bottom: 0.75rem;
      gap: 0.5rem;
    }
    .sticky-btn {
      width: 52px;
      height: 52px;
    }
    .sticky-btn--wa::after {
      width: 52px;
      height: 52px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sticky-btn--wa::after { animation: none; }
    .sticky-btn { transition: none; }
  }
</style>
