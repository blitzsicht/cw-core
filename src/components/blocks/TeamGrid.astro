---
/**
 * TeamGrid — grid of team members / persons.
 *
 * Generic, prop-driven. Covers the variations seen across customer sites:
 *   • photo avatar (when `image` set) OR initials avatar (derived from `name`)
 *   • optional role/title, credentials list, profile link, contact (email/phone)
 *   • optional CTA below the grid (e.g. "Gesamtes Team ansehen")
 *   • alternating `background` ('surface' | 'default')
 *
 * No customer-specific assumptions — every field except `name` is optional.
 *
 * @example
 *   <TeamGrid
 *     heading="Ihre Sachverständigen"
 *     subheading="Drei erfahrene Gutachter mit internationaler Zertifizierung."
 *     members={siteData.team.map((m) => ({
 *       name: m.name, role: m.title, credentials: m.credentials,
 *     }))}
 *     ctaLabel="Gesamtes Team ansehen" ctaHref="/team"
 *     background="surface"
 *   />
 */
export interface TeamMember {
  /** Full name. Required (used for the initials avatar fallback). */
  name: string;
  /** Job title / role. */
  role?: string;
  /** Credentials/qualifications (e.g. ["RICS", "HypZert"]). */
  credentials?: readonly string[];
  /** Photo URL/path. If omitted, an initials avatar is rendered. */
  image?: string;
  /** Link to the person's profile page (e.g. `/team/<slug>`). */
  profileUrl?: string;
  /** Optional contact. */
  email?: string;
  phone?: string;
}

import AiLabelAmBild from './AiLabelAmBild.astro';
import { bildLabel } from '../../utils/bildlabel.js';

interface Props {
  /** Section heading. */
  heading?: string;
  /** Optional intro under the heading. */
  subheading?: string;
  /** Team members. Section is omitted entirely if empty. */
  members?: readonly TeamMember[];
  /** Max credentials shown per member (rest truncated). Default 3. */
  maxCredentials?: number;
  /** Optional CTA below the grid. */
  ctaLabel?: string;
  ctaHref?: string;
  /** Background variant. Default 'default'. */
  background?: 'surface' | 'default';
  /**
   * `siteData.bildHerkunft`. Teamfotos sind der haeufigste Fall einer Pflicht nach
   * Art. 50 Abs. 4 UAbs. 1 AI Act: ein fotorealistischer Mensch, den es nicht gibt, ist ein
   * Deepfake im Sinne von Art. 3 Nr. 60. Das Badge steht unter dem Bild — auf einem 96-px-
   * Avatar verdeckte es sonst das Gesicht.
   *
   * Ohne diese Prop aendert sich am gerenderten Ausgang nichts.
   */
  bildHerkunft?: unknown[];
}

const {
  heading,
  subheading,
  members = [],
  maxCredentials = 3,
  ctaLabel,
  ctaHref,
  background = 'default',
  bildHerkunft,
} = Astro.props;

const mitgliedLabel = await Promise.all(
  members.map((m) => (m.image ? bildLabel({ bildHerkunft }, m.image) : null)),
);

const initials = (name: string): string =>
  name
    .split(/\s+/)
    .map((w) => w[0] ?? '')
    .join('')
    .slice(0, 3)
    .toUpperCase();
---
{members.length > 0 && (
<section class:list={['team-grid-section', background === 'surface' && 'is-surface']}>
  <div class="container">
    {heading && <h2 class="team-grid-heading">{heading}</h2>}
    {subheading && <p class="team-grid-intro">{subheading}</p>}

    <div class="team-grid">
      {members.map((m, idx) => (
        <div class="team-card">
          {m.image ? (
            <Fragment>
              <img class="team-avatar team-avatar-photo" src={m.image} alt={m.name} loading="lazy" width="96" height="96" />
              {mitgliedLabel[idx] && <AiLabelAmBild ergebnis={mitgliedLabel[idx]!.ergebnis} theme="hell" platzierung="unter-bild" groesse="18px" />}
            </Fragment>
          ) : (
            <div class="team-avatar" aria-hidden="true">{initials(m.name)}</div>
          )}
          <h3>{m.profileUrl ? <a href={m.profileUrl}>{m.name}</a> : m.name}</h3>
          {m.role && <p class="team-role">{m.role}</p>}
          {m.credentials && m.credentials.length > 0 && (
            <p class="team-creds">{m.credentials.slice(0, maxCredentials).join(' | ')}</p>
          )}
          {(m.email || m.phone) && (
            <p class="team-contact">
              {m.email && <a href={`mailto:${m.email}`}>{m.email}</a>}
              {m.phone && <a href={`tel:${m.phone.replace(/[^+\d]/g, '')}`}>{m.phone}</a>}
            </p>
          )}
        </div>
      ))}
    </div>

    {ctaLabel && ctaHref && (
      <div class="team-grid-cta">
        <a href={ctaHref} class="team-grid-cta-link">{ctaLabel}</a>
      </div>
    )}
  </div>
</section>
)}

<style>
  .team-grid-section { padding: var(--section-padding, 4rem) 0; background: #fff; }
  .team-grid-section.is-surface { background: var(--color-surface, #f8fafc); }
  .container { max-width: var(--container-max, 72rem); margin: 0 auto; padding: 0 1.5rem; }
  .team-grid-heading {
    text-align: center;
    font-family: var(--font-heading, inherit);
    color: var(--color-primary);
    font-size: 2rem;
    margin: 0 0 0.75rem;
  }
  .team-grid-intro {
    text-align: center;
    color: var(--color-muted, #4b5563);
    max-width: 36rem;
    margin: 0 auto 2.5rem;
    font-size: 1.0625rem;
  }
  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.5rem;
  }
  .team-card {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    padding: 2rem;
    text-align: center;
  }
  .is-surface .team-card { background: #fff; }
  .team-avatar {
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: var(--color-primary);
    color: #fff;
    font-weight: 700;
    font-size: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1rem;
    object-fit: cover;
  }
  .team-card h3 { color: var(--color-primary); font-size: 1.125rem; margin: 0 0 0.25rem; }
  .team-card h3 a { color: inherit; text-decoration: none; }
  .team-card h3 a:hover { text-decoration: underline; }
  .team-role { color: var(--color-accent-text, var(--color-accent)); font-weight: 600; font-size: 0.9375rem; margin: 0 0 0.75rem; }
  .team-creds { color: var(--color-muted, #4b5563); font-size: 0.8125rem; margin: 0; line-height: 1.5; }
  .team-contact { margin: 0.75rem 0 0; font-size: 0.875rem; display: flex; flex-direction: column; gap: 0.25rem; }
  .team-contact a { color: var(--color-primary); }
  .team-grid-cta { text-align: center; margin-top: 2rem; }
  .team-grid-cta-link {
    display: inline-block;
    border: 2px solid var(--color-accent);
    color: var(--color-accent-text, var(--color-accent));
    padding: 0.75rem 2rem;
    border-radius: 0.375rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }
  .team-grid-cta-link:hover { background: var(--color-accent); color: #fff; }
</style>
