---
/**
 * @cw/core – CTABlock.astro
 *
 * Full-width call-to-action section with primary + secondary button.
 * Fully prop-driven; no imports from customer data modules.
 *
 * @example
 *   <CTABlock
 *     headline="Bereit für Ihre neue Website?"
 *     sub="Kostenloses Erstgespräch — 30 Minuten, unverbindlich."
 *     primaryLabel="Beratung anfragen"
 *     primaryHref="/kontakt"
 *     secondaryLabel="Pakete & Preise"
 *     secondaryHref="/pakete"
 *   />
 */
interface Props {
  /** Main heading of the CTA block. */
  headline?: string;
  /** Supporting copy under the heading. */
  sub?: string;
  /** Primary button label. */
  primaryLabel?: string;
  /** Primary button href. */
  primaryHref?: string;
  /** Secondary (outline) button label. Hidden if empty. */
  secondaryLabel?: string;
  /** Secondary button href. */
  secondaryHref?: string;
}
const {
  headline = 'Bereit für Ihre neue Website?',
  sub = 'Kostenloses Erstgespräch – 30 Minuten, unverbindlich, kein Verkaufsdruck.',
  primaryLabel = 'Beratung anfragen',
  primaryHref = '/kontakt',
  secondaryLabel = 'Pakete & Preise ansehen',
  secondaryHref = '/pakete',
} = Astro.props;
---
<section class="cta-section">
  <div class="container">
    <div class="cta-inner">
      <div class="cta-bolt" aria-hidden="true">
        <svg width="40" height="40" viewBox="0 0 512 512">
          <polygon points="296,80 176,288 248,288 216,432 336,224 264,224" fill="white" opacity="0.3"/>
        </svg>
      </div>
      <h2>{headline}</h2>
      <p>{sub}</p>
      <div class="cta-buttons">
        <a href={primaryHref} class="btn-accent" data-cta={`cta-block:${primaryLabel}`}>{primaryLabel}</a>
        {secondaryLabel && <a href={secondaryHref} class="btn-outline" data-cta={`cta-block:${secondaryLabel}`}>{secondaryLabel}</a>}
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding: 6rem 0 5rem;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-hero-gradient-end, color-mix(in srgb, var(--color-primary), #000 35%)) 100%);
    color: white;
  }
  .cta-inner { text-align: center; max-width: 42rem; margin-inline: auto; position: relative; padding-top: 3rem; }
  .cta-bolt { position: absolute; top: -1rem; left: 50%; transform: translateX(-50%); opacity: 0.4; }
  .cta-inner h2 { font-size: clamp(1.75rem, 3vw, 2.5rem); color: white; margin-bottom: 1rem; }
  /* Volle Deckkraft statt 0.8: auf dem hellen Ende des Verlaufs kam der Subtext
     damit nur auf 3.52:1 und riss AA (gemessen an Zink, --color-primary #d90570).
     Ohne Transparenz sind es 4.99:1. Grenze siehe CHANGELOG v0.101.0 — auf sehr
     hellen Primaerfarben reicht auch reines Weiss nicht, das haengt am Token. */
  .cta-inner p { font-size: 1.0625rem; color: #ffffff; line-height: 1.7; margin-bottom: 2rem; }
  .cta-buttons { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
  /* Konvention „Vorwärts gehört nach rechts" (docs/ux-conventions.md): Primär
     rechts im Paar. Die Gruppe bleibt zentriert — die Sektion ist zentriert
     aufgebaut. Ab Tablet, darunter stapeln die Buttons mit Primär oben. */
  @media (min-width: 641px) {
    .cta-buttons .btn-outline { order: -1; }
  }
</style>
