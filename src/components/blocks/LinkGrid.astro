---
/**
 * LinkGrid — grid of internal link cards (cross-links / "weiterführend").
 *
 * Generic, prop-driven. Covers the recurring "related" pattern: a grid of
 * cards that link to other pages (target audiences, locations, sub-services).
 * Each card: title (required), optional description, optional leading icon.
 *
 * @example
 *   <LinkGrid
 *     heading="Spezialisiert auf Ihre Anforderung"
 *     intro="Wir betreuen Mandate weit über Regensburg hinaus."
 *     items={[
 *       { title: 'Für Anwälte', description: 'Gerichtsfeste Gutachten…', href: '/fuer-anwaelte' },
 *     ]}
 *     background="surface"
 *   />
 */
export interface LinkCard {
  /** Card title. Required. */
  title: string;
  /** Optional supporting copy. */
  description?: string;
  /** Link target. Required. */
  href: string;
  /** Optional leading icon (emoji or short string). */
  icon?: string;
}

interface Props {
  /** Optional section heading. */
  heading?: string;
  /** Optional intro under the heading. */
  intro?: string;
  /** Cards. Section is omitted entirely if empty. */
  items?: readonly LinkCard[];
  /** Background variant. Default 'default'. */
  background?: 'surface' | 'default';
}

const { heading, intro, items = [], background = 'default' } = Astro.props;
---
{items.length > 0 && (
<section class:list={['link-grid-section', background === 'surface' && 'is-surface']}>
  <div class="container">
    {heading && <h2 class="link-grid-heading">{heading}</h2>}
    {intro && <p class="link-grid-intro">{intro}</p>}

    <div class="link-grid">
      {items.map((c) => (
        <a href={c.href} class="link-card">
          {c.icon && <span class="link-card-icon" aria-hidden="true">{c.icon}</span>}
          <strong>{c.title}</strong>
          {c.description && <span class="link-card-desc">{c.description}</span>}
        </a>
      ))}
    </div>
  </div>
</section>
)}

<style>
  .link-grid-section { padding: var(--section-padding, 4rem) 0; background: #fff; }
  .link-grid-section.is-surface { background: var(--color-surface, #f8fafc); }
  .container { max-width: var(--container-max, 72rem); margin: 0 auto; padding: 0 1.5rem; }
  .link-grid-heading {
    text-align: center;
    font-family: var(--font-heading, inherit);
    color: var(--color-primary);
    font-size: 2rem;
    margin: 0 0 0.75rem;
  }
  .link-grid-intro {
    text-align: center;
    color: var(--color-muted, #4b5563);
    max-width: 36rem;
    margin: 0 auto 2.5rem;
    font-size: 1.0625rem;
  }
  .link-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1.25rem;
  }
  .link-card {
    display: block;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    padding: 1.25rem 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s, border-color 0.2s;
  }
  .is-surface .link-card { background: #fff; }
  .link-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }
  .link-card-icon { font-size: 1.5rem; display: block; margin-bottom: 0.5rem; }
  .link-card strong {
    display: block;
    color: var(--color-primary);
    font-size: 1.0625rem;
    margin-bottom: 0.375rem;
  }
  .link-card-desc { color: var(--color-muted, #4b5563); font-size: 0.9375rem; line-height: 1.5; }
</style>
