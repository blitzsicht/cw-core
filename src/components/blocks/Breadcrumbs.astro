---
/**
 * @cw/core – Breadcrumbs.astro
 *
 * Renders a visible breadcrumb <nav> AND a matching JSON-LD BreadcrumbList
 * for Google rich results. Use on detail pages, service pages, blog posts.
 *
 * Current item should have no `href` (renders as plain text + aria-current).
 *
 * @example
 *   <Breadcrumbs
 *     items={[
 *       { label: 'Start', href: '/' },
 *       { label: 'Leistungen', href: '/leistungen' },
 *       { label: 'Komplettsanierung' },
 *     ]}
 *     siteUrl="https://steller-sanierungen.com"
 *   />
 */
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  /** Breadcrumb trail. Last item should have no href (current page). */
  items: BreadcrumbItem[];
  /** Canonical site URL (no trailing slash). Used to resolve href→absolute for JSON-LD. */
  siteUrl: string;
  /**
   * Layout-Variante. `'plain'` (Default) = nacktes `<nav>`, der Consumer kümmert sich um
   * Container/Position (backward-compat). `'bar'` = self-contained Surface-Leiste mit eigenem
   * Container — direkt UNTER den Hero platzieren, kein page-lokaler Wrapper (`bc-wrap`) nötig.
   */
  variant?: 'plain' | 'bar';
  /** Max-Breite des Bar-Containers (nur `variant="bar"`). Default `var(--container-max)`. */
  maxWidth?: string;
}

const { items, siteUrl, variant = 'plain', maxWidth } = Astro.props;
const innerStyle = variant === 'bar' && maxWidth ? `max-width:${maxWidth}` : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, siteUrl).toString() } : {}),
  })),
};
---
<div class:list={['breadcrumb-shell', variant === 'bar' && 'breadcrumb-bar']}>
  <div class:list={['breadcrumb-inner', variant === 'bar' && 'breadcrumb-bar-inner']} style={innerStyle}>
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        {items.map((item, i) => (
          <li>
            {item.href ? (
              <a href={item.href}>{item.label}</a>
            ) : (
              <span aria-current="page">{item.label}</span>
            )}
            {i < items.length - 1 && <span class="sep" aria-hidden="true">›</span>}
          </li>
        ))}
      </ol>
    </nav>
  </div>
</div>
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  /* Shell ist im Default transparent (display:contents) → variant="plain" rendert
     effektiv nur das <nav> wie bisher (backward-compat, kein Layout-Effekt). */
  .breadcrumb-shell { display: contents; }
  .breadcrumb-inner { display: contents; }
  /* variant="bar": dezente Surface-Leiste mit eigenem Container (Variant A). */
  .breadcrumb-bar {
    display: block;
    background: var(--color-surface, #f5f6f8);
    border-bottom: 1px solid var(--color-border, #e7e8ee);
  }
  .breadcrumb-bar-inner {
    display: block;
    max-width: var(--container-max, 72rem);
    margin: 0 auto;
    padding: 0.7rem 1.5rem;
  }
  .breadcrumb-bar .breadcrumbs { padding: 0; }

  .breadcrumbs {
    font-size: 0.875rem;
    color: var(--color-muted, #6b7280);
    padding: 1rem 0;
  }
  .breadcrumbs ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    align-items: center;
  }
  .breadcrumbs li {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }
  .breadcrumbs a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s;
  }
  .breadcrumbs a:hover {
    color: var(--color-primary, #1f2937);
    text-decoration: underline;
  }
  .breadcrumbs [aria-current='page'] {
    color: var(--color-text, #1f2937);
    font-weight: 500;
  }
  .breadcrumbs .sep {
    color: var(--color-primary, #374151);
    opacity: 0.6;
  }
</style>
