---
/**
 * StatsGrid — key figures displayed as a horizontal grid.
 *
 * Used on "Über uns" or similar pages to showcase numbers like
 * "25+ Jahre Erfahrung", "200+ Projekte", etc.
 *
 * @example
 *   <StatsGrid items={[
 *     { value: '25+', label: 'Jahre Erfahrung' },
 *     { value: '200+', label: 'Projekte' },
 *     { value: '15', label: 'Partnerbetriebe' },
 *   ]} />
 */
export interface StatItem {
  /** Large displayed value (e.g. "25+", "200+", "15"). */
  value: string;
  /** Label below the value. */
  label: string;
}

interface Props {
  items?: readonly StatItem[];
}

const { items = [] } = Astro.props;
---
{items.length > 0 && (
<section class="stats-section">
  <div class="container">
    <div class="stats-grid">
      {items.map((s) => (
        <div class="stat-card">
          <div class="stat-value">{s.value}</div>
          <div class="stat-label">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
)}

<style>
  .stats-section {
    padding: 3rem 0;
    background: var(--color-surface);
  }
  .stats-grid {
    display: grid;
    /* 180px statt 140px, und min(…, 100%) als Schutz auf sehr schmalen
       Bildschirmen. Damit passen bei 390 px Viewport keine zwei Spalten mehr
       (2 x 180 + 24 Abstand = 384 > 342 verfuegbar), die Kennzahl bekommt die
       volle Breite.

       Anlass: mit 140px standen bei 390 px zwei Spalten a ~163 px, und
       .stat-value hat einen festen Untergrenzwert von 2,5 rem = 40 px. Der
       weiss nichts von der Spaltenbreite: "9.000+" wurde ~164 px breit und
       ragte um 1 px hinaus. Gemessen am 28.08.2026 auf dem CI-Runner bei
       customer-soleno, auf 25 Seiten — ein Pixel genuegt fuer echtes
       seitliches Scrollen (ab 0,5 px meldet der Browser scrollWidth+1, und
       scrollTo(9999,0) verschiebt die Seite tatsaechlich).

       Die Schriftgroesse blieb bewusst unangetastet: sie kleiner zu rechnen
       waere eine Breiten-Wette gewesen, die eine breitere Systemschrift auf
       einer anderen Plattform erneut verliert. Mehr Platz statt weniger
       Text. */
    grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr));
    gap: 1.5rem;
  }
  .stat-card {
    text-align: center;
    padding: 1.5rem;
  }
  .stat-value {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1;
  }
  .stat-label {
    margin-top: 0.5rem;
    color: var(--color-muted, #6b7280);
    font-size: 0.9375rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    /* Ein einzelnes langes Wort passt in eine 140-px-Spur nicht, und in
       Grossbuchstaben mit Sperrung erst recht nicht: gemessen am 28.08.2026
       an soleno war "Leistungsbereiche" 162 px breit und schob die Seite auf
       393 px bei 390 px Viewport. hyphens trennt sauber, wo die Sprache
       bekannt ist; overflow-wrap faengt den Rest, wo sie es nicht ist. */
    overflow-wrap: break-word;
    hyphens: auto;
  }
</style>
