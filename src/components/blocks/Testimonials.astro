---
import { PRUEFHINWEIS_GOOGLE, hatPruefhinweis } from '../../utils/pruefhinweis.js';
/**
 * @cw/core – Testimonials.astro
 *
 * Marquee-Karussell (kontinuierlich nach links scrollend) für Kundenstimmen,
 * optional mit Schema.org Review-Markup (`schema`, s. u.). Hover/Focus pausiert die
 * Animation, prefers-reduced-motion fällt auf eine statische Centered-Wrap
 * zurück.
 *
 * Dies hat in v0.9.1 die Tilt-Grid-Variante ersetzt — Karussell macht den
 * sozialen Beweis kinetisch, lässt mehr Stimmen sichtbar als ein 3-Karten-
 * Grid und passt zu jeder Anzahl an Items, ohne das Layout zu kippen.
 *
 * Bewertungs-Markup (Product + AggregateRating + Review-Microdata) gibt es seit
 * 26.09.2026 NUR noch auf ausdrücklichen Wunsch: `schema` ist per Default nur an,
 * wenn `productName` gesetzt ist. Vorher war es immer an, Name per Default
 * „${siteName} Website-Service“ — passend für eine Agentur, die Website-Service
 * verkauft, auf jeder Kundenseite aber falsches, selbst erteiltes Bewertungs-Markup
 * für ein Produkt, das es nicht gibt. Google zeigt für selbst erteilte
 * LocalBusiness-/Organization-Bewertungen keine Sterne und kann eine manuelle
 * Maßnahme verhängen. Der Guard `checkReviewClaims` (ai-discovery) meldet solches
 * Markup im gebauten HTML.
 *
 * `reviewSource="google"` kennzeichnet die Stimmen mit dem WORT „Google-Bewertung“
 * (kein Logo — die Wortnennung ist zulässig, das Google-„G“ in Markenfarben nicht)
 * und setzt den Prüfhinweis nach § 5b Abs. 3 UWG unter den Block, sofern die
 * `subheading` ihn nicht schon enthält.
 *
 * @example
 *   <Testimonials items={siteData.testimonials} siteName={siteData.name} />
 */

export interface Testimonial {
  /** Star rating (1-5). */
  stars: number;
  /** Review body / quote. */
  text: string;
  /** Reviewer name. */
  name: string;
  /** Reviewer role/company. */
  role: string;
}

interface Props {
  /** Testimonial entries. Section is omitted if empty. */
  items?: readonly Testimonial[];
  /** Site name used in itemprop="name" for the reviewed Product. */
  siteName?: string;
  /** Optional override for the section heading. */
  heading?: string;
  /** Optional override for the section subheading. */
  subheading?: string;
  /**
   * Name des bewerteten Produkts im Markup (Default `${siteName} Website-Service`).
   * Wer ihn setzt, bekommt das Markup automatisch (`schema` wird dann `true`).
   */
  productName?: string;
  /**
   * Schema.org-Markup (Product + AggregateRating + Review) ausgeben.
   * Default: `true` NUR, wenn `productName` gesetzt ist, sonst `false`.
   * Nur für ein echtes, eigenes Produkt bzw. eine Dienstleistung einschalten —
   * nie für den eigenen Betrieb (selbst erteiltes LocalBusiness-Rating).
   */
  schema?: boolean;
  /**
   * Kennzeichnet die Stimmen als Google-Rezensionen: pro Karte der Text
   * „Google-Bewertung“ (kein Logo), unter dem Block der Prüfhinweis nach
   * § 5b Abs. 3 UWG. Opt-in — ohne diesen Prop unverändert.
   */
  reviewSource?: 'google';
  /**
   * Overschreibt den aus den Sternen errechneten `aggregateRating`-Wert.
   * Nötig, wenn die kuratierten `items` nur ein Ausschnitt der echten
   * Bewertungen sind (z. B. 6 handverlesene 5★-Stimmen), das Schema aber die
   * tatsächliche GBP-Aggregatbewertung spiegeln soll. Ohne diesen Prop
   * unverändert (Ø der `items`). Immer zusammen mit `reviewCount` setzen.
   */
  ratingValue?: number;
  /**
   * Überschreibt den `reviewCount` im `aggregateRating`-Schema (Default:
   * `items.length`). Auf die echte GBP-Gesamtzahl setzen, damit das Markup
   * nicht die Anzahl der angezeigten Karten, sondern die reale Bewertungsbasis
   * ausweist. Immer zusammen mit `ratingValue` setzen.
   */
  reviewCount?: number;
}

const {
  items = [],
  siteName = '',
  heading = 'Das sagen unsere Kunden',
  subheading = 'Bewertungen von Unternehmen aus der Region.',
  productName,
  schema = productName !== undefined,
  reviewSource,
  ratingValue,
  reviewCount,
} = Astro.props;

const itempropName = productName ?? `${siteName} Website-Service`;
const loop = [...items, ...items];
const avgRating = items.length > 0
  ? (items.reduce((s, t) => s + t.stars, 0) / items.length).toFixed(1)
  : '5.0';
// Schema-Aggregat: explizite GBP-Zahlen haben Vorrang vor dem items-Durchschnitt.
const schemaRating = ratingValue !== undefined ? ratingValue.toFixed(1) : avgRating;
const schemaCount = reviewCount ?? items.length;

/**
 * Microdata-Attribute nur mit `schema`. Ohne `schema` entfällt jedes itemscope/
 * itemtype/itemprop — das sichtbare Markup bleibt Element für Element gleich.
 * `undefined` lässt Astro das Attribut weg, `true` rendert `itemscope` als
 * Boolean-Attribut. Bewusst einzelne Attribute statt Spread: Ein Spread auf ein
 * Element mit Scoped-Style lässt Astro den Scope als `class="astro-…"` statt als
 * `data-astro-cid-…` setzen — das Markup wiche dann auch MIT `schema` ab.
 */
const ip = (name: string) => (schema ? name : undefined);
const scope = schema ? true : undefined;
const typ = (name: string) => (schema ? `https://schema.org/${name}` : undefined);

// Prüfhinweis nicht doppeln, wenn der Kunde ihn schon in die Unterzeile geschrieben hat.
const zeigePruefhinweis = reviewSource === 'google' && !hatPruefhinweis(subheading);
---
{items.length > 0 && (
<section class="testimonials-marquee" itemscope={scope} itemtype={typ('Product')}>
  {schema && (
    <>
      <meta itemprop="name" content={itempropName} />
      <div itemprop="aggregateRating" itemscope itemtype="https://schema.org/AggregateRating">
        <meta itemprop="ratingValue" content={schemaRating} />
        <meta itemprop="reviewCount" content={String(schemaCount)} />
        <meta itemprop="bestRating" content="5" />
        <meta itemprop="worstRating" content="1" />
      </div>
    </>
  )}
  <div class="container">
    <div class="section-header">
      <h2 class="section-heading">{heading}</h2>
      <p class="section-subheading">{subheading}</p>
    </div>
  </div>

  <div class="track-wrap" role="region" aria-label="Kundenbewertungen (scrollend)">
    <div class="track">
      {loop.map((t, i) => (
        <div
          class="testimonial-card"
          itemprop={ip('review')}
          itemscope={scope}
          itemtype={typ('Review')}
          aria-hidden={i >= items.length ? 'true' : undefined}
        >
          <div class="stars" itemprop={ip('reviewRating')} itemscope={scope} itemtype={typ('Rating')}>
            {schema && <meta itemprop="ratingValue" content={String(t.stars)} />}
            {schema && <meta itemprop="bestRating" content="5" />}
            {'★'.repeat(t.stars)}
          </div>
          <blockquote itemprop={ip('reviewBody')}>{t.text}</blockquote>
          <div class="card-foot">
            <div class="author" itemprop={ip('author')} itemscope={scope} itemtype={typ('Person')}>
              <strong itemprop={ip('name')}>{t.name}</strong>
              <span>{t.role}</span>
            </div>
            {reviewSource === 'google' && (
              <span class="gbadge">
                <span class="gbadge-text">Google-Bewertung</span>
              </span>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
  {zeigePruefhinweis && (
    <div class="container">
      <p class="pruefhinweis">{PRUEFHINWEIS_GOOGLE}</p>
    </div>
  )}
</section>
)}

<style>
  .testimonials-marquee {
    padding: 5rem 0;
    background: var(--color-surface, #f8f9fb);
    overflow: hidden;
  }
  .container {
    max-width: var(--container-max, 72rem);
    margin-inline: auto;
    padding-inline: 1.5rem;
  }
  .section-header { text-align: center; margin-bottom: 3rem; }
  .section-heading {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0 0.75rem;
  }
  .section-subheading {
    font-size: 1.0625rem;
    color: var(--color-muted, #6b7280);
    margin: 0;
  }

  .track-wrap {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);
            mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);
  }
  .track {
    display: flex;
    gap: 1.5rem;
    width: max-content;
    padding: 1rem 2rem;
    animation: cw-testimonials-slide 45s linear infinite;
  }
  .track:hover,
  .track:focus-within { animation-play-state: paused; }

  .testimonial-card {
    flex: 0 0 auto;
    width: 320px;
    background: white;
    border-radius: 0.875rem;
    border: 1px solid #e5e7eb;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .stars {
    color: var(--color-accent);
    font-size: 1.125rem;
    letter-spacing: 2px;
  }
  blockquote {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--color-primary);
    font-style: italic;
    flex: 1;
  }
  .card-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .author strong {
    display: block;
    font-size: 0.9375rem;
    color: var(--color-primary);
  }
  .author span {
    font-size: 0.8125rem;
    color: var(--color-muted, #6b7280);
  }
  .gbadge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    flex: 0 0 auto;
  }
  .gbadge-text {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-muted, #6b7280);
  }

  .pruefhinweis {
    max-width: 40rem;
    margin: 1.5rem auto 0;
    text-align: center;
    font-size: 0.8125rem;
    color: var(--color-muted, #6b7280);
  }

  @keyframes cw-testimonials-slide {
    from { transform: translate3d(0, 0, 0); }
    /* -50% weil der Track die Items doppelt enthält — exakt eine
       Set-Länge weiter überlappt das zweite Set mit dem Start. */
    to   { transform: translate3d(-50%, 0, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
      padding-inline: 1.5rem;
    }
    .track-wrap {
      -webkit-mask-image: none;
              mask-image: none;
    }
    .testimonial-card[aria-hidden="true"] { display: none; }
  }
</style>
