---
/**
 * @cw/core – Testimonials.astro
 *
 * Marquee-Karussell (kontinuierlich nach links scrollend) für verifizierte
 * Kundenstimmen mit Schema.org Review-Markup. Hover/Focus pausiert die
 * Animation, prefers-reduced-motion fällt auf eine statische Centered-Wrap
 * zurück.
 *
 * Dies hat in v0.9.1 die Tilt-Grid-Variante ersetzt — Karussell macht den
 * sozialen Beweis kinetisch, lässt mehr Stimmen sichtbar als ein 3-Karten-
 * Grid und passt zu jeder Anzahl an Items, ohne das Layout zu kippen.
 *
 * Aggregate-Rating wird automatisch aus den Sternen errechnet und als
 * sichtbarer (nicht display:none) Schema-Knoten ausgespielt — Google
 * akzeptiert nur sichtbares Markup als Quelle für Rich Snippets.
 *
 * @example
 *   <Testimonials items={siteData.testimonials} siteName={siteData.name} />
 */

export interface Testimonial {
  /** Star rating (1-5). */
  stars: number;
  /** Review body / quote. */
  text: string;
  /** Reviewer name. */
  name: string;
  /** Reviewer role/company. */
  role: string;
}

interface Props {
  /** Testimonial entries. Section is omitted if empty. */
  items?: readonly Testimonial[];
  /** Site name used in itemprop="name" for the reviewed Product. */
  siteName?: string;
  /** Optional override for the section heading. */
  heading?: string;
  /** Optional override for the section subheading. */
  subheading?: string;
  /** Optional override for the Product itemprop name (defaults to `${siteName} Website-Service`). */
  productName?: string;
  /**
   * Kennzeichnet die Stimmen als Google-Rezensionen: rendert pro Karte ein
   * Google-„G"-Logo + Label. Opt-in — ohne diesen Prop unverändert.
   */
  reviewSource?: 'google';
  /**
   * Overschreibt den aus den Sternen errechneten `aggregateRating`-Wert.
   * Nötig, wenn die kuratierten `items` nur ein Ausschnitt der echten
   * Bewertungen sind (z. B. 6 handverlesene 5★-Stimmen), das Schema aber die
   * tatsächliche GBP-Aggregatbewertung spiegeln soll. Ohne diesen Prop
   * unverändert (Ø der `items`). Immer zusammen mit `reviewCount` setzen.
   */
  ratingValue?: number;
  /**
   * Überschreibt den `reviewCount` im `aggregateRating`-Schema (Default:
   * `items.length`). Auf die echte GBP-Gesamtzahl setzen, damit das Markup
   * nicht die Anzahl der angezeigten Karten, sondern die reale Bewertungsbasis
   * ausweist. Immer zusammen mit `ratingValue` setzen.
   */
  reviewCount?: number;
}

const {
  items = [],
  siteName = '',
  heading = 'Das sagen unsere Kunden',
  subheading = 'Bewertungen von Unternehmen aus der Region.',
  productName,
  reviewSource,
  ratingValue,
  reviewCount,
} = Astro.props;

const itempropName = productName ?? `${siteName} Website-Service`;
const loop = [...items, ...items];
const avgRating = items.length > 0
  ? (items.reduce((s, t) => s + t.stars, 0) / items.length).toFixed(1)
  : '5.0';
// Schema-Aggregat: explizite GBP-Zahlen haben Vorrang vor dem items-Durchschnitt.
const schemaRating = ratingValue !== undefined ? ratingValue.toFixed(1) : avgRating;
const schemaCount = reviewCount ?? items.length;
---
{items.length > 0 && (
<section class="testimonials-marquee" itemscope itemtype="https://schema.org/Product">
  <meta itemprop="name" content={itempropName} />
  <div itemprop="aggregateRating" itemscope itemtype="https://schema.org/AggregateRating">
    <meta itemprop="ratingValue" content={schemaRating} />
    <meta itemprop="reviewCount" content={String(schemaCount)} />
    <meta itemprop="bestRating" content="5" />
    <meta itemprop="worstRating" content="1" />
  </div>
  <div class="container">
    <div class="section-header">
      <h2 class="section-heading">{heading}</h2>
      <p class="section-subheading">{subheading}</p>
    </div>
  </div>

  <div class="track-wrap" role="region" aria-label="Kundenbewertungen (scrollend)">
    <div class="track">
      {loop.map((t, i) => (
        <div
          class="testimonial-card"
          itemprop="review"
          itemscope
          itemtype="https://schema.org/Review"
          aria-hidden={i >= items.length ? 'true' : undefined}
        >
          <div class="stars" itemprop="reviewRating" itemscope itemtype="https://schema.org/Rating">
            <meta itemprop="ratingValue" content={String(t.stars)} />
            <meta itemprop="bestRating" content="5" />
            {'★'.repeat(t.stars)}
          </div>
          <blockquote itemprop="reviewBody">{t.text}</blockquote>
          <div class="card-foot">
            <div class="author" itemprop="author" itemscope itemtype="https://schema.org/Person">
              <strong itemprop="name">{t.name}</strong>
              <span>{t.role}</span>
            </div>
            {reviewSource === 'google' && (
              <span class="gbadge" title="Bewertung auf Google" aria-label="Bewertung auf Google">
                <svg class="gbadge-logo" viewBox="0 0 48 48" width="20" height="20" role="img" aria-label="Google">
                  <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                  <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                  <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                  <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                </svg>
                <span class="gbadge-text">Google</span>
              </span>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
)}

<style>
  .testimonials-marquee {
    padding: 5rem 0;
    background: var(--color-surface, #f8f9fb);
    overflow: hidden;
  }
  .container {
    max-width: var(--container-max, 72rem);
    margin-inline: auto;
    padding-inline: 1.5rem;
  }
  .section-header { text-align: center; margin-bottom: 3rem; }
  .section-heading {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0 0.75rem;
  }
  .section-subheading {
    font-size: 1.0625rem;
    color: var(--color-muted, #6b7280);
    margin: 0;
  }

  .track-wrap {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);
            mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);
  }
  .track {
    display: flex;
    gap: 1.5rem;
    width: max-content;
    padding: 1rem 2rem;
    animation: cw-testimonials-slide 45s linear infinite;
  }
  .track:hover,
  .track:focus-within { animation-play-state: paused; }

  .testimonial-card {
    flex: 0 0 auto;
    width: 320px;
    background: white;
    border-radius: 0.875rem;
    border: 1px solid #e5e7eb;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .stars {
    color: var(--color-accent);
    font-size: 1.125rem;
    letter-spacing: 2px;
  }
  blockquote {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--color-primary);
    font-style: italic;
    flex: 1;
  }
  .card-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .author strong {
    display: block;
    font-size: 0.9375rem;
    color: var(--color-primary);
  }
  .author span {
    font-size: 0.8125rem;
    color: var(--color-muted, #6b7280);
  }
  .gbadge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    flex: 0 0 auto;
  }
  .gbadge-logo { display: block; }
  .gbadge-text {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-muted, #6b7280);
  }

  @keyframes cw-testimonials-slide {
    from { transform: translate3d(0, 0, 0); }
    /* -50% weil der Track die Items doppelt enthält — exakt eine
       Set-Länge weiter überlappt das zweite Set mit dem Start. */
    to   { transform: translate3d(-50%, 0, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
      padding-inline: 1.5rem;
    }
    .track-wrap {
      -webkit-mask-image: none;
              mask-image: none;
    }
    .testimonial-card[aria-hidden="true"] { display: none; }
  }
</style>
