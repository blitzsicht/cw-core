---
/**
 * @cw/core – StickyMobileCTA.astro
 *
 * Fixed CTA bar at the bottom of the viewport — visible on mobile, hidden on desktop.
 * Mobile-First: displayed by default, hidden at ≥768px.
 *
 * Add padding-bottom to the page footer to prevent overlap:
 *   footer { padding-bottom: calc(56px + env(safe-area-inset-bottom)); }
 *
 * @example Single CTA (backwards-compatible)
 *   <StickyMobileCTA href="/website-audit" label="Kostenloser Website-Audit" />
 *
 * @example Split CTA (new in 0.10.5)
 *   <StickyMobileCTA
 *     href="/kontakt"
 *     label="Jetzt anfragen"
 *     secondaryHref="https://wa.me/49151xxxxxxxx"
 *     secondaryLabel="WhatsApp"
 *     secondaryVariant="whatsapp"
 *   />
 *
 * @example Split CTA with primary-colored primary button (new in 0.10.6)
 *   <StickyMobileCTA
 *     href="/kontakt"
 *     label="Jetzt anfragen"
 *     primaryVariant="primary"
 *     secondaryHref="https://wa.me/49151xxxxxxxx"
 *     secondaryLabel="WhatsApp"
 *     secondaryVariant="whatsapp"
 *   />
 */
interface Props {
  href: string;
  label: string;
  /** Optional: target attribute. Defaults to "_self". */
  target?: string;
  /**
   * Visual variant for the primary button. Defaults to "accent".
   * - "accent": uses --color-accent / --color-accent-hover (default, backwards-compat)
   * - "primary": uses --color-primary / --color-primary-dark
   */
  primaryVariant?: 'accent' | 'primary';
  /** Secondary button href. When set together with secondaryLabel, renders split layout. */
  secondaryHref?: string;
  /** Secondary button label. Required when secondaryHref is set. */
  secondaryLabel?: string;
  /** Optional: target attribute for secondary button. Defaults to "_self". */
  secondaryTarget?: string;
  /** Visual variant for secondary button. Defaults to "accent". */
  secondaryVariant?: 'whatsapp' | 'accent';
}

const {
  href,
  label,
  target = '_self',
  primaryVariant = 'accent',
  secondaryHref,
  secondaryLabel,
  secondaryTarget = '_self',
  secondaryVariant = 'accent',
} = Astro.props;

const isSplit = secondaryHref && secondaryLabel;
---

{isSplit ? (
  <div class="sticky-mobile-cta sticky-mobile-cta--split">
    <a class={`sticky-mobile-cta__btn sticky-mobile-cta__btn--primary sticky-mobile-cta__btn--primary-${primaryVariant}`} href={href} target={target}>
      <slot name="primary-icon" />{label} →
    </a>
    <a
      class={`sticky-mobile-cta__btn sticky-mobile-cta__btn--secondary sticky-mobile-cta__btn--${secondaryVariant}`}
      href={secondaryHref}
      target={secondaryTarget}
    >
      <slot name="secondary-icon" />{secondaryLabel} →
    </a>
  </div>
) : (
  <a class="sticky-mobile-cta" href={href} target={target}>{label} →</a>
)}

<style>
  /* ─── Single CTA (unchanged, backwards-compat) ─── */
  .sticky-mobile-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1rem 1.5rem;
    padding-bottom: calc(1rem + env(safe-area-inset-bottom));
    background: var(--color-accent, #ef7612);
    color: var(--color-accent-btn-text, white);
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    z-index: 50;
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.18);
    transition: background 0.15s;
    min-height: 56px;
  }

  .sticky-mobile-cta:hover {
    background: var(--color-accent-hover, #d46610);
  }

  .sticky-mobile-cta:focus-visible {
    outline: 3px solid white;
    outline-offset: -3px;
  }

  /* Desktop: hidden */
  @media (min-width: 768px) {
    .sticky-mobile-cta { display: none; }
  }

  /* ─── Split CTA (new) ─── */
  .sticky-mobile-cta--split {
    display: flex;
    align-items: stretch;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.18);
    min-height: 56px;
  }

  .sticky-mobile-cta__btn {
    flex: 1 1 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    padding: 1rem 0.75rem;
    padding-bottom: calc(1rem + env(safe-area-inset-bottom));
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    color: var(--color-accent-btn-text, white);
    transition: background 0.15s;
  }

  .sticky-mobile-cta__btn:focus-visible {
    outline: 3px solid white;
    outline-offset: -3px;
  }

  .sticky-mobile-cta__btn--primary {
    border-right: 1px solid rgba(255, 255, 255, 0.25);
  }

  /* primaryVariant="accent" (default — backwards-compat) */
  .sticky-mobile-cta__btn--primary-accent {
    background: var(--color-accent, #ef7612);
  }

  .sticky-mobile-cta__btn--primary-accent:hover {
    background: var(--color-accent-hover, #d46610);
  }

  /* primaryVariant="primary" */
  .sticky-mobile-cta__btn--primary-primary {
    background: var(--color-primary, #1d1e3b);
  }

  .sticky-mobile-cta__btn--primary-primary:hover {
    background: var(--color-primary-dark, #13142a);
  }

  /* accent variant (default for secondary) */
  .sticky-mobile-cta__btn--accent {
    background: var(--color-accent, #ef7612);
  }

  .sticky-mobile-cta__btn--accent:hover {
    background: var(--color-accent-hover, #d46610);
  }

  /* whatsapp variant — WCAG 2.1 AA konform: #197F40 = 5.06:1 auf weiß */
  .sticky-mobile-cta__btn--whatsapp {
    background: #197f40;
  }

  .sticky-mobile-cta__btn--whatsapp:hover {
    background: #136a35;
  }

  /* Desktop: hidden */
  @media (min-width: 768px) {
    .sticky-mobile-cta--split { display: none; }
  }
</style>
