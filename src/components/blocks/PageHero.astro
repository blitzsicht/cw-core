---
/**
 * PageHero — gradient banner for sub-pages (not the main Hero).
 *
 * Renders a dark gradient section with heading + optional subtext.
 * Uses `--color-primary` as gradient start and auto-darkens via `color-mix`.
 * Override `--color-primary-dark` in tokens.css for fine control.
 *
 * Optional `backgroundImage` prop: renders a background image with dark overlay.
 *
 * Optional CTA buttons via `primaryLabel`/`primaryHref` (+ optional
 * `secondaryLabel`/`secondaryHref`) — naming matches CTABlock for consistency.
 * Styled for the dark hero: primary = accent fill, secondary = outline-on-dark.
 *
 * Used on: /pakete, /kontakt, /faq, /leistungen, /ueber-uns, /referenzen, etc.
 */
interface Props {
  heading: string;
  subtext?: string;
  /** Path to background image (e.g. '/images/hero/wertermittlung.webp'). */
  backgroundImage?: string;
  /** CSS background-position for the image. Default: 'center'. */
  backgroundPosition?: string;
  /** Overlay darkness. Default: 'medium'. */
  overlayStrength?: 'light' | 'medium' | 'strong';
  /** Primary CTA label. CTA-Block wird nur gerendert wenn label + href gesetzt sind. */
  primaryLabel?: string;
  /** Primary CTA href. */
  primaryHref?: string;
  /** Secondary CTA label (Outline-Stil auf dunklem Hero). Nur gerendert mit href. */
  secondaryLabel?: string;
  /** Secondary CTA href. */
  secondaryHref?: string;
}

const {
  heading,
  subtext,
  backgroundImage,
  backgroundPosition = 'center',
  overlayStrength = 'medium',
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
} = Astro.props;

const overlayMap = {
  light: 'rgba(29,30,59,0.45)',
  medium: 'rgba(29,30,59,0.7)',
  strong: 'rgba(29,30,59,0.85)',
};
const overlay = overlayMap[overlayStrength];

const bgStyle = backgroundImage
  ? `background: linear-gradient(${overlay}, ${overlay}), url('${backgroundImage}') ${backgroundPosition}/cover no-repeat;`
  : undefined;
---
<section class="page-hero" style={bgStyle}>
  <div class="container">
    <h1>{heading}</h1>
    {subtext && <p>{subtext}</p>}
    {primaryLabel && primaryHref && (
      <div class="page-hero-ctas">
        <a href={primaryHref} class="ph-btn ph-btn-primary">{primaryLabel}</a>
        {secondaryLabel && secondaryHref && (
          <a href={secondaryHref} class="ph-btn ph-btn-secondary">{secondaryLabel}</a>
        )}
      </div>
    )}
  </div>
</section>

<style>
  .page-hero {
    background: linear-gradient(
      135deg,
      var(--color-primary) 0%,
      var(--color-hero-gradient-end, color-mix(in srgb, var(--color-primary), #000 35%)) 100%
    );
    color: white;
    padding: 6rem 1.5rem 5rem;
    text-align: center;
  }
  .page-hero h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    color: white;
    margin-bottom: 0.75rem;
  }
  .page-hero p {
    color: rgba(255, 255, 255, 0.8);
    font-size: 1.0625rem;
    max-width: 44rem;
    margin-inline: auto;
  }
  .page-hero-ctas {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 2rem;
  }
  .ph-btn {
    display: inline-block;
    padding: 0.875rem 1.75rem;
    border-radius: 0.5rem;
    text-decoration: none;
    font-weight: 600;
    transition: opacity 0.15s, background 0.15s;
  }
  .ph-btn-primary {
    background: var(--color-accent);
    color: var(--color-primary-dark, var(--color-primary));
  }
  .ph-btn-primary:hover { opacity: 0.9; }
  .ph-btn-secondary {
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.4);
  }
  .ph-btn-secondary:hover { background: rgba(255, 255, 255, 0.2); }
</style>
