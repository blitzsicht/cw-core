---
/**
 * @cw/core – BaseLayout.astro
 *
 * Base HTML document with `<head>` (title, meta, OG, Twitter, Plausible,
 * Schema.org) and `<body><slot/></body>`. Prop-driven: no
 * `@/data/site-data` import. Customer is still expected to provide
 * `src/styles/tokens.css` (loaded via the `@/styles/tokens.css` alias).
 *
 * The customer site should wrap this layout (or use LandingPage /
 * ContentPage) and pass site-wide data (`siteName`, `siteUrl`,
 * `defaultTitle`, `seo`, etc.) explicitly.
 *
 * @example
 *   <BaseLayout
 *     title="Kontakt"
 *     siteName={siteData.name}
 *     siteUrl={siteData.url}
 *     defaultTitle={siteData.seo.defaultTitle}
 *     defaultDescription={siteData.seo.defaultDescription}
 *     titleTemplate={siteData.seo.titleTemplate}
 *     defaultOgImage={siteData.seo.ogImage}
 *     plausibleScript={siteData.analytics?.plausibleScript}
 *     schema={{
 *       name: siteData.name,
 *       description: siteData.description,
 *       url: siteData.url,
 *       ogImage: siteData.seo.ogImage,
 *       street: siteData.legal.street,
 *       zip: siteData.legal.zip,
 *       city: siteData.legal.city,
 *       country: siteData.legal.country,
 *       email: siteData.contact.email,
 *       phone: siteData.contact.phone,
 *     }}
 *   >
 *     <slot />
 *   </BaseLayout>
 */
import SchemaOrg from '../components/seo/SchemaOrg.astro';
import '@/styles/tokens.css';

export interface SchemaProps {
  name: string;
  description: string;
  url: string;
  ogImage: string;
  logoUrl?: string;
  /** Rechtlich verantwortliche Entität für `copyrightNotice` (company-first). Default `name`. */
  copyrightHolder?: string | null;
  street?: string;
  zip?: string;
  city?: string;
  country?: string;
  email?: string;
  phone?: string;
  areaServed?: string | string[] | readonly string[];
  priceRange?: string;
  sameAs?: string[] | readonly string[];
  availableLanguage?: string[] | readonly string[];
  openingHours?: string[] | readonly string[];
  geo?: { latitude: number; longitude: number };
  foundingDate?: string;
  slogan?: string;
  numberOfEmployees?: number | string;
  additionalTypes?: string[] | readonly string[];
  employees?: Array<{ name: string; role?: string; title?: string; phone?: string; email?: string; credentials?: string[] | readonly string[] }> | ReadonlyArray<{ name: string; role?: string; title?: string; phone?: string; email?: string; credentials?: string[] | readonly string[] }>;
  services?: Array<{ label: string; shortDesc?: string; href: string }> | ReadonlyArray<{ label: string; shortDesc?: string; href: string }>;
  service?: { label: string; shortDesc?: string; href: string };
  faqs?: Array<{ question: string; answer: string }> | ReadonlyArray<{ question: string; answer: string }>;
  knowsAbout?: string[] | readonly string[];
  founder?: {
    name: string;
    jobTitle?: string;
    description?: string;
    image?: string;
    email?: string;
    phone?: string;
    knowsAbout?: string[] | readonly string[];
    credentials?: string[] | readonly string[];
    sameAs?: string[] | readonly string[];
  };
}

interface Props {
  /** Page-specific title fragment. Combined with `titleTemplate`. */
  title?: string;
  /** Page-specific description (overrides `defaultDescription`). */
  description?: string;
  /**
   * OG image fallback chain — resolved in order:
   *   1. ogImage (page-level, explicit)
   *   2. headerImage (page header/hero image — e.g. siteData.hero.image)
   *   3. contentImage (first image in page content)
   *   4. generatedOgImage (build-time generated per page — with logo+CTA overlay)
   *   5. defaultOgImage prop (customer standard OG — always present)
   *
   * All paths are relative to siteUrl (absolute paths starting with /).
   * Pass null explicitly to skip a level and fall through to the next.
   */
  ogImage?: string | null | undefined;
  /** Level 2: hero/header image for this page (e.g. siteData.hero.image). */
  headerImage?: string | null | undefined;
  /** Level 3: first content image on this page. */
  contentImage?: string | null | undefined;
  /**
   * Level 4: path to a build-time generated OG image with logo+CTA overlay.
   * Ohne generiertes Bild greift `defaultOgImage` — kein geratener Pfad (seit v0.159.0).
   * Set to null to skip level 4 and fall through to defaultOgImage.
   */
  generatedOgImage?: string | null | undefined;
  /**
   * Alt-Text des Vorschaubilds (`og:image:alt` / `twitter:image:alt`).
   *
   * Ohne Wert wird die Seitenbeschreibung genommen — das Vorschaubild trägt in aller
   * Regel Titel und Beschreibung der Seite. Eine Alt-Zeile gehört auf jede Seite: das
   * Bild wird nie als `<img>` gerendert, und ohne sie hat es für Screenreader und
   * Vorschau-Clients keinerlei textliche Entsprechung.
   *
   * **Ohne KI-Offenlegung.** Die setzt `og-pages.js` nach dem Build, weil nur dort die
   * Bild-Deklaration (`siteData.bildHerkunft`) erreichbar ist — hierher käme sie nur
   * über eine Prop-Kette durch alle Layouts und jede Seite jedes Kundenrepos. Siehe
   * `utils/og-alt.js`.
   */
  ogImageAlt?: string;
  /** Optional canonical URL override. Defaults to `${siteUrl}${pathname}`. */
  canonicalUrl?: string;
  /** Optional robots meta value. */
  robots?: string;
  /** Site name (fallback for several defaults). */
  siteName?: string;
  /** Canonical site URL (no trailing slash). Required for absolute OG/canonical URLs. */
  siteUrl: string;
  /** Title used when `title` is not provided. */
  defaultTitle: string;
  /** Description used when `description` is not provided. */
  defaultDescription: string;
  /** Title template; `%s` is replaced with `title`. Defaults to `%s | ${siteName}`. */
  titleTemplate?: string;
  /** OG image used when `ogImage` not provided. */
  defaultOgImage: string;
  /** HTML lang attribute. Defaults to "de". */
  lang?: string;
  /** OG locale. Defaults to "de_DE". */
  ogLocale?: string;
  /**
   * Open Graph object type. Defaults to "website".
   * Set to "profile" for Author-/Person-Pages — Google + Social-Scraper
   * mappen das auf einer Person-Entity (statt einer generischen Website).
   * Andere gültige Werte: "article", "book", "video.movie" etc.
   */
  ogType?: 'website' | 'profile' | 'article' | (string & {});
  /**
   * Profile-spezifische OG-Meta. Nur ausgegeben wenn `ogType="profile"`.
   * Quelle: https://ogp.me/#type_profile
   */
  ogProfile?: {
    firstName?: string;
    lastName?: string;
    username?: string;
    gender?: 'male' | 'female';
  };
  /** Plausible script src. If set, the Plausible snippet is injected. */
  plausibleScript?: string;
  /** Plausible host for preconnect. Defaults to "https://plausible.io". Set to undefined when proxying same-origin. */
  plausibleHost?: string;
  /** Plausible API endpoint override. Set to "/api/event" when proxying via Vercel rewrites. */
  plausibleEndpoint?: string;
  /**
   * Steuert die eingebauten Auto-Tracking-Listener (Phone/Email/WhatsApp/PDF/
   * Outbound/Scroll/Time). Vorher feuerten sie UNBEDINGT — Repos, die zusätzlich
   * `<PlausibleEvents />` mounten, trackten Phone/Email/Scroll doppelt mit
   * inkompatiblen Props (Doppelfeuer-Bug, Ticket v0.54.0).
   * - 'inline' (Default): eingebaute Listener aktiv — heutiges Verhalten.
   * - 'full':   eingebaute Listener AUS — `<PlausibleEvents />` ist alleinige
   *             Event-Quelle (Repo muss die Komponente mounten!).
   * - 'none':   keine Auto-Events (Pageviews via Plausible-Script laufen weiter).
   */
  trackingMode?: 'inline' | 'full' | 'none';
  /** Schema.org props forwarded to `<SchemaOrg/>`. If omitted, `<SchemaOrg/>` is not rendered. */
  schema?: SchemaProps;
}

const {
  title,
  description,
  ogImage,
  ogImageAlt,
  headerImage,
  contentImage,
  generatedOgImage,
  canonicalUrl,
  robots,
  siteName = '',
  siteUrl,
  defaultTitle,
  defaultDescription,
  titleTemplate,
  defaultOgImage,
  lang = 'de',
  ogLocale = 'de_DE',
  ogType = 'website',
  ogProfile,
  plausibleScript,
  plausibleHost = 'https://plausible.io',
  plausibleEndpoint,
  trackingMode = 'inline',
  schema,
} = Astro.props;

const resolvedDescription = description ?? defaultDescription;

/**
 * OG image fallback chain (5 levels):
 * 1. Explicit page-level ogImage prop
 * 2. headerImage (page hero/header image)
 * 3. contentImage (first image in page content)
 * 4. generatedOgImage (build-time generated per page, if one exists)
 * 5. defaultOgImage prop (customer-configured standard OG — always present)
 *
 * Stufe 4 hat bis v0.158.0 einen Pfad GERATEN: fehlte ein generiertes Bild, setzte sie
 * `/og/default.png` ein — eine Datei, die nur deshalb meist existierte, weil die meisten
 * Repos sie zufällig führen. Vier von 24 führen sie nicht, und bei
 * haarwerk-neutraubling lieferte damit die 404-Seite ein og:image mit HTTP 404 aus
 * (gemessen 24.09.2026, der einzige tote Verweis in 1210 Asset-Referenzen der Flotte).
 * Der geratene Pfad stand dabei VOR Stufe 5 — dem kundenkonfigurierten Bild, das laut
 * dieser Liste „always present" ist. Der Rateschritt verhinderte also ausgerechnet den
 * garantierten. Gleiche Klasse wie `logoUrl ?? ${url}/logo.png` in v0.157.0: ein
 * geratener Pfad ist schlechter als ein fehlendes Feld, weil er wie ein Wert aussieht.
 */
const resolvedOgImage =
  ogImage ??
  headerImage ??
  contentImage ??
  (generatedOgImage !== null ? generatedOgImage : null) ??
  defaultOgImage;
// Ohne den geratenen Pfad aus Stufe 4 ist `defaultOgImage` der letzte Halt. Der Typ sagt
// `string`, aber ein Kunde kann `seo.ogImage` auf undefined setzen und TypeScript sieht das
// in einer .astro-Prop nicht zuverlässig. Dann stünde `content="…/undefined"` in jeder
// Seite — ein toter Verweis, der wie ein Wert aussieht, also genau der Fehler, den dieser
// Umbau abstellt. Lieber der Build hält an.
if (!resolvedOgImage) {
  throw new Error(
    '[cw/core BaseLayout] Kein og:image aufloesbar: weder ogImage/headerImage/contentImage/' +
      'generatedOgImage noch defaultOgImage gesetzt. Setze siteData.seo.ogImage auf eine ' +
      'Datei, die in public/ liegt — seit v0.159.0 wird kein Pfad mehr geraten.',
  );
}

const resolvedTitleTemplate = titleTemplate ?? (siteName ? `%s | ${siteName}` : '%s');
const pageTitle = title ? resolvedTitleTemplate.replace('%s', title) : defaultTitle;
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(resolvedOgImage, siteUrl).toString();

// Build-Guard (Review 2026-07-02): first-party plausibleScript OHNE plausibleEndpoint
// → das Tracker-Script postet an seinen absoluten Endpoint (cross-origin) statt first-party,
//   und es wird ein stale preconnect zu plausibleHost gerendert. Genau der blitzsicht-
//   danke/fix/report-Bug. Warnt pro betroffener Seite im Build-Log (dev-only, non-breaking).
if (plausibleScript?.startsWith('/') && !plausibleEndpoint) {
  console.warn(
    `[cw-core] ⚠️  ${Astro.url.pathname}: plausibleScript='${plausibleScript}' (first-party) ohne plausibleEndpoint ` +
      `→ Events gehen NICHT first-party + preconnect zeigt auf ${plausibleHost}. Fix: plausibleEndpoint='/api/event' setzen.`,
  );
}
---
<!doctype html>
<html lang={lang} data-cw-tracking={trackingMode}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content="Blitzsicht · https://blitzsicht.com" />
    <title>{pageTitle}</title>
    <meta name="description" content={resolvedDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    {robots && <meta name="robots" content={robots} />}

    <!-- OG Tags -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {/* og:image:alt fehlte flottenweit — das Vorschaubild hatte fuer Screenreader und
        Vorschau-Clients keine textliche Entsprechung. Traegt das Bild eine KI-Kennzeichnung,
        steckt die zudem als Vektorpfad in den Pixeln und ist dort nicht vorlesbar (Art. 50
        Abs. 5 AI Act). Die Offenlegung ergaenzt `og-pages.js` nach dem Build — siehe
        `utils/og-alt.js`; hier steht nur die Grundzeile. */}
    <meta property="og:image:alt" content={ogImageAlt ?? resolvedDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale} />
    {/* og:site_name fehlte flottenweit — bei JEDEM Kunden, gemessen 27.08.2026 an
        blitzsicht.com, baeckereizink.de, donau-profi.de und platzfrei.club. Der
        Open-Graph-Debugger meldet es als einzigen roten Punkt einer sonst
        vollständigen Auszeichnung. siteName lag längst als Prop vor; der Tag
        wurde nie ausgegeben. Facebook und LinkedIn zeigen ihn als Quelle über
        der Überschrift — ohne ihn steht dort die nackte Domain. */}
    {siteName && <meta property="og:site_name" content={siteName} />}
    {ogType === 'profile' && ogProfile && (
      <>
        {ogProfile.firstName && <meta property="profile:first_name" content={ogProfile.firstName} />}
        {ogProfile.lastName && <meta property="profile:last_name" content={ogProfile.lastName} />}
        {ogProfile.username && <meta property="profile:username" content={ogProfile.username} />}
        {ogProfile.gender && <meta property="profile:gender" content={ogProfile.gender} />}
      </>
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt ?? resolvedDescription} />

    {/* Plausible Analytics (cookie-frei, DSGVO-konform).
        Interne Doku (wird NICHT ins HTML ausgeliefert — JS-Kommentar):
        Queue-Shim immer vorhanden, damit window.plausible() nie wirft, wenn kein Script geladen ist.
        plausible.init() MUSS für Custom-Scripts (pa-XXX.js) explizit aufgerufen werden, sonst lädt
        das Script, initialisiert sich aber nicht (Install Verify schlägt fehl). */}
    <script is:inline>window.plausible=window.plausible||function(){(window.plausible.q=window.plausible.q||[]).push(arguments)};window.plausible.init=window.plausible.init||function(i){window.plausible.o=i||{}};</script>
    {plausibleScript && (
      <>
        {!plausibleEndpoint && <link rel="preconnect" href={plausibleHost} />}
        <script is:inline async src={plausibleScript}></script>
        <script is:inline define:vars={{ endpoint: plausibleEndpoint }}>
          // Tracker-EINGEBAUTE Auto-Events abschalten (v0.54.2, Tracking-Audit
          // 2026-07-09): der Tracker sendete zusätzlich "Outbound Link: Click",
          // "File Download" (Name-Kollision → Doppelzählung!) und
          // "Form: Submission" — parallel zu unseren kontrollierten Events aus
          // Inline-Block bzw. PlausibleEvents. Ab jetzt EIN kanonischer
          // Event-Satz: Outbound Click / File Download {filename} / Form Submit.
          // Pageviews bleiben unberührt.
          window.plausible.init({
            outboundLinks: false,
            fileDownloads: false,
            formSubmissions: false,
            ...(endpoint ? { endpoint } : {}),
          });
        </script>
      </>
    )}

    <!-- Schema.org JSON-LD -->
    {schema && (
      <SchemaOrg
        name={schema.name}
        description={schema.description}
        url={schema.url}
        ogImage={schema.ogImage}
        logoUrl={schema.logoUrl}
        copyrightHolder={schema.copyrightHolder}
        street={schema.street}
        zip={schema.zip}
        city={schema.city}
        country={schema.country}
        email={schema.email}
        phone={schema.phone}
        areaServed={schema.areaServed}
        priceRange={schema.priceRange}
        sameAs={schema.sameAs}
        availableLanguage={schema.availableLanguage}
        openingHours={schema.openingHours}
        geo={schema.geo}
        foundingDate={schema.foundingDate}
        slogan={schema.slogan}
        numberOfEmployees={schema.numberOfEmployees}
        additionalTypes={schema.additionalTypes}
        employees={schema.employees}
        services={schema.services}
        service={schema.service}
        knowsAbout={schema.knowsAbout}
        founder={schema.founder}
      />
    )}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Fallback for user agents that only fetch /favicon.ico (e.g. Plausible's
         icons.duckduckgo.com lookup) — generated at build time from favicon.svg,
         see @cw/core/integrations/favicon-ico (siluri/blitzsicht-ops#491). -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/favicon-192.png" />

    <!-- Page-spezifische Head-Erweiterungen (zusätzliche JSON-LD, OG-Image-Dimensions, profile-Meta etc.) -->
    <slot name="head" />
  </head>
  <body>
    <!--
      ================================================================
        ⚡  B L I T Z S I C H T
            Websites, die gefunden werden — in Suche, KI und Karte.
            https://blitzsicht.com
      ================================================================
    -->
    <slot />
  </body>
  <script>
    import { initAutoEvents } from '../utils/analytics/auto-events';
    // trackingMode-Gate (v0.54.0): bei 'full' ist <PlausibleEvents /> die Quelle
    // (die ruft dieselbe Implementierung mit Attribution auf), bei 'none' gibt es
    // keine Auto-Events. Runtime-Gate ueber das html-Attribut, weil gebundelte
    // Module-Scripts nicht zuverlaessig konditional gerendert werden koennen.
    //
    // Seit v0.155.0 steht der Event-Code nicht mehr hier, sondern in
    // utils/analytics/auto-events.ts — vorher existierte derselbe Satz zweimal
    // (hier und in PlausibleEvents.astro) und war ueber Monate auseinandergelaufen.
    const cwTrackingMode = document.documentElement.dataset.cwTracking ?? 'inline';
    if (cwTrackingMode === 'inline') {
      initAutoEvents();
    }
  </script>
</html>
