---
// @cw/core – Testimonials.astro
//
// Marquee-Karussell statt Grid: alle Stimmen laufen kontinuierlich nach links,
// pausieren beim Hover. Respektiert prefers-reduced-motion (statisch + horizontal
// scrollbar). Schema.org Review-Markup bleibt unverändert.
//
// Track wird einmal dupliziert für nahtlosen Loop. Geschwindigkeit skaliert
// linear mit der Anzahl der Items, damit Lange Listen nicht hetzen.

import { siteData } from '@/data/site-data';
const testimonials = siteData.testimonials ?? [];
const durationSeconds = Math.max(20, testimonials.length * 6);
---
{testimonials.length > 0 && (
<section class="testimonials-section" itemscope itemtype="https://schema.org/Product">
  <meta itemprop="name" content={`${siteData.name} Website-Service`} />
  <div class="container">
    <div class="section-header">
      <h2 class="section-heading">Das sagen unsere Kunden</h2>
      <p class="section-subheading">Bewertungen von Unternehmen aus der Region.</p>
    </div>
  </div>

  <div class="marquee" aria-roledescription="Karussell mit Kundenstimmen">
    <div class="marquee-track" style={`--marquee-duration: ${durationSeconds}s`}>
      {[...testimonials, ...testimonials].map((t, idx) => (
        <article
          class="testimonial-card"
          itemprop="review"
          itemscope
          itemtype="https://schema.org/Review"
          aria-hidden={idx >= testimonials.length ? 'true' : undefined}
        >
          <div class="stars" itemprop="reviewRating" itemscope itemtype="https://schema.org/Rating">
            <meta itemprop="ratingValue" content={String(t.stars)} />
            <meta itemprop="bestRating" content="5" />
            {'★'.repeat(t.stars)}
          </div>
          <blockquote itemprop="reviewBody">{t.text}</blockquote>
          <div class="author" itemprop="author" itemscope itemtype="https://schema.org/Person">
            <strong itemprop="name">{t.name}</strong>
            <span>{t.role}</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
)}

<style>
  .testimonials-section { padding: 5rem 0; background: var(--color-surface); overflow: hidden; }
  .section-header { text-align: center; margin-bottom: 3rem; }

  .marquee {
    position: relative;
    width: 100%;
    overflow: hidden;
    /* Sanfte Fade-Out-Maske an beiden Rändern, damit Karten nicht abrupt
       beschnitten wirken. */
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);
            mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);
  }
  .marquee-track {
    display: flex;
    gap: 1.5rem;
    width: max-content;
    animation: marquee-scroll var(--marquee-duration, 40s) linear infinite;
  }
  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    from { transform: translateX(0); }
    /* -50% weil der Track die Items doppelt enthält — bei -50% ist genau ein
       Set durch und das zweite überlappt 1:1 mit dem Start. */
    to { transform: translateX(-50%); }
  }

  .testimonial-card {
    flex: 0 0 320px;
    background: white;
    border-radius: 0.75rem;
    padding: 2rem;
    border: 1px solid #e5e7eb;
    display: flex;
    flex-direction: column;
  }
  .stars {
    color: var(--color-accent);
    font-size: 1.25rem;
    margin-bottom: 1rem;
    letter-spacing: 2px;
  }
  blockquote {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-primary);
    margin: 0 0 1.25rem;
    font-style: normal;
    flex: 1;
  }
  .author strong { display: block; font-size: 0.9375rem; }
  .author span { font-size: 0.8125rem; color: var(--color-muted); }

  /* Reduced-Motion: Animation aus, statt dessen normaler horizontaler
     Scroll-Container mit Snap-Points (vom User selbst steuerbar). */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-mask-image: none;
              mask-image: none;
    }
    .marquee-track {
      animation: none;
      width: max-content;
    }
    .testimonial-card { scroll-snap-align: center; }
  }

  @media (max-width: 768px) {
    .testimonial-card { flex: 0 0 280px; padding: 1.5rem; }
  }
</style>
