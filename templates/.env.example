# ─── Customer-Site Environment Variables (Template) ─────────────────────────
# Diese Datei ins Customer-Repo-Root kopieren, in Vercel die echten Werte setzen.
# Nicht committen mit echten Werten — .gitignore deckt .env (ohne .example) ab.
# ────────────────────────────────────────────────────────────────────────────

# ─── Cloudflare Turnstile (Bot-Schutz Kontaktformular) ──────────────────────
# Site-Key holen: https://dash.cloudflare.com → Turnstile → Add Widget
# Domain im CF-Widget eintragen, z.B. customer.de + www.customer.de
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...    # BUILD-TIME — fließt ins HTML, sichtbar
TURNSTILE_SECRET_KEY=0x4AAAAAA...          # SERVER-ONLY — validiert Token

# ─── Resend (Lead-Mail) ─────────────────────────────────────────────────────
# Account-weit ein API-Key reicht. blitzsicht.com ist verified Sender-Domain.
# Empfänger ist customer-spezifisch.
RESEND_API_KEY=re_...
CONTACT_EMAIL=info@CUSTOMER.de             # Empfänger-Adresse für Lead-Mails

# ─── Telegram (Lead-Push, optional) ─────────────────────────────────────────
# Bot via @BotFather. WICHTIG: /start an Bot schicken bevor er DMs senden kann!
# Sonst: "Forbidden: bot can't initiate conversation with a user"
TELEGRAM_BOT_TOKEN=123:AAH...              # Optional — wenn fehlt → kein TG-Push
TELEGRAM_CHAT_ID=123456789                  # User-DM-ID oder Group-ID
# PROJECT_NAME ist redundant — fällt automatisch zurück auf VERCEL_GIT_REPO_SLUG.

# ─── Plausible Analytics (optional) ─────────────────────────────────────────
# Wenn gesetzt, lädt das Script in BaseLayout. Nur die exakte URL.
# PUBLIC_PLAUSIBLE_SCRIPT=https://plausible.io/js/pa-XYZ.js

# ─── Cloudflare Turnstile Pre-Clearance (Audit-Site, optional) ──────────────
# Wenn gesetzt, rendert die TurnstilePreClearance-Komponente vorab den Widget,
# spart einen extra Klick im Audit-Submit-Flow.
# PUBLIC_TURNSTILE_PRE_SITE_KEY=0x4AAAAAA...

# ─── Vercel-Auto-Vars (NICHT manuell setzen) ────────────────────────────────
# VERCEL_GIT_REPO_SLUG     — automatisch (z.B. "customer-soleno")
# VERCEL_URL               — automatisch
# VERCEL                   — automatisch
