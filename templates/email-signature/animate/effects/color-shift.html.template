<!DOCTYPE html>
<html><head><meta charset="utf-8"><style>
  html, body { margin: 0; padding: 0; background: white; }
  #logo {
    position: relative;
    display: inline-block;
    width: {{WIDTH}}px;
    height: {{HEIGHT}}px;
  }
  #logo img {
    width: 100%;
    height: 100%;
    display: block;
  }
</style></head>
<body>
  <div id="logo">
    <img src="{{LOGO_DATA_URI}}" alt="logo">
  </div>
  <script src="{{MOTION_URL}}"></script>
  <script>
    const { animate } = Motion;
    // First Frame (t=0): drop-shadow 0 0 0 primary (= kein sichtbarer Glow) → ruhendes Logo.
    // Glow wächst auf 8px Accent in der Mitte, fadet zurück.
    animate('#logo img',
      {
        filter: [
          'drop-shadow(0 0 0px {{COLOR_PRIMARY}})',
          'drop-shadow(0 0 8px {{COLOR_ACCENT}})',
          'drop-shadow(0 0 0px {{COLOR_PRIMARY}})'
        ]
      },
      { duration: 2, repeat: Infinity, easing: 'ease-in-out' }
    );
  </script>
</body></html>
