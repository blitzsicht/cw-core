<!DOCTYPE html>
<html><head><meta charset="utf-8"><style>
  html, body { margin: 0; padding: 0; background: white; }
  #logo {
    position: relative;
    display: inline-block;
    width: {{WIDTH}}px;
    height: {{HEIGHT}}px;
  }
  #logo img {
    width: 100%;
    height: 100%;
    display: block;
    transform-origin: center center;
  }
</style></head>
<body>
  <div id="logo">
    <img src="{{LOGO_DATA_URI}}" alt="logo">
  </div>
  <script src="{{MOTION_URL}}"></script>
  <script>
    const { animate } = Motion;
    // First Frame (t=0): scale(1) → ruhendes Logo.
    // Spring-Bounce auf 1.04 und zurück. Bewusst minimaler 4% scale für "lebendig statt aufdringlich".
    animate('#logo img',
      { transform: ['scale(1)', 'scale(1.04)', 'scale(1)'] },
      { duration: 2, repeat: Infinity, easing: 'ease-in-out' }
    );
  </script>
</body></html>
