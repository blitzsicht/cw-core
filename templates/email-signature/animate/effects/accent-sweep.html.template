<!DOCTYPE html>
<html><head><meta charset="utf-8"><style>
  html, body { margin: 0; padding: 0; background: white; }
  #logo {
    position: relative;
    display: inline-block;
    width: {{WIDTH}}px;
    height: {{HEIGHT}}px;
    overflow: hidden;
  }
  #logo img {
    width: 100%;
    height: 100%;
    display: block;
  }
  /* Mask-Layer: bestimmt, dass der brush NUR an Logo-Pixeln sichtbar wird.
     Das Logo-Image dient hier als alpha-Maske (wo opaque → sichtbar). */
  #mask-layer {
    position: absolute;
    inset: 0;
    -webkit-mask-image: url("{{LOGO_DATA_URI}}");
    -webkit-mask-size: 100% 100%;
    -webkit-mask-position: center;
    -webkit-mask-repeat: no-repeat;
    mask-image: url("{{LOGO_DATA_URI}}");
    mask-size: 100% 100%;
    mask-position: center;
    mask-repeat: no-repeat;
    pointer-events: none;
  }
  #brush {
    position: absolute;
    top: 0;
    left: -50%;
    width: 50%;
    height: 100%;
    background: linear-gradient(
      to right,
      transparent 0%,
      transparent 15%,
      {{COLOR_ACCENT}} 50%,
      transparent 85%,
      transparent 100%
    );
    opacity: 0;
    pointer-events: none;
  }
</style></head>
<body>
  <div id="logo">
    <img src="{{LOGO_DATA_URI}}" alt="logo">
    <div id="mask-layer">
      <div id="brush"></div>
    </div>
  </div>
  <script src="{{MOTION_URL}}"></script>
  <script>
    const { animate } = Motion;
    // First Frame (t=0): brush bei left=-50%, opacity=0, also außerhalb + unsichtbar.
    // Logo voll sichtbar (Outlook-Fallback OK).
    // Animation: brush wandert von links nach rechts, sichtbar in der Mitte.
    // Durch die Mask wird er nur an Logo-Pixeln gerendert.
    animate('#brush',
      {
        left: ['-50%', '-50%', '100%', '100%'],
        opacity: [0, 1, 1, 0]
      },
      {
        duration: 2.5,
        repeat: Infinity,
        easing: 'ease-in-out',
        offset: [0, 0.2, 0.7, 0.85]
      }
    );
  </script>
</body></html>
