<!DOCTYPE html>
<html><head><meta charset="utf-8"><style>
  html, body { margin: 0; padding: 0; background: white; }
  #logo {
    position: relative;
    display: inline-block;
    width: {{WIDTH}}px;
    height: {{HEIGHT}}px;
    overflow: hidden;
  }
  #logo img {
    width: 100%;
    height: 100%;
    display: block;
  }
</style></head>
<body>
  <div id="logo">
    <img src="{{LOGO_DATA_URI}}" alt="logo">
  </div>
  <script src="{{MOTION_URL}}"></script>
  <script>
    const { animate } = Motion;
    // First Frame (t=0): opacity 1 → ruhendes Logo.
    // Dimmt zur Mitte auf 0.35, kehrt zurück. Smoothed via cubic-bezier.
    animate('#logo img',
      { opacity: [1, 1, 0.35, 1, 1] },
      { duration: 2, repeat: Infinity, easing: 'ease-in-out', offset: [0, 0.2, 0.5, 0.8, 1] }
    );
  </script>
</body></html>
