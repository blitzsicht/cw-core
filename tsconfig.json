{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "integrations/**/*.ts",
    "components/**/*.ts",
    "layouts/**/*.ts",
    "templates/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
