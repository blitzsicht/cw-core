---
// @cw/core – BaseLayout.astro
// Convention: customer MUST provide src/data/site-data.ts and src/styles/tokens.css
import { siteData } from '@/data/site-data';
import SchemaOrg from '@cw/core/components/seo/SchemaOrg.astro';
import '@/styles/tokens.css';

interface Props {
  title?: string;
  description?: string;
  /**
   * OG image fallback chain — resolved in order:
   *   1. ogImage (page-level, explicit)
   *   2. headerImage (page header/hero image)
   *   3. contentImage (first image in page content)
   *   4. generatedOgImage (build-time generated, typically /og/default.png — with logo+CTA overlay)
   *   5. siteData.images.ogImage (customer standard OG, always present)
   *
   * All paths are relative to siteData.url (absolute paths starting with /).
   * Pass null explicitly to skip a level and fall through to the next.
   */
  ogImage?: string | null | undefined;
  /** Level 2: hero/header image for this page (e.g. siteData.hero.image). */
  headerImage?: string | null | undefined;
  /** Level 3: first content image on this page. */
  contentImage?: string | null | undefined;
  /**
   * Level 4: path to a build-time generated OG image with logo+CTA overlay.
   * Defaults to /og/default.png (generated via `pnpm generate:og`).
   * Set to null to skip level 4 and fall through to siteData.images.ogImage.
   */
  generatedOgImage?: string | null | undefined;
  canonicalUrl?: string;
  robots?: string;
}

const {
  title,
  description = siteData.seo.defaultDescription,
  ogImage,
  headerImage,
  contentImage,
  generatedOgImage,
  canonicalUrl,
  robots,
} = Astro.props;

/**
 * OG image fallback chain (5 levels):
 * 1. Explicit page-level ogImage prop
 * 2. headerImage (page hero/header image)
 * 3. contentImage (first image in page content)
 * 4. generatedOgImage (build-time generated, /og/default.png by default)
 * 5. siteData.images.ogImage (customer-configured standard OG — always present)
 */
const resolvedOgImage =
  ogImage ??
  headerImage ??
  contentImage ??
  (generatedOgImage !== null ? (generatedOgImage ?? '/og/default.png') : null) ??
  siteData.images.ogImage;

const pageTitle = title
  ? siteData.seo.titleTemplate.replace('%s', title)
  : siteData.seo.defaultTitle;

const canonical = canonicalUrl ?? new URL(Astro.url.pathname, siteData.url).toString();
const ogImageUrl = new URL(resolvedOgImage, siteData.url).toString();
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content={robots} />}

    <!-- OG Tags -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Plausible Analytics (cookie-frei, DSGVO-konform) -->
    {siteData.analytics?.plausibleScript && (
      <>
        <link rel="preconnect" href="https://plausible.io" />
        <script is:inline async src={siteData.analytics.plausibleScript}></script>
        <script is:inline>
          // @ts-nocheck
          window.plausible=window.plausible||function(){(window.plausible.q=window.plausible.q||[]).push(arguments)};
          window.plausible.init=window.plausible.init||function(i){window.plausible.o=i||{}};
          window.plausible.init();
        </script>
      </>
    )}

    <!-- Schema.org JSON-LD -->
    <SchemaOrg />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/favicon-192.png" />

    <!-- Page-spezifische Head-Erweiterungen -->
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
