---
// @cw/core – LandingPage.astro
// Marketing/Landing pages: BaseLayout + Header + Footer
import BaseLayout from '@cw/core/layouts/BaseLayout.astro';
import Header from '@cw/core/components/layout/Header.astro';
import Footer from '@cw/core/components/layout/Footer.astro';
import { siteData } from '@/data/site-data';

interface Props {
  title?: string;
  description?: string;
  /**
   * Explicit OG image override (fallback chain level 1).
   * If omitted, BaseLayout auto-resolves via fallback chain:
   *   hero.image → contentImage → /og/default.png → siteData.images.ogImage
   */
  ogImage?: string | null | undefined;
  /** First image in page content (fallback chain level 3). */
  contentImage?: string | null | undefined;
  canonicalUrl?: string;
  robots?: string;
}

const { title, description, ogImage, contentImage, canonicalUrl, robots } = Astro.props;

// Fallback chain level 2: use the site hero image if available.
const headerImage = siteData.hero?.image ?? null;
---
<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  headerImage={headerImage}
  contentImage={contentImage}
  canonicalUrl={canonicalUrl}
  robots={robots}
>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
</BaseLayout>
